umber };\n  steps: Step[];\n}\n\ntype Step = QuoteStep | ClaimStep;\n\ninterface QuoteStep {\n  op: \"quote\";\n  items: Item[];\n}\n\ninterface ClaimStep {\n  op: \"claim\";\n  policy: number;\n  incident: { cause: string; damages: Damage[] };\n}\n\ninterface Item {\n  type: string;\n  material?: string;\n  enchantment?: number;\n  cursed?: boolean;\n}\n\ninterface Damage {\n  itemType: string;\n  amount: number;\n}\n\nconst ITEM_PRICES: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\nconst CURSED_SURCHARGE_RATE = 0.5;\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\n\nconst BLOCK_PRICE_COMPONENTS = new Set([\"rune\", \"moonstone\"]);\nconst BLOCK_PRICE = 60;\nconst EXACT_BLOCK_COUNT = 3;\nconst PROCESSING_FEE = 5;\n\nconst calculateBasePremium = (items: Item[]): number => {\n  const nonComponentItems: Item[] = [];\n  const componentCounts: Record<string, number> = {};\n\n  for (const item of items) {\n    if (BLOCK_PRICE_COMPONENTS.has(item.type)) {\n      componentCounts[item.type] = (componentCounts[item.type] || 0) + 1;\n    } else {\n      nonComponentItems.push(item);\n    }\n  }\n\n  let total = 0;\n\n  for (const item of nonComponentItems) {\n    const basePrice = ITEM_PRICES[item.type] || 0;\n    let itemTotal = basePrice;\n    if (item.cursed) {\n      itemTotal += basePrice * CURSED_SURCHARGE_RATE;\n    }\n    if (item.enchantment >= HIGH_ENCHANTMENT_THRESHOLD) {\n      itemTotal += basePrice * HIGH_ENCHANTMENT_SURCHARGE_RATE;\n    }\n    total += itemTotal;\n  }\n\n  for (const [type, count] of Object.entries(componentCounts)) {\n    if (count === EXACT_BLOCK_COUNT) {\n      total += BLOCK_PRICE;\n    } else {\n      total += count * (ITEM_PRICES[type] || 0);\n    }\n  }\n\n  return total;\n};\n\nexport const processScenario = (scenario: Scenario): unknown => {\n  const results: unknown[] = [];\n  for (const step of scenario.steps) {\n    if 