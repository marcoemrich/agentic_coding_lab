 type: string;\n  material?: string;\n  enchantment?: number;\n  cursed?: boolean;\n}\n\ninterface Damage {\n  itemType: string;\n  amount: number;\n}\n\nconst ITEM_PRICES: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\nconst CURSED_SURCHARGE_RATE = 0.5;\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\n\nconst BLOCK_PRICE_COMPONENTS = new Set([\"rune\", \"moonstone\"]);\nconst BLOCK_PRICE = 60;\nconst FIRST_INSURANCE_SURCHARGE_RATE = 0.1;\n\nconst LOYALTY_DISCOUNT_RATE = 0.2;\nconst LOYALTY_YEARS_THRESHOLD = 2;\n\nconst FOLLOW_UP_DISCOUNT_RATE = 0.15;\n\nconst EXACT_BLOCK_COUNT = 3;\nconst PROCESSING_FEE = 5;\nconst ITEM_INSURANCE_VALUES: Record<string, number> = {\n  sword: 1000,\n  amulet: 600,\n  staff: 800,\n  potion: 400,\n  rune: 250,\n  moonstone: 250,\n};\n\nconst CLAIM_DEDUCTIBLE = 100;\nconst HIGH_ENCHANTMENT_CLAIM_THRESHOLD = 8;\nconst HIGH_ENCHANTMENT_CLAIM_RATE = 0.5;\n\ninterface PolicyInfo {\n  items: Item[];\n  insuranceSum: number;\n  remainingCap: number;\n}\n\nconst calculateQuote = (items: Item[]): { baseSum: number; itemSurcharges: number } => {\n  const componentCounts: Record<string, number> = {};\n  let baseSum = 0;\n  let itemSurcharges = 0;\n\n  for (const item of items) {\n    if (BLOCK_PRICE_COMPONENTS.has(item.type)) {\n      componentCounts[item.type] = (componentCounts[item.type] || 0) + 1;\n    } else {\n      const basePrice = ITEM_PRICES[item.type] || 0;\n      baseSum += basePrice;\n      if (item.cursed) {\n        itemSurcharges += basePrice * CURSED_SURCHARGE_RATE;\n      }\n      if (item.enchantment >= HIGH_ENCHANTMENT_THRESHOLD) {\n        itemSurcharges += basePrice * HIGH_ENCHANTMENT_SURCHARGE_RATE;\n      }\n    }\n  }\n\n  for (const [type, count] of Object.entries(componentCounts)) {\n    const price = ITEM_PRICES[type] || 0;\n    if (count === EXACT_BLOCK_COUNT) {\n      baseSum += BLOCK_PRICE;\n    } else {\n      baseSum += count * price;\n    }\n  }\n\n  return { baseSum, itemSurcharges };\n};\n\nconst processQuoteStep = (\n  step: QuoteStep,\n  scenario: Scenario,\n  policies: PolicyInfo[],\n  quoteCount: number\n): { result: { premium: number }; newQuoteCount: number } => {\n  const { baseSum, itemSurcharges } = calculateQuote(step.items);\n  let quotePremium = baseSum + itemSurcharges;\n  quotePremium += baseSum * FIRST_INSURANCE_SURCHARGE_RATE;\n  if (scenario.customer.yearsWithMHPCO >= LOYALTY_YEARS_THRESHOLD) {\n    quotePremium -= baseSum * LOYALTY_DISCOUNT_RATE;\n  }\n  const newQuoteCount = quoteCount + 1;\n  if (newQuoteCount > 1) {\n    quotePremium -= baseSum * FOLLOW_UP_DISCOUNT_RATE;\n  }\n  const premium = Math.ceil(quotePremium + PROCESSING_FEE);\n\n  let insuranceSum = 0;\n  for (const item of step.items) {\n    insuranceSum += ITEM_INSURANCE_VALUES[item.type] || 0;\n  }\n  const cap = insuranceSum * 2;\n  policies.push({ items: step.items, insuranceSum, remainingCap: cap });\n  return { result: { premium }, newQuoteCount };\n};\n\nconst processClaimStep = (\n  step: ClaimStep,\n  policies: PolicyInfo[]\n): { payout: number; remainingCap: number } => {\n  const policy = policies[step.policy];\n  if (!policy) {\n    throw new Error(\"Policy not found\");\n  }\n\n  let payout = 0;\n  for (const damage of step.incident.damages) {\n    const insuredItem = policy.items.find((i: Item) => i.type === damage.itemType);\n    if (!insuredItem) {\n      throw new Error(\"Item not in policy\");\n    }\n\n    let reimbursable = damage.amount;\n    const enchantment = insuredItem.enchantment || 0;\n    const isDragonMaterial = insuredItem.material === \"dragon\";\n\n    if (enchantment >= HIGH_ENCHANTMENT_CLAIM_THRESHOLD) {\n      reimbursable = damage.amount * HIGH_ENCHANTMENT_CLAIM_RATE;\n    } else if (isDragonMaterial) {\n      // Dragon material: full reimbursement (reimbursable already equals damage.amount)\n    }\n\n    reimbursable -= CLAIM_DEDUCTIBLE;\n    if (reimbursable < 0) reimbursable = 0;\n    payout += reimbursable;\n  }\n\n  if (payout > policy.remainingCap) {\n    payout = policy.remainingCap;\n  }\n  policy.remainingCap -= payout;\n\n  return { payout, remainingCap: policy.remainingCap };\n};\n\nexport const processScenario = (scenario: Scenario): unknown => {\n  const results: unknown[] = [];\n  const policies: PolicyInfo[] = [];\n  let quoteCount = 0;\n  for (const step of scenario.steps) {\n    if (step.op === \"quote\") {\n      const { result, newQuoteCount } = processQuoteStep(step, scenario, policies, quoteCount);\n      quoteCount = newQuoteCount;\n      results.push(result);\n    } else if (step.op === \"claim\") {\n      results.push(processClaimStep(step, policies));\n    }\n  }\n  return { results };\n};"}],"isError":false,"timestamp":1784950186133},{"role":"assistant","content":[{"type":"text","text":"## Step 5: Calculate New APP Mass\n\n### `processScenario` (after refactoring):\n\n**Constants**: `'quote'` (1), `'claim'` (1), `0` (1), `{ results }` object literal (1)\nTotal: 4 × 1 = **4**\n\n**Bindings**: `scenario`, `results`, `policies`, `quoteCount`, `step`, `{result, newQuoteCount}`, `result` (the push arg)\nTotal: 7 × 1 = **7**\n\n**Invocations**: `processQuoteStep(...)`, `.push()` (×2), `processClaimStep(...)`\nTotal: 4 × 2 = **8**\n\n**Conditionals**: `if (step.op === 'quote')`, `else if (step.op === 'claim')`\nTotal: 2 × 4 = **8**\n\n**Loops**: `for (const step of scenario.steps)`\nTotal: 1 × 5 = **5**\n\n**Assignments**: `quoteCount = newQuoteCount`\nTotal: 1 × 6 = **6**\n\n**Subtotal `processScenario`**: 4 + 7 + 8 + 8 + 5 + 6 = **38**\n\n### `processQuoteStep`:\n\n| Component | Count | Mass |\n|-----------|-------|------|\n| Constants | 7 (0, 1, 0.1, 2, PROCESSING_FEE, insuranceSum=0, cap*2, Math.ceil) | 7 |\n| Bindings | step, scenario, policies, quoteCount, {baseSum, itemSurcharges}, quotePremium, newQuoteCount, premium, insuranceSum, item, cap | 11 |\n| Invocations | calculateQuote, Math.ceil, policies.push, ITEM_INSURANCE_VALUES[] | 4 |\n| Conditionals | yearsWithMHPCO >=, newQuoteCount > 1 | 2 |\n| Loops | for (const item of step.items) | 1 |\n| Assignments | quotePremium +=, quotePremium -=, insuranceSum += | 3 |\n\nMass: 8 + 11 + 8 + 8 + 5 + 18 = **58**\n\n### `processClaimStep`:\n\n| Category | Count | Mass |\n|-----------|-------|------|\n| Constants | 0 (payout=0, CLAIM_DEDUCTIBLE, 0 for < 0), HIGH_ENCHANTMENT_CLAIM_THRESHOLD, HIGH_ENCHANTMENT_CLAIM_RATE | ~6 |\n| Bindings | step, policies, policy, payout, damage, insuredItem, reimbursable, enchantment, isDragonMaterial | 9 |\n| Invocations | policies[], .find, .push (none), remainingCap access | 4 |\n| Conditionals | !policy, !insuredItem, enchantment >=, isDragonMaterial (else-if), reimbursable < 0, payout > remainingCap | 6 |\n| Loops | for (const damage) | 1 |\n| Assignments | reimbursable =, reimbursable -=, reimbursable=0, payout +=, payout =, remainingCap -= | 8 |\n\nMass: (6×1) + (9×1) + (4×2) + (6×4) + (1×5) + (8×6) = 6 + 9 + 8 + 24 + 5 + 48 = **100**\n\n### `calculateQuote` (unchanged):\n\n| Category | Count | Mass |\n|-----------|-------|------|\n| Constants | 0 (baseSum=0, itemSurcharges=0, componentCounts={}, 0.5, 0.3, 5, 3, 60) | 8 |\n| Bindings | items, componentCounts, baseSum, itemSurcharges, item, basePrice, [type, count], price | 8 |\n| Invocations | BLOCK_PRICE_COMPONENTS.has, ITEM_PRICES[], Object.entries, ITEM_PRICES[] | 8 |\n| Conditionals | .has(), cursed, enchantment >=, count === 3, else | 5 |\n| Loops | for item, for entries | 2 |\n| Assignments | componentCounts[] =, baseSum += (×3), itemSurcharges += (×2) | 6 |\n\nMass: 8 + 8 + 8 + 20 + 10 + 36 = **90**\n\n### Constants block (top-level): ~20 constants = **20**\n\n### New Total: 38 + 58 + 100 + 90 + 20 = **306**\n\n### Previous Total (estimated): **313**\n\n## Step 6: Document Decision\n\n---\n\n## Refactoring Complete\n\n### Refactoring Applied\n\n**Extract `processQuoteStep` and `processClaimStep` help