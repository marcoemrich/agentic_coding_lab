// like 100 * 1.1 = 110.00000000000001 by rounding to 6 decimals first.\nconst roundUpToWholeGold = (amount: number): number => {\n  return Math.ceil(Math.round(amount * 1e6) / 1e6);\n};\n\nexport const calculatePremium = (input: QuoteInput): number => {\n  if (input.items.length === 0) {\n    return PROCESSING_FEE_GOLD;\n  }\n\n  const componentPremium = (count: number): number => {\n    if (count === 3) {\n      return COMPONENT_BLOCK_OF_3_PREMIUM;\n    }\n    return count * COMPONENT_BASE_PREMIUM;\n  };\n\n  const isComponent = (item: QuoteItem) => COMPONENT_TYPES.includes(item.type);\n  const componentItems = input.items.filter(isComponent);\n  const mainItems = input.items.filter((item) => !isComponent(item));\n\n  const componentsSum = COMPONENT_TYPES.reduce((sum, type) => {\n    const count = componentItems.filter((item) => item.type === type).length;\n    return sum + componentPremium(count);\n  }, 0);\n\n  const policyBaseSum =\n    componentsSum +\n    mainItems.reduce((sum, item) => sum + BASE_PREMIUMS[item.type], 0);\n\n  const withFirstInsurance = policyBaseSum * 1.1;\n  const total = withFirstInsurance + PROCESSING_FEE_GOLD;\n  return roundUpToWholeGold(total);\n};\n"}],"isError":false,"timestamp":1784916531751},{"role":"assistant","content":[{"type":"text","text":"## Green -- Generalized component pricing to group by any component type (rune, moonstone), each type independently checked for the block-of-3 discount"},{"type":"toolCall","id":"toolu_vrtx_01R2N4EayhzG1jg1C7JGQd4p","name":"subagent","arguments":{"agent":"refactor","agentScope":"both","task":"Test file: src/quote.spec.ts\nImplementation file: src/quote.ts\nPassing tests: 4\nRecent Green phase: Generalized component pricing from rune-only to a COMPONENT_TYPES list (rune, moonstone). Each component type is now grouped and checked independently for the block-of-3 special premium. Left behind a now-unused `RUNE_TYPE` constant from a previous cycle that is dead code.\n\nRefactor the implementatio