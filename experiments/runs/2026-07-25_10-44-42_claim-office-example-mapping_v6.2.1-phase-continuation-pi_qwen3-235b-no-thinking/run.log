 The structure is already quite DRY.\n\n#### Rule 4: Fewest Elements\nThe code has opportunities to reduce complexity by extracting concerns.\n\n### Refactoring Plan\n\nI will extract the item premium calculation into a separate function to improve clarity and maintainability.\n\n"},{"type":"toolCall","id":"chatcmpl-tool-92b9285b62df3767","name":"edit","arguments":{"path":"src/claim-office.ts","edits":[{"oldText":"export const calculateInsurancePremium = (input: any): any => {\n  const results = [];\n  \n  for (const step of input.steps) {\n    if (step.op === \"quote\") {\n      let basePremium = 0;\n      \n      // Count component types\n      const componentCounts = countComponents(step.items);\n      \n      // Calculate premiums for non-component items\n      const nonComponentPremium = step.items\n        .filter(item => !['rune', 'moonstone'].includes(item.type))\n        .reduce((total, item) => {\n          let itemPremium = ITEM_BASE_PREMIUMS[item.type];\n          if (item.cursed) {\n            itemPremium += itemPremium * 0.5; // 50% risk surcharge for cursed items\n          }\n          if (item.enchantment !== undefined && item.enchantment >= 5) {\n            itemPremium += itemPremium * 0.3; // 30% risk surcharge for highly enchanted items\n          }\n          return total + itemPremium;\n        }, 0);\n      \n      basePremium += nonComponentPremium;\n      \n      // Apply block pricing for each component type separately\n      basePremium += calculateComponentPremium(componentCounts.rune);\n      basePremium += calculateComponentPremium(componentCounts.moonstone);\n      \n      // Calculate final premium: add processing fee and round up (MHPCO's favor)\n      const finalPremium = Math.ceil(basePremium + PROCESSING_FEE);\n      results.push({ premium: finalPremium });","newText":"const calculateItemPremium = (item: any): number => {\n  if (!ITEM_BASE_PREMIUMS[item.type]) {\n    throw new Error(`Unknown item type: ${item.type}`);\n  }\n  \n