 quantities: 25G per component\n  if (count === 3) { // Conditional + Binding\n    return COMPONENT_BLOCK_PREMIUM; // Invocation + Constant (implicit)\n  }\n  return count * COMPONENT_STANDARD_PREMIUM; // Invocation (multiplication) + Binding + Binding\n};\n\nexport const calculateInsurancePremium = (input: any): any => {\n  const results = []; // Binding + Constant (array)\n  \n  for (const step of input.steps) { // Loop + Binding\n    if (step.op === \"quote\") { // Conditional + Binding\n      let basePremium = 0; // Binding + Constant\n      \n      const componentCounts = { rune: 0, moonstone: 0 }; // Binding + Constant (object with initial values)\n      for (const item of step.items) { // Loop + Binding\n        if (item.type === \"rune\") { // Conditional + Binding\n          componentCounts.rune++; // Assignment + Invocation (++)\n        } else if (item.type === \"moonstone\") { // Conditional + Binding\n          componentCounts.moonstone++; // Assignment + Invocation (++)\n        } else {\n          basePremium += ITEM_BASE_PREMIUMS[item.type]; // Assignment + Binding\n        }\n      }\n      \n      for (const type of Object.keys(componentCounts)) { // Loop + Binding\n        const count = componentCounts[type]; // Binding\n        basePremium += getComponentPremium(count); // Assignment + Invocation\n      }\n      \n      // Calculate final premium: add processing fee and round up (MHPCO's favor)\n      const finalPremium = Math.ceil(basePremium + PROCESSING_FEE); // Binding + Invocation + Binding + Constant\n      results.push({ premium: finalPremium }); // Invocation + Constant\n    }\n  }\n  \n  return { results }; // Binding + Constant\n};\n```\n\nComponent Count:\n- Constants: 15 (same as before - we didn't change the number of literal values)\n- Bindings: 12 (same as before)\n- Invocations: 18 (removed 2 invocations: eliminated the `||` operator check and simplified the increment operations)\n- Conditionals: 8 (same - we changed from `||` to 