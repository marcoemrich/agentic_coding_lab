ium -- e.g., cursed sword base premium 100 G + 50 G = 150 G\");\n  it.todo(\"should add 30% risk surcharge for highly enchanted items (enchantment ≥ 5) to the item's base premium -- e.g., enchanted sword with enchantment 5: 100 G + 30 G = 130 G\");\n  it.todo(\"should apply 20% loyalty discount to policy base premium for customers with ≥ 2 years with MHPCO -- from integration example\");\n  it.todo(\"should add 10% initial assessment surcharge for first insurance to the policy base premium -- from integration example\");\n  it.todo(\"should apply 15% discount on each contract after the first to the policy base premium -- from integration example\");\n  it.todo(\"should add 5 G processing fee to every premium at the very end -- from rules\");\n  it.todo(\"should process newcomer with a cursed sword to return premium of 165 G -- integration example: 100 + 50 + 10 + 5 = 165\");\n  it.todo(\"should process long-standing customer's second contract with cursed, enchanted sword to return premium of 160 G -- integration example: 100 + 50 + 30 - 20 + 10 - 15 + 5 = 160\");\n  it.todo(\"should apply rounding up for final premium (e.g., 197.5 G → 198 G) -- in MHPCO's favor\");\n  it.todo(\"should apply rounding down for final payout (e.g., 350.5 G → 350 G) -- in MHPCO's favor\");\n  it.todo(\"should apply 100 G deductible per damage event -- e.g., damage 500 G → payout 400 G\");\n  it.todo(\"should apply 50% reimbursement for damage to items with enchantment level ≥ 8 -- e.g., damage 1000 G → payout 500 G before deductible\");\n  it.todo(\"should fully reimburse damage to items made of dragon material -- e.g., damage 800 G → payout 800 G before deductible\");\n  it.todo(\"should apply capped payout if both dragon material and high enchantment clauses apply, with high enchantment winning -- e.g., dragon sword, enchantment 9, damage 1000 G → payout 400 G\");\n  it.todo(\"should fully reimburse dragon material sword with enchantment 5, damage 800 G → payout 700 G\");\n  it.todo(\"should reimburse steel sword with enchantment 9, damage 1000 G → payout 400 G\");\n  it.todo(\"should reject claim with more damage entries than insured items of that type -- multiple items of the same type rule\");\n  it.todo(\"should calculate insurance sum as sum of items' insurance values, with cap at twice the sum -- e.g., sword and amulet: sum 1600 G, cap 3200 G\");\n  it.todo(\"should base claim cap on unmodified insurance value, ignoring premium modifiers -- e.g., cursed sword insurance value 1000 G → cap 2000 G\");\n  it.todo(\"should consider block discount only for premium, not for insurance sum -- e.g., sword and 3 runes: insurance sum 1750 G\");\n  it.todo(\"should reduce payout if remaining cap is less than calculated payout -- first claim reduces cap, second claim pays remaining cap\");\n});\n"}}],"api":"openai-completions","provider":"requesty","model":"nebius/qwen/qwen3-235b-a22b-instruct-2507","usage":{"input":22,"output":1345,"cacheRead":9024,"cacheWrite":0,"reasoning":0,"totalTokens":10391,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784950330998,"responseId":"rqsty-cmpl-019bbe28-96be-4ec3-bad3-2f589b328628","responseModel":"Qwen/Qwen3-235B-A22B-Instruct-2507"},"toolResults":[{"role":"toolResult","toolCallId":"chatcmpl-tool-81934d109e99920b","toolName":"write","content":[{"type":"text","text":"Successfully wrote 4516 bytes to src/claim-office.spec.ts"}],"isError":false,"timestamp":1784950337950}]}
