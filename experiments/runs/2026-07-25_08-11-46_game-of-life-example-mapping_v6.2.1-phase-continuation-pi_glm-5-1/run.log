 binding(1), binding(1)\n    const count = neighborCounts.get(toKey(x, y)) || 0;  // binding(1), invocation(2), invocation(2), conditional(4), constant(1)\n    if (count === 2 || count === 3) {         // conditional(4), conditional(4), constant(1), constant(1)\n      result.push([x, y]);                    // invocation(2)\n    }\n  }\n\n  for (const [key, count] of neighborCounts) { // loop(5), binding(1), binding(1)\n    if (count === 3 && !liveSet.has(key)) {   // conditional(4), constant(1), invocation(2)\n      result.push(fromKey(key));              // invocation(2), invocation(2)\n    }\n  }\n\n  return result;\n}\n```\n\n**Refactored Code Mass:**\n\n- Constants: 1(comma in toKey) + 1(comma in fromKey) + 1(0 in early return) + 1(empty array) + 16(direction values) + 1(0 in neighbor count) + 1(1 in +1) + 1(0 in || 0) + 1(empty result array) + 1(2) + 2(3, 3) = 26 → mass 26\n- Bindings: x,y in toKey(2) + x,y in fromKey(2) + key in fromKey(1) + cells(1) + liveSet(1) + x,y in liveSet loop(2) + neighborCounts(1) + NEIGHBOR_OFFSETS(1) + x,y in outer neighbor loop(2) + dx,dy(2) + key in neighbor loop(1) + result(1) + x,y in survival(2) + count(1) + key,count in reproduction(2) = 22 → mass 22\n- Invocations: template literal(1) + .split(1) + .map(1) + Number(1) + Set(1) + .add(1) + toKey(1) + Map(1) + toKey in loop(1) + .set(1) + .get(1) + .get in survival(1) + toKey in survival(1) + .push in survival(1) + .has(1) + fromKey(1) + .push in reproduction(1) = 17 → mass 34\n- Conditionals: if empty(1) + || 0 in counting(1) + || 0 in survival(1) + ===2 || ===3(2) + && in reproduction(1) = 6 → mass 24\n- Loops: liveSet(1) + outer neighbor(1) + inner neighbor(1) + survival(1) + reproduction(1) = 5 → mass 25\n- Assignments: 0 → mass 0\n\n**Total Mass: 26 + 22 + 34 + 24 + 25 + 0 = 131**\n\nHmm — the mass increased slightly from 122 to 131 due to the added helper function overhead (extra bindings, invocations). However, this is a case where **Rule 2 (Reveals Intent) trumps APP 