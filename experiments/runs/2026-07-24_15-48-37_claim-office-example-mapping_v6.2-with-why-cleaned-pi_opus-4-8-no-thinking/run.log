}\n\nexport interface Incident {\n  cause: string;\n  damages: Damage[];\n}\n\nexport interface Damage {\n  itemType: string;\n  amount: number;\n}\n\nexport interface ScenarioResult {\n  results: StepResult[];\n}\n\nexport type StepResult = { premium: number } | { payout: number; remainingCap: number };\n\nconst PROCESSING_FEE = 5;\nconst FIRST_INSURANCE_SURCHARGE_RATE = 0.1;\n\nconst BASE_PREMIUM: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n};\n\nconst itemPremium = (item: Item): number => {\n  const base = BASE_PREMIUM[item.type];\n  return base + base * FIRST_INSURANCE_SURCHARGE_RATE;\n};\n\nconst quotePremium = (items: Item[]): number =>\n  items.reduce((total, item) => total + itemPremium(item), PROCESSING_FEE);\n\nexport const runScenario = (scenario: Scenario): ScenarioResult => {\n  const results: StepResult[] = scenario.steps.map((step) =>\n    step.op === \"quote\"\n      ? { premium: quotePremium(step.items) }\n      : { premium: PROCESSING_FEE }\n  );\n  return { results };\n};\n"}],"isError":false,"timestamp":1784908343633},{"role":"assistant","content":[{"type":"toolCall","id":"toolu_vrtx_013rLcU8YzU8HbXh1bpzgSyJ","name":"edit","arguments":{"edits":[{"newText":"const BASE_PREMIUM: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n};\n\nconst COMPONENT_PREMIUM = 25;\n\nconst basePremiumFor = (type: string): number =>\n  type in BASE_PREMIUM ? BASE_PREMIUM[type] : COMPONENT_PREMIUM;\n\nconst itemPremium = (item: Item): number => {\n  const base = basePremiumFor(item.type);\n  return base + base * FIRST_INSURANCE_SURCHARGE_RATE;\n};","oldText":"const BASE_PREMIUM: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n};\n\nconst itemPremium = (item: Item): number => {\n  const base = BASE_PREMIUM[item.type];\n  return base + base * FIRST_INSURANCE_SURCHARGE_RATE;\n};"}],"path":"/home/experimenter/experiments/runs/2026-07-24_15-48-37_claim-offi