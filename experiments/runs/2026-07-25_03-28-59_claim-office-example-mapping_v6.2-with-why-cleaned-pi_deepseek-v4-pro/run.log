","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"Claim Office\", () => {\n  // === Quote: Base premiums (single items, no modifiers) ===\n  it(\"should compute base premium for a single sword -- 100 G base + 5 G fee = 105 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        { op: \"quote\", items: [{ type: \"sword\" }] }\n      ]\n    });\n    expect(result.results[0]).toEqual({ premium: 105 });\n  });\n  it(\"should compute base premium for a single amulet -- 60 G base + 5 G fee = 65 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        { op: \"quote\", items: [{ type: \"amulet\" }] }\n      ]\n    });\n    expect(result.results[0]).toEqual({ premium: 65 });\n  });\n  it(\"should compute base premium for a single staff -- 80 G base + 5 G fee = 85 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        { op: \"quote\", items: [{ type: \"staff\" }] }\n      ]\n    });\n    expect(result.results[0]).toEqual({ premium: 85 });\n  });\n  it.todo(\"should compute base premium for a single potion -- 40 G base + 5 G fee = 45 G\");\n\n  // === Component premiums ===\n  it.todo(\"should compute premium for a single rune — 25 G base + 5 G fee = 30 G\");\n  it.todo(\"should compute premium for a single moonstone — 25 G base + 5 G fee = 30 G\");\n  it.todo(\"should compute premium for 2 runes — 50 G base + 5 G fee = 55 G (no block)\");\n  it.todo(\"should compute premium for 3 runes — 60 G base (block) + 5 G fee = 65 G\");\n  it.todo(\"should compute premium for 4 runes — 100 G base (no block) + 5 G fee = 105 G\");\n  it.todo(\"should compute premium for 7 runes — 175 G base (no block) + 5 G fee = 180 G\");\n  it.todo(\"should compute premium for 2 runes + 1 moonstone — 75 G base + 5 G fee = 80 G (no block: different types)\");\n  it.todo(\"should compute premium for 3 runes + 3 moonstones — 120 G base + 5 G fee = 125 G (two separate blocks)\");\n\n  // === Modifier: Cursed items ===\n  it.todo(\"should apply 50% cursed surcharge to a cursed sword — 100 G base + 50 G curse + 5 G fee = 155 G\");\n  it.todo(\"should apply cursed surcharge only to the cursed item in a multi-item policy — cursed sword + plain amulet: 160 G base + 50 G curse + 5 G fee = 215 G\");\n\n  // === Modifier: High enchantment ===\n  it.todo(\"should apply 30% high-enchantment surcharge for sword with enchantment 5 — 100 G + 30 G + 5 G fee = 135 G\");\n  it.todo(\"should NOT apply high-enchantment surcharge for sword with enchantment 4 — 100 G + 5 G fee = 105 G\");\n  it.todo(\"should apply both cursed and high-enchantment surcharges for cursed sword with enchantment 5 — 100 G + 50 G + 30 G + 5 G fee = 185 G\");\n\n  // === Modifier: Loyalty discount ===\n  it.todo(\"should apply 20% loyalty discount for customer with exactly 2 years — sword: 100 G − 20 G + 5 G fee = 85 G\");\n  it.todo(\"should apply 20% loyalty discount for customer with 3 years — sword: 100 G − 20 G + 5 G fee = 85 G\");\n  it.todo(\"should NOT apply loyalty discount for customer with 1 year — sword: 100 G + 5 G fee = 105 G\");\n\n  // === Modifier: First insurance surcharge ===\n  it.todo(\"should apply 10% first insurance surcharge on first quote — sword: 100 G + 10 G + 5 G fee = 115 G\");\n  it.todo(\"should apply 15% follow-up contract discount on second quote (and subsequent) — second quote, sword: 100 G − 15 G + 10 G first insurance + 5 G fee = 100 G\");\n\n  // === Integration: Newcomer with a cursed sword ===\n  it.todo(\"should compute newcomer with cursed sword — 0 years, no prior: 100 G base + 50 G curse + 10 G first insurance + 5 G fee = 165 G\");\n\n  // === Integration: Long-standing customer's second contract ===\n  it.todo(\"should compute long-standing customer second contract — 3 years, second contract, cursed sword enchant