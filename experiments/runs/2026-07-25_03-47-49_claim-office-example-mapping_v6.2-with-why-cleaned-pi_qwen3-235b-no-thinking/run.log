icy with two swords -- insurance sum 2000 G"}],"api":"openai-completions","provider":"requesty","model":"nebius/qwen/qwen3-235b-a22b-instruct-2507","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1784951282729,"responseId":"rqsty-cmpl-1a31046e-3ddd-4a45-8ffe-54f0532971e3","responseModel":"Qwen/Qwen3-235B-A22B-Instruct-2507"}}
