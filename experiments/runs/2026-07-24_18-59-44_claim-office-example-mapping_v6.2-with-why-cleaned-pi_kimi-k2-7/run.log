sementRate(item) - 1, Math.max(0, ...) - 1 = 2\n- validateDamages: no invocations = 0\n- processClaim: validateDamages(incident.damages) - 1, incident.damages.reduce - 1, policy.items.find - 1, damagePayout(damage, item) - 1, Math.min(rawPayout, policy.cap) - 1, Math.floor(cappedPayout) - 1 = 6\n- processScenario: validateItemTypes(items) - 1, quotePremium(...) - 1, policyCapFor(items) - 1, processClaim(policy, step.incident) - 1 = 4\nTotal invocations: 0+0+0+0+0+2+2+3+6+2+1+0+2+0+6+4 = 28\n\nConditionals:\n- rateBasedAdjustment: ternary ? : = 1\n- premiumForComponentGroup: if = 1\n- itemSurchargeAmount: ternary in rateBasedAdjustment calls (2) = 2\n- quotePremium: ternary in rateBasedAdjustment calls (2) = 2\n- damageReimbursementRate: ternary ? : = 1\n- damagePayout: no conditionals = 0\n- processClaim: if (!item) = 1\n- processScenario: if (step.op === \"quote\"), else if (step.op === \"claim\") = 2\nTotal conditionals: 1+1+2+2+1+0+1+2 = 10\n\nLoops:\n- countItemsByType: for...of = 1\n- basePremiumForItems: for...of = 1\n- quotePremium: items.reduce = 1\n- policyInsuranceSum: items.reduce = 1\n- processClaim: incident.damages.reduce = 1\n- processScenario: for...of = 1\nTotal loops: 6\n\nAssignments:\n- countItemsByType: counts.set(...) - assignment = 1 per iteration, but as a loop body it's part of the loop\nActually, assignments count separately. Let me recount.\n- countItemsByType: const counts = new Map() - 1, counts.set(...) - 1 per iteration\n- basePremiumForItems: let total = 0 - 1, total += ... - 1 per iteration\n- quotePremium: itemSurcharges = items.reduce(...) - 1\n- processClaim: rawPayout = incident.damages.reduce(...) - 1, policy.cap = result.remainingCap - 1\n- processScenario: const results = [] - 1, const policies = [] - 1\nTotal assignments (not counting loop iterations, just statements): 1+1+1+1+1+1+1 = 7\n\nWait, I need to be more careful. The APP mass counts assignments as statements that mutate state. In functional code, const bindings don't