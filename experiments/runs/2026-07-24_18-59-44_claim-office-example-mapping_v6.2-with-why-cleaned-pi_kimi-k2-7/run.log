 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\nconst COMPONENT_BLOCK_SIZE = 3;\nconst COMPONENT_BLOCK_PRICE = 60;\nconst COMPONENT_BLOCK_TYPES = [\"rune\", \"moonstone\"];\nconst FIRST_INSURANCE_SURCHARGE_RATE = 0.1;\nconst LOYALTY_THRESHOLD = 2;\nconst LOYALTY_RATE = 0.2;\nconst FOLLOW_UP_CONTRACT_RATE = 0.15;\nconst CURSE_RATE = 0.5;\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\nconst HIGH_ENCHANTMENT_RATE = 0.3;\n\ntype Item = { type: string; cursed?: boolean; enchantment?: number };\n\ntype Scenario = {\n  customer: { yearsWithMHPCO: number };\n  steps: Array<{ op: string; items?: Item[] }>;\n};\n\nconst basePremiumFor = (itemType: string): number => BASE_PREMIUMS[itemType] ?? 0;\n\nconst countItemsByType = (items: Item[]): Map<string, number> => {\n  const counts = new Map<string, number>();\n  for (const item of items) {\n    counts.set(item.type, (counts.get(item.type) ?? 0) + 1);\n  }\n  return counts;\n};\n\nconst premiumForComponentGroup = (type: string, count: number): number => {\n  if (COMPONENT_BLOCK_TYPES.includes(type) && count === COMPONENT_BLOCK_SIZE) {\n    return COMPONENT_BLOCK_PRICE;\n  }\n  return count * basePremiumFor(type);\n};\n\nconst itemsBasePremium = (items: Item[]): number => {\n  let total = 0;\n  for (const [type, count] of countItemsByType(items)) {\n    total += premiumForComponentGroup(type, count);\n  }\n  return total;\n};\n\nconst itemSurchargeAmount = (item: Item): number => {\n  const base = basePremiumFor(item.type);\n  const curseSurcharge = rateAmountIf(item.cursed ?? false, base, CURSE_RATE);\n  const enchantmentSurcharge = rateAmountIf(\n    (item.enchantment ?? 0) >= HIGH_ENCHANTMENT_THRESHOLD,\n    base,\n    HIGH_ENCHANTMENT_RATE,\n  );\n  return curseSurcharge + enchantmentSurcharge;\n};\n\nconst quotePremium = (\n  items: Item[],\n  customer: { yearsWithMHPCO: number },\n  quoteIndex: number,\n): number => {\n  const itemsBase = itemsBasePremium(items);\n  const itemSurcharges = items.reduce((sum, item) => sum + itemSurchargeAmount(item), 0);\n  const firstInsuranceSurcharge = rateAmount(itemsBase, FIRST_INSURANCE_SURCHARGE_RATE);\n  const loyaltyDiscount = rateAmountIf(\n    customer.yearsWithMHPCO >= LOYALTY_THRESHOLD,\n    itemsBase,\n    LOYALTY_RATE,\n  );\n  const followUpDiscount = rateAmountIf(quoteIndex > 0, itemsBase, FOLLOW_UP_CONTRACT_RATE);\n  return Math.ceil(\n    itemsBase + itemSurcharges + firstInsuranceSurcharge - loyaltyDiscount - followUpDiscount + PROCESSING_FEE,\n  );\n};\n\nexport const processScenario = (scenario: Scenario): { results: Array<{ premium: number }> } => {\n  const results: Array<{ premium: number }> = [];\n  let quoteIndex = 0;\n  for (const step of scenario.steps) {\n    if (step.op === \"quote\") {\n      results.push({ premium: quotePremium(step.items ?? [], scenario.customer, quoteIndex) });\n      quoteIndex++;\n    }\n  }\n  return { results };\n};\n"}],"isError":false,"timestamp":1784920527751},{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me calculate the mass before and after.\n\n### Initial Mass Calculation (before refactoring)\n\nConstants:\n- PROCESSING_FEE = 5: 1\n- BASE_PREMIUMS object values: sword(100), amulet(60), staff(80), potion(40), rune(25), moonstone(25) = 6\n- COMPONENT_BLOCK_SIZE = 3: 1\n- COMPONENT_BLOCK_PRICE = 60: 1\n- COMPONENT_BLOCK_TYPES literals \"rune\", \"moonstone\": 2\n- FIRST_INSURANCE_SURCHARGE_RATE = 0.1: 1\n- LOYALTY_THRESHOLD = 2: 1\n- LOYALTY_RATE = 0.2: 1\n- FOLLOW_UP_CONTRACT_RATE = 0.15: 1\n- CURSE_RATE = 0.5: 1\n- HIGH_ENCHANTMENT_THRESHOLD = 5: 1\n- HIGH_ENCHANTMENT_RATE = 0.3: 1\nTotal constants: 18\n\nRuntime bindings:\n- basePremiumFor: itemType = 1\n- countItemsByType: items = 1, counts = 1, item = 1. Total = 3\n- premiumForComponentGroup: type = 1, count = 1. Total = 2\n- itemsBasePremium: items = 1, total = 1, type = 1, count = 1. Total = 4\n- itemSurchargeAmount: item = 1, base = 1, curseSurcharge = 1, enchantmentSurcharge = 1. Total = 4\n- q