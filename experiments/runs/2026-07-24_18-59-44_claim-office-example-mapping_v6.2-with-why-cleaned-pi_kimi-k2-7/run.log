 COMPONENT_BLOCK_SIZE) {\n    return COMPONENT_BLOCK_PRICE;\n  }\n  return count * basePremiumFor(type);\n};\n\nconst itemsBasePremium = (items: Item[]): number => {\n  const groups = new Map<string, number>();\n  for (const item of items) {\n    groups.set(item.type, (groups.get(item.type) ?? 0) + 1);\n  }\n  let total = 0;\n  for (const [type, count] of groups) {\n    total += premiumForComponentGroup(type, count);\n  }\n  return total;\n};\n\nconst itemSurchargeAmount = (item: Item): number => {\n  const base = basePremiumFor(item.type);\n  const curseSurcharge = item.cursed ? base * CURSE_RATE : 0;\n  const enchantmentSurcharge = (item.enchantment ?? 0) >= HIGH_ENCHANTMENT_THRESHOLD ? base * HIGH_ENCHANTMENT_RATE : 0;\n  return curseSurcharge + enchantmentSurcharge;\n};\n\nconst quotePremium = (items: Item[] | undefined = []): number => {\n  const itemsBase = itemsBasePremium(items);\n  const itemSurcharges = items.reduce((sum, item) => sum + itemSurchargeAmount(item), 0);\n  const firstInsurance = itemsBase * FIRST_INSURANCE_RATE;\n  return Math.ceil(itemsBase + itemSurcharges + firstInsurance + PROCESSING_FEE);\n};\n\nexport const processScenario = (scenario: Scenario): { results: Array<{ premium: number }> } => {\n  const quoteStep = scenario.steps[0];\n  return { results: [{ premium: quotePremium(quoteStep.items) }] };\n};\n"}],"isError":false,"timestamp":1784920351709},{"role":"toolResult","toolCallId":"functions.bash:10","toolName":"bash","content":[{"type":"text","text":"\n> tdd-experiment-run@ test /home/experimenter/experiments/runs/2026-07-24_18-59-44_claim-office-example-mapping_v6.2-with-why-cleaned-pi_kimi-k2-7\n> vitest run\n\n\n RUN  v1.6.1 /home/experimenter/experiments/runs/2026-07-24_18-59-44_claim-office-example-mapping_v6.2-with-why-cleaned-pi_kimi-k2-7\n\n ✓ src/claim-office.spec.ts  (35 tests | 21 skipped) 3ms\n\n Test Files  1 passed (1)\n      Tests  14 passed | 21 todo (35)\n   Start at  19:12:31\n   Duration  153ms (transform 29ms, setu