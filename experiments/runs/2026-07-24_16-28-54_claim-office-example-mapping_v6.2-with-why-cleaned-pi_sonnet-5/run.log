\n    policiesByStepIndex.set(stepIndex, { items: step.items, remainingCap: computeInsuranceCap(step.items) });\n    return { premium };\n  }\n  const policy = policiesByStepIndex.get(step.policy)!;\n  const result = computeClaim(policy.items, step.incident.damages, policy.remainingCap);\n  policy.remainingCap = result.remainingCap;\n  return result;\n};\n\nconst main = async (): Promise<void> => {\n  try {\n    const input = JSON.parse(await readStdin());\n    // isFollowUpContract is hardcoded to false: no step type yet signals a\n    // follow-up contract, so every quote is treated as a new one. The\n    // customer is built once, since it stays the same across every step.\n    const customer: QuoteCustomer = {\n      yearsWithMHPCO: input.customer.yearsWithMHPCO,\n      isFollowUpContract: false,\n    };\n    const policiesByStepIndex = new Map<number, PolicyRecord>();\n    const results = input.steps.map((step: Step, index: number) =>\n      processStep(step, customer, policiesByStepIndex, index)\n    );\n    process.stdout.write(JSON.stringify({ results }));\n  } catch (error) {\n    // Explicit error reporting instead of relying on Node's default\n    // unhandled-rejection behavior, which is implicit and version-dependent.\n    const message = error instanceof Error ? error.message : String(error);\n    process.stderr.write(`${message}\\n`);\n    process.exitCode = 1;\n  }\n};\n\nmain();\n"}],"isError":false,"timestamp":1784917442311},{"role":"assistant","content":[{"type":"text","text":"## Refactored Code Mass\n\n```ts\nconst main = async (): Promise<void> => {\n  try {\n    const input = JSON.parse(await readStdin());\n    const customer: QuoteCustomer = {\n      yearsWithMHPCO: input.customer.yearsWithMHPCO,\n      isFollowUpContract: false,\n    };\n    const policiesByStepIndex = new Map<number, PolicyRecord>();\n    const results = input.steps.map((step: Step, index: number) =>\n      processStep(step, customer, policiesByStepIndex, index)\n    );\n    process.stdout.write(JSON.stringify({ results }));\n  } catch (error) {\n    const message = error instanceof Error ? error.message : String(error);\n    process.stderr.write(`${message}\\n`);\n    process.exitCode = 1;\n  }\n};\n\nmain();\n```\n\nComponent Count:\n- Constants: `false`, `1` = 2\n- Bindings: `input`, `customer`, `policiesByStepIndex`, `results`, `step`, `index`, `error`, `message` = 8\n- Invocations: `JSON.parse`, `readStdin()`, `new Map()`, `processStep()`, `JSON.stringify()`, `process.stdout.write()`, `error instanceof Error`, `String(error)`, `process.stderr.write()`, `main()` = 10 → ×2 = 20\n- Conditionals: 1 (`try/catch` control-flow branch + ternary) → counting the catch dispatch + the `instanceof` ternary = 2 → ×4 = 8\n- Loops: `.map` = 1 → ×5 = 5\n- Assignments: `process.exitCode = 1` = 1 → ×6 = 6\n\n**Total Mass: 2 + 8 + 20 + 8 + 5 + 6 = 49**\n**Mass Change: 26 → 49 (delta +23)**\n\n## Refactoring Applied\n\n- **Naming**: Kept `main`, `readStdin`, `processStep` — still accurate.\n- **Rule 2 (Reveals Intent)**: Replaced implicit reliance on Node's default unhandled-rejection behavior with an explicit `try/catch` around `main()`'s body, explicit `process.stderr.write()`, and explicit `process.exitCode = 1`. The error-handling contract is now stated directly in the source rather than depending on runtime/version defaults.\n- **Mass increased (26 → 49)**, but this is the correct tradeoff: **Rule 2 trumps APP**. The added mass (try/catch, `instanceof` narrowing, explicit assignment) exists purely to make previously-accidental, implicit behavior explicit and intentional — not incidental complexity. Removing it would revert to error handling that \"works by accident,\" which is a correctness risk (Node's unhandled-rejection default has changed across versions) as well as an intent-clarity problem the task explicitly flagged.\n\n## Refactoring Complete\n\n**Refactoring**: Replaced implicit unhandled-promise-rejection error reporting with explicit `