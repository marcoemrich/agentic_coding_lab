.stdin) {\n    chunks.push(chunk);\n  }\n  return Buffer.concat(chunks).toString(\"utf-8\");\n};\n\nconst main = async (): Promise<void> => {\n  const input = JSON.parse(await readStdin());\n  const results = input.steps.map((step: { items: unknown[] }) =>\n    ({ premium: computePremium({ yearsWithMHPCO: input.customer.yearsWithMHPCO, isFollowUpContract: false }, step.items as never) })\n  );\n  process.stdout.write(JSON.stringify({ results }));\n};\n\nmain();","newText":"import { computePremium } from \"./quote.js\";\nimport type { Item, QuoteCustomer } from \"./types.js\";\n\ninterface QuoteStep {\n  items: Item[];\n}\n\nconst readStdin = async (): Promise<string> => {\n  const chunks: Buffer[] = [];\n  for await (const chunk of process.stdin) {\n    chunks.push(chunk);\n  }\n  return Buffer.concat(chunks).toString(\"utf-8\");\n};\n\nconst main = async (): Promise<void> => {\n  const input = JSON.parse(await readStdin());\n  // isFollowUpContract is hardcoded to false: no step type yet signals a\n  // follow-up contract, so every quote is treated as a new one. The\n  // customer is built once, since it stays the same across every step.\n  const customer: QuoteCustomer = {\n    yearsWithMHPCO: input.customer.yearsWithMHPCO,\n    isFollowUpContract: false,\n  };\n  const results = input.steps.map((step: QuoteStep) => ({\n    premium: computePremium(customer, step.items),\n  }));\n  process.stdout.write(JSON.stringify({ results }));\n};\n\nmain();"}}],"api":"openai-completions","provider":"requesty","model":"vertex/claude-sonnet-5@eu","usage":{"input":4556,"output":4146,"cacheRead":10003,"cacheWrite":0,"reasoning":0,"totalTokens":18705,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784916968942,"responseId":"rqsty-cmpl-73477cfa-cfe8-48dd-8142-95a59373900a","responseModel":"claude-sonnet-5"},{"role":"toolResult","toolCallId":"toolu_vrtx_01APMgsRmugd4SKGEgS8RY8v","toolName":"edit","content":[{"type":"text","te