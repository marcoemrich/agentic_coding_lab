ounts = new Map<string, number>();\n  let policyBase = 0;\n  let itemSurcharges = 0;\n\n  for (const item of items) {\n    const type = item.type ?? \"\";\n    if (COMPONENT_TYPES.has(type)) {\n      componentCounts.set(type, (componentCounts.get(type) ?? 0) + 1);\n    } else {\n      const base = basePremiumForItem(item);\n      policyBase += base;\n      itemSurcharges += itemSurchargeFor(item);\n    }\n  }\n\n  for (const count of componentCounts.values()) {\n    policyBase += componentBasePremiumForCount(count);\n  }\n\n  return { policyBase, itemSurcharges };\n};\n\nexport const processScenario = (scenario: unknown): { results: Array<{ premium: number }> } => {\n  const items = (scenario as ScenarioInput).steps[0].items ?? [];\n  const { policyBase, itemSurcharges } = premiumBreakdownForItems(items as Item[]);\n  return { results: [{ premium: policyBase + itemSurcharges + PROCESSING_FEE_GOLD }] };\n};\n"}],"isError":false,"timestamp":1784923643048},{"role":"toolResult","toolCallId":"functions.read:1","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"MHPCO Claim Office\", () => {\n  // Empty / simplest cases\n  it(\"should return premium 5 G for an empty item list -- only processing fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 5 }] });\n  });\n  it(\"should return premium 105 G for a single plain sword -- 100 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 105 }] });\n  });\n  it(\"should return premium 65 G for a single plain amulet -- 60 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"amulet\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it(\"should return premium 85 G for a single plain staff -- 80 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"staff\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 85 }] });\n  });\n  it(\"should return premium 45 G for a single plain potion -- 40 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"potion\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 45 }] });\n  });\n  it(\"should return premium 30 G for a single component -- 25 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 30 }] });\n  });\n\n  // Component blocks\n  it(\"should return premium 55 G for two runes -- 50 base + 5 fee (no block)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 55 }] });\n  });\n  it(\"should return premium 65 G for three runes -- 60 block base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    });\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it(\"should return premium 105 G for four runes -- 100 base + 5 fee (no block)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n          ],\n        },\n      ],\n    });\n    expect(result).toEqual({ results: [{ premium: 105 }] });\n  });\n  it(\"should return premium 180 G for seven runes -- 175 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: Array.from({ length: 7 }, () => ({ type: \"rune\" })),\n        },\n      ],\n    });\n    expect(result).toEqual({ results: [{ premium: 180 }] });\n  });\n\n  // Alike components\n  it(\"should return premium 80 G for two runes and one moonstone -- 75 base + 5 fee (no block)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"moonstone\" }],\n        },\n      ],\n    });\n    expect(result).toEqual({ results: [{ premium: 80 }] });\n  });\n  it(\"should return premium 125 G for three runes and three moonstones -- 120 block base + 5 fee (two blocks)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n          ],\n        },\n      ],\n    });\n    expect(result).toEqual({ results: [{ premium: 125 }] });\n  });\n\n  // Item modifiers\n  it(\"should add 50% curse surcharge to a cursed sword -- premium 155 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: