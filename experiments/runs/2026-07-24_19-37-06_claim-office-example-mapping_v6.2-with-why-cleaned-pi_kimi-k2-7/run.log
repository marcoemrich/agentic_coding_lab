n  return mainItemPremium + componentPremium;\n};\n\nexport const processScenario = (scenario: unknown): { results: Array<{ premium: number }> } => {\n  const items = (scenario as ScenarioInput).steps[0].items ?? [];\n  const basePremium = basePremiumForItems(items as Item[]);\n  return { results: [{ premium: basePremium + PROCESSING_FEE_GOLD }] };\n};\n"}],"isError":false,"timestamp":1784923224627},{"role":"toolResult","toolCallId":"functions.read:2","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"MHPCO Claim Office\", () => {\n  // Empty / simplest cases\n  it(\"should return premium 5 G for an empty item list -- only processing fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 5 }] });\n  });\n  it(\"should return premium 105 G for a single plain sword -- 100 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 105 }] });\n  });\n  it(\"should return premium 65 G for a single plain amulet -- 60 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"amulet\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it(\"should return premium 85 G for a single plain staff -- 80 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"staff\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 85 }] });\n  });\n  it(\"should return premium 45 G for a single plain potion -- 40 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"potion\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 45 }] });\n  });\n  it(\"should return premium 30 G for a single component -- 25 base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 30 }] });\n  });\n\n  // Component blocks\n  it(\"should return premium 55 G for two runes -- 50 base + 5 fee (no block)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 55 }] });\n  });\n  it(\"should return premium 65 G for three runes -- 60 block base + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    });\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it.todo(\"should return premium 105 G for four runes -- 100 base + 5 fee (no block)\");\n  it.todo(\"should return premium 180 G for seven runes -- 175 base + 5 fee\");\n\n  // Alike components\n  it.todo(\"should return premium 80 G for two runes and one moonstone -- 75 base + 5 fee (no block)\");\n  it.todo(\"should return premium 125 G for three runes and three moonstones -- 120 block base + 5 fee (two blocks)\");\n\n  // Item modifiers\n  it.todo(\"should add 50% curse surcharge to a cursed sword -- premium 155 G\");\n  it.todo(\"should add 30% high-enchantment surcharge to an enchantment-5 sword -- premium 130 G\");\n  it.todo(\"should add 30% high-enchantment surcharge to an enchantment-5 amulet -- premium 78 G\");\n  it.todo(\"should apply both curse and high-enchantment surcharges -- premium 180 G\");\n\n  // Customer modifiers\n  it.todo(\"should apply 20% loyalty discount for a customer with exactly 2 years -- premium 84 G\");\n  it.todo(\"should apply 10% first-insurance surcharge for a new customer -- premium 110 G\");\n  it.todo(\"should apply 15% follow-up contract discount -- premium 89 G\");\n\n  // Modifier scope on multi-item policies\n  it.todo(\"should apply cursed surcharge only to the cursed item -- premium 210 G before fee\");\n\n  // Modifier thresholds\n  it.todo(\"should apply loyalty discount at exactly 2 years with MHPCO\");\n  it.todo(\"should apply high-enchantment surcharge at exactly enchantment 5\");\n  it.todo(\"should apply both curse and high-enchantment surcharges when both conditions hold\");\n\n  // Integration examples\n  it.todo(\"should compute newcomer with a cursed steel enchantment-3 sword -- premium 165 G\");\n  it.todo(\"should compute long-standing customer's second contract with cursed steel enchantment-7 sword -- premium 160 G\");\n\n  // Claim: deductible and standard reimbursement\n  it.todo(\"should pay out 400 G for a regular steel enchantment-3 sword damaged 500 G\");\n  it.todo(\"should pay out 100 G for a rune damaged 200 G\");\n  it.todo(\"should apply deductible once per damaged item in a multi-item incident\");\n\n  // Claim: special reimbursement clauses\n  it.todo(\"should reimburse enchantment-8 damage at 50% then deductible -- 400 G for 1000 G damage\");\n  it.todo(\"should fully reimburse dragon-material damage then deductible -- 900 G for 1000 G damage\");\n  it.todo(\"should let high-enchantment 50% rule win over dragon material for enchantment 9 -- 400 G\");\n  it.todo(\"should use dragon material only when enchantment is below 8 -- 700 G\");\n  it.todo(\"should use high-enchantment only on non-dragon steel -- 400 G\");\n\n  // Claim: multiple items and caps\n  it.todo(\"should track policy insurance