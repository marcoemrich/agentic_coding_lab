Counts.values()) {\n    componentBasePremium += componentBasePremiumForCount(count);\n  }\n  policyBase += componentBasePremium;\n\n  return { policyBase, itemSurcharges };\n};\n\nexport const processScenario = (scenario: unknown): { results: Array<{ premium: number }> } => {\n  const items = (scenario as ScenarioInput).steps[0].items ?? [];\n  const { policyBase, itemSurcharges } = premiumBreakdownForItems(items as Item[]);\n  const premium = policyBase + itemSurcharges + PROCESSING_FEE_GOLD;\n  return { results: [{ premium }] };\n};\n```\n\nMass after with premium const:\nConstants: 18? Let's recount with rename no effect. Top 6 (5,100,3,60,25,0.5). Map values 4. Set strings 2. Empty strings 2. 0 curse return 1. Breakdown zeros: componentCounts.get fallback 1, policyBase init 1, itemSurcharges init 1, componentBasePremium init 1 = 4. Total 18. (No premium const constant? The right side uses bindings, no new constants.) So C=18.\nBindings: top 8, basePremiumForItem 2, curseSurchargeForItem 3, componentBasePremiumForCount 2, premiumBreakdownForItems 10, processScenario 6 (added premium) = 31.\nInvocations: Set 1 + basePremium 0 + curse 2 + componentBasePremiumForCount 2 + premiumBreakdownForItems 9 + processScenario 3 = 17.\nConditionals 2, loops 2, assignments 4.\nMass = 18+31+34+8+10+24 = 125. So -1 from 126. Hmm earlier version A without premium const mass 124. So premium const adds 1. If we want mass lower, skip premium const. But clarity maybe. Since Rule 2 trumps APP, we can include. But we can also say \"the named variable reveals intent and is worth the 1 mass point\". Good.\n\nAlternatively, remove premium const and mass 124. Then we need to explain the -2 mass due to removing dead constants. Let's skip premium const to maximize mass reduction and avoid adding unnecessary element. The return expression is clear enough. Final code without `const premium`:\n\n```\nreturn { results: [{ premium: policyBase + itemSurcharges + PROCESSING_FEE_GOLD }] };\n```\n\nMa