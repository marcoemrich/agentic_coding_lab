{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "reporters": [
    "json",
    "clear-text"
  ],
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/cli.ts"
  ],
  "coverageAnalysis": "perTest",
  "timeoutMS": 10000,
  "concurrency": 2,
  "jsonReporter": {
    "fileName": "reports/mutation/mutation-report.json"
  }
}