le that a claim's payout can never exceed what's\n// left of the policy's insurance cap, mirroring the small-named-helper\n// style used for applyDeductible above.\nconst capPayoutAtRemainingLimit = (\n  desiredPayout: number,\n  remainingCap: number\n): number => Math.min(desiredPayout, remainingCap);\n\nexport const computeClaim = (\n  policyItems: QuoteItem[],\n  damages: Damage[],\n  remainingCap: number\n): ClaimResult => {\n  validateDamagesFitPolicy(policyItems, damages);\n  const desiredPayout = sumDeductedPayouts(policyItems, damages);\n  const payout = capPayoutAtRemainingLimit(desiredPayout, remainingCap);\n  return { payout, remainingCap: remainingCap - payout };\n};\n> tdd-experiment-run@ test /home/experimenter/experiments/runs/2026-07-24_17-26-10_claim-office-example-mapping_v6.2-with-why-cleaned-pi_sonnet-5-no-thinking\n> vitest run\n\n\n RUN  v1.6.1 /home/experimenter/experiments/runs/2026-07-24_17-26-10_claim-office-example-mapping_v6.2-with-why-cleaned-pi_sonnet-5-no-thinking\n\n ✓ src/quote.spec.ts  (21 tests) 4ms\n ✓ src/claim.spec.ts  (15 tests | 4 skipped) 3ms\n ↓ src/scenario.spec.ts  (8 tests | 8 skipped)\n\n Test Files  2 passed | 1 skipped (3)\n      Tests  32 passed | 12 todo (44)\n   Start at  18:36:22\n   Duration  415ms (transform 43ms, setup 0ms, collect 51ms, tests 7ms, environment 0ms, prepare 130ms)\n\n"}],"isError":false,"timestamp":1784918182691},{"role":"assistant","content":[{"type":"text","text":"Confirmed green. Continuing to the last few claim tests.\n\n## Red -- Test 12 (claim): payout rounding 350.5 -> rounds down to 350"},{"type":"toolCall","id":"toolu_vrtx_0184EVSrxe2QvLkQNTAiEdWY","name":"edit","arguments":{"edits":[{"newText":"  it(\"payout calculation yielding 350.5 G -> rounds down to 350 G\", () => {\n    const result = computeClaim(\n      [{ type: \"sword\", enchantment: 9 }],\n      [{ itemType: \"sword\", amount: 901 }],\n      2000\n    );\n    expect(result.payout).toBe(350);\n  });","oldText":"  it.todo(\"pay