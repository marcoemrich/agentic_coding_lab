ed ? CURSE_SURCHARGE_RATE * BASE_PREMIUMS[item.type] : 0;\n\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\n\nconst highEnchantmentSurchargeFor = (item: QuoteItem): number =>\n  (item.enchantment ?? 0) >= HIGH_ENCHANTMENT_THRESHOLD\n    ? HIGH_ENCHANTMENT_SURCHARGE_RATE * BASE_PREMIUMS[item.type]\n    : 0;\n\nconst sumItemSurcharges = (items: QuoteItem[]): number =>\n  items.reduce(\n    (sum, item) =>\n      sum + curseSurchargeFor(item) + highEnchantmentSurchargeFor(item),\n    0\n  );\n\nexport const computeQuote = (\n  customer: Customer,\n  items: QuoteItem[]\n): QuoteResult => {\n  const counts = countByType(items);\n  const policyBasePremium = sumBasePremiums(counts);\n  const itemSurcharges = sumItemSurcharges(items);\n  const firstInsuranceSurcharge =\n    policyBasePremium * FIRST_INSURANCE_SURCHARGE_RATE;\n  const discount = loyaltyDiscount(customer, policyBasePremium);\n  const premium = roundUpInInsurersFavor(\n    policyBasePremium +\n      itemSurcharges +\n      firstInsuranceSurcharge -\n      discount +\n      PROCESSING_FEE\n  );\n  return { premium };\n};\n"}],"isError":false,"timestamp":1784916079239},{"role":"assistant","content":[{"type":"text","text":"I accidentally removed `loyaltyDiscount` and `LOYALTY_*` constants while editing. Let me restore them."},{"type":"toolCall","id":"toolu_vrtx_01GwURNtxBfUAQB48yzMQRQg","name":"edit","arguments":{"edits":[{"newText":"const sumItemSurcharges = (items: QuoteItem[]): number =>\n  items.reduce(\n    (sum, item) =>\n      sum + curseSurchargeFor(item) + highEnchantmentSurchargeFor(item),\n    0\n  );\n\nconst LOYALTY_DISCOUNT_RATE = 0.2;\nconst LOYALTY_THRESHOLD_YEARS = 2;\n\nconst loyaltyDiscount = (\n  customer: Customer,\n  policyBasePremium: number\n): number =>\n  customer.yearsWithMHPCO >= LOYALTY_THRESHOLD_YEARS\n    ? LOYALTY_DISCOUNT_RATE * policyBasePremium\n    : 0;","oldText":"const sumItemSurcharges = (items: QuoteItem[]): number =>\n  items.reduce(\n 