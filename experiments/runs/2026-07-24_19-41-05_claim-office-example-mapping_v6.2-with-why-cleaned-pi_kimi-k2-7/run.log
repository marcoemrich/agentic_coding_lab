\"every\", \"some\", \"find\"]);\n\nfunction isLoopMethodCall(node: ts.CallExpression): boolean {\n  if (ts.isPropertyAccessExpression(node.expression)) {\n    return loopMethods.has(node.expression.name.text);\n  }\n  return false;\n}\n\nfunction visit(node: ts.Node) {\n  switch (node.kind) {\n    case ts.SyntaxKind.NumericLiteral:\n    case ts.SyntaxKind.StringLiteral:\n    case ts.SyntaxKind.TrueKeyword:\n    case ts.SyntaxKind.FalseKeyword:\n    case ts.SyntaxKind.NullKeyword:\n    case ts.SyntaxKind.BigIntLiteral:\n      constants++;\n      break;\n    case ts.SyntaxKind.Identifier: {\n      const text = (node as ts.Identifier).text;\n      if (text === \"undefined\") constants++;\n      break;\n    }\n    case ts.SyntaxKind.VariableDeclaration:\n      if ((node as ts.VariableDeclaration).name.kind === ts.SyntaxKind.Identifier) {\n        bindings++;\n      }\n      break;\n    case ts.SyntaxKind.Parameter:\n      bindings++;\n      break;\n    case ts.SyntaxKind.CallExpression:\n    case ts.SyntaxKind.NewExpression:\n      invocations++;\n      if (isLoopMethodCall(node as ts.CallExpression)) loops++;\n      break;\n    case ts.SyntaxKind.BinaryExpression:\n    case ts.SyntaxKind.UnaryExpression:\n    case ts.SyntaxKind.UpdateExpression:\n    case ts.SyntaxKind.LogicalExpression:\n      invocations++;\n      break;\n    case ts.SyntaxKind.IfStatement:\n      conditionals++;\n      break;\n    case ts.SyntaxKind.ConditionalExpression:\n      conditionals++;\n      break;\n    case ts.SyntaxKind.ForStatement:\n    case ts.SyntaxKind.ForInStatement:\n    case ts.SyntaxKind.ForOfStatement:\n    case ts.SyntaxKind.WhileStatement:\n    case ts.SyntaxKind.DoStatement:\n      loops++;\n      break;\n    case ts.SyntaxKind.AssignmentExpression:\n    case ts.SyntaxKind.PostfixUnaryExpression:\n    case ts.SyntaxKind.PrefixUnaryExpression:\n      // UpdateExpression handled separately; AssignmentExpression for reassignments\n      break;\n  }\n\n  // Specific assignment 