return COMPONENT_BLOCK_PREMIUM; } return count * COMPONENT_PREMIUM; };\nconst premiumForComponentsOfType = (items: Item[], type: string): number => premiumForComponentCount(countByType(items, type));\nconst basePremiumFor = (item: Item): number => { if (item.type === \"sword\") return SWORD_PREMIUM; if (item.type === \"amulet\") return AMULET_PREMIUM; return 0; };\nconst itemModifierCents = (item: Item): number => { let modifier = 0; const base = basePremiumFor(item); if (item.cursed) { modifier += base * 0.5; } return modifier * CENTS_PER_GOLD; };\nconst roundUpCentsToGold = (cents: number): number => Math.ceil(cents / CENTS_PER_GOLD);\nconst policyModifierRate = (customer: Customer, contractIndex: number | null): number => { let rate = 0; if (customer.yearsWithMHPCO >= 2) { rate -= 0.2; } if (contractIndex === 0) { rate += 0.1; } else if (contractIndex !== null && contractIndex > 0) { rate -= 0.15; } return rate; };\nexport const quote = (customer: Customer, insuredItems: Item[], contractIndex: number | null = null): number => { if (insuredItems.length > 0 && (insuredItems[0].type === \"sword\" || insuredItems[0].type === \"amulet\")) { const baseCents = insuredItems.reduce((sum, item) => sum + basePremiumFor(item) * CENTS_PER_GOLD, 0); const itemModifierTotal = insuredItems.reduce((sum, item) => sum + itemModifierCents(item), 0); const policyRate = policyModifierRate(customer, contractIndex); const policyModifierCents = baseCents * policyRate; const totalCents = baseCents + itemModifierTotal + policyModifierCents + BASE_FEE * CENTS_PER_GOLD; return roundUpCentsToGold(totalCents); } return (BASE_FEE + premiumForComponentsOfType(insuredItems, \"rune\") + premiumForComponentsOfType(insuredItems, \"moonstone\")); };\nexport const claim = (policy: any, incident: any): any => { return undefined; };\n```\n\nCounting carefully:\n- Constants: 7 (100, 5, 100, 60, 25, 60, 3) = 7\n- Bindings: \n  - countByType params: items, type, item (3)\n  - premiumForComponentCount param