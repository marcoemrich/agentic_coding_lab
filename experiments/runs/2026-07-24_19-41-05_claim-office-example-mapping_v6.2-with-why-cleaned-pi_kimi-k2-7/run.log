ents: 6 × 6 = 36\nTotal: 7 + 28 + 18 + 40 + 15 + 36 = 144\n\nNow, proposed refactored code:\n```typescript\ntype Item = { type: string; material?: string; enchantment?: number; cursed?: boolean; };\ntype Customer = { yearsWithMHPCO: number; };\nconst CENTS_PER_GOLD = 100;\nconst BASE_FEE = 5;\nconst SWORD_PREMIUM = 100;\nconst AMULET_PREMIUM = 60;\nconst COMPONENT_PREMIUM = 25;\nconst COMPONENT_BLOCK_PREMIUM = 60;\nconst COMPONENTS_PER_BLOCK = 3;\nconst countByType = (items: Item[], type: string): number => items.filter((item) => item.type === type).length;\nconst premiumForComponentCount = (count: number): number => { if (count === COMPONENTS_PER_BLOCK) { return COMPONENT_BLOCK_PREMIUM; } return count * COMPONENT_PREMIUM; };\nconst premiumForComponentsOfType = (items: Item[], type: string): number => premiumForComponentCount(countByType(items, type));\nconst basePremiumFor = (item: Item): number => { if (item.type === \"sword\") return SWORD_PREMIUM; if (item.type === \"amulet\") return AMULET_PREMIUM; return 0; };\nconst isEquipmentItem = (item: Item): boolean => item.type === \"sword\" || item.type === \"amulet\";\nconst firstItemIsEquipment = (items: Item[]): boolean => items.length > 0 && isEquipmentItem(items[0]);\nconst sumBy = <T>(items: T[], valueFor: (item: T) => number): number => items.reduce((sum, item) => sum + valueFor(item), 0);\nconst itemModifierCents = (item: Item): number => { let modifier = 0; const base = basePremiumFor(item); if (item.cursed) { modifier += base * 0.5; } return modifier * CENTS_PER_GOLD; };\nconst roundUpCentsToGold = (cents: number): number => Math.ceil(cents / CENTS_PER_GOLD);\nconst policyModifierRate = (customer: Customer, contractIndex: number | null): number => { let rate = 0; if (customer.yearsWithMHPCO >= 2) { rate -= 0.2; } if (contractIndex === 0) { rate += 0.1; } else if (contractIndex !== null && contractIndex > 0) { rate -= 0.15; } return rate; };\nexport const quote = (customer: Customer, insuredItems: Item[], contractIndex: number | null = null): number => { if (firstItemIsEquipment(insuredItems)) { const baseCents = sumBy(insuredItems, (item) => basePremiumFor(item) * CENTS_PER_GOLD); const itemModifierTotal = sumBy(insuredItems, itemModifierCents); const policyRate = policyModifierRate(customer, contractIndex); const policyModifierCents = baseCents * policyRate; const totalCents = baseCents + itemModifierTotal + policyModifierCents + BASE_FEE * CENTS_PER_GOLD; return roundUpCentsToGold(totalCents); } return (BASE_FEE + premiumForComponentsOfType(insuredItems, \"rune\") + premiumForComponentsOfType(insuredItems, \"moonstone\")); };\nexport const claim = (policy: any, incident: any): any => { return undefined; };\n```\n\nNew mass:\n- Constants: 7\n- Bindings: \n  - countByType: 3\n  - premiumForComponentCount: 1\n  - premiumForComponentsOfType: 2\n  - basePremiumFor: 1\n  - isEquipmentItem: item = 1\n  - firstItemIsEquipment: items = 1\n  - sumBy: T (type param), items, valueFor, sum, item = 5\n  - itemModifierCents: 3\n  - roundUpCentsToGold: 1\n  - policyModifierRate: 3\n  - quote: customer, insuredItems, contractIndex, item (in first sumBy callback), item (in second sumBy callback), baseCents, itemModifierTotal, policyRate, policyModifierCents, totalCents = 10\n  - claim: 2\n  Total bindings: 3+1+2+1+1+1+5+3+1+3+10+2 = 33\n- Invocations:\n  - countByType: filter = 1\n  - premiumForComponentCount: 0\n  - premiumForComponentsOfType: 2\n  - basePremiumFor: 0\n  - isEquipmentItem: 0 (operators only)\n  - firstItemIsEquipment: .length (property), isEquipmentItem = 1\n  - sumBy: reduce = 1\n  - itemModifierCents: basePremiumFor = 1\n  - roundUpCentsToGold: Math.ceil = 1\n  - policyModifierRate: 0\n  - quote: firstItemIsEquipment(1), sumBy(2), policyModifierRate(1), roundUpCentsToGold(1), premiumForComponentsOfType(2) = 7\n  - claim: 0\n  Total invocations: 1 + 0 + 2 + 0 + 0 + 1 + 1 + 1 + 1 + 0 + 7 + 0 = 14\n- Conditionals:\n  - premiumForComponentCount: 1\n  - basePremiumFor: 