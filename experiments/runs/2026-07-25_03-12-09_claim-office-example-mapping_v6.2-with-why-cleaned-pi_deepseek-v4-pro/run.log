t VALID_ITEM_TYPES = new Set([\"sword\", \"amulet\", \"staff\", \"potion\", \"rune\", \"moonstone\"]);\n\nconst validateItems = (steps: Step[]): void => {\n  for (const step of steps) {\n    if (step.op === \"quote\" && step.items) {\n      for (const item of step.items) {\n        if (!VALID_ITEM_TYPES.has(item.type)) {\n          throw new Error(`Unknown item type: ${item.type}`);\n        }\n      }\n    }\n  }\n};\n\nconst BASE_PREMIUMS: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\nexport const processScenario = (input: unknown): { results: QuoteResult[] } => {\n  const scenario = input as Scenario;\n  validateItems(scenario.steps);\n  \n  const results: QuoteResult[] = [];\n  for (const step of scenario.steps) {\n    if (step.op === \"quote\") {\n      const items = step.items ?? [];\n      let total = 0;\n      \n      // Count component types for block discount\n      const componentCounts: Record<string, number> = {};\n      for (const item of items) {\n        if (item.type === \"rune\" || item.type === \"moonstone\") {\n          componentCounts[item.type] = (componentCounts[item.type] ?? 0) + 1;\n        } else {\n          total += BASE_PREMIUMS[item.type] ?? 0;\n        }\n      }\n      \n      // Apply block discount: every 3 alike components = 60 instead of 3×25\n      for (const count of Object.values(componentCounts)) {\n        const blocks = Math.floor(count / 3);\n        const remainder = count % 3;\n        total += blocks * 60 + remainder * 25;\n      }\n      \n      // Processing fee\n      total += 5;\n      results.push({ premium: total });\n    }\n  }\n  \n  return { results };\n};"}],"isError":false,"timestamp":1784949290551},{"role":"toolResult","toolCallId":"call_cc21d62746c24422bb214ebc","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\n\nimport { processScenario } from \"./cli.js\";\n\ndescribe(\"Claim Office CLI\", () => {\n  // ============================================================\n  // QUOTE tests -- ordered simple to complex\n  // ============================================================\n\n  // --- Edge cases / simplest ---\n  it(\"should return premium 5 G for empty item list (only processing fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 5 }] });\n  });\n  it(\"should exit with non-zero status code and write error to stderr for quote with unknown item type (e.g. broomstick)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"broomstick\" }] }],\n    };\n    expect(() => processScenario(input)).toThrow();\n  });\n\n  // --- Single items, base premiums only ---\n  it(\"should return premium 105 G for a single sword (100 G base + 5 G fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\", material: \"steel\", enchantment: 0, cursed: false }] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 105 }] });\n  });\n  it(\"should return premium 65 G for a single amulet (60 G base + 5 G fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"amulet\", material: \"silver\", enchantment: 0, cursed: false }] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it(\"should return premium 85 G for a single staff (80 G base + 5 G fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"staff\", material: \"wood\", enchantment: 0, cursed: false }] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 85 }] });\n  });\n  it(\"should return premium 45 G for a single potion (40 G base + 5 G fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"potion\", material: \"glass\", enchantment: 0, cursed: false }] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 45 }] });\n  });\n\n  // --- Components ---\n  it(\"should return premium 55 G for 2 runes (2×25 G base + 5 G fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 55 }] });\n  });\n  it(\"should return premium 65 G for 3 runes -- block applies (60 G block + 5 G fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it.todo(\"should return premium 105 G for 4 runes -- no block (4×25 G + 5 G fee)\");\n  it.todo(\"should return premium 180 G for 7 runes (7×25 G + 5 G fee)\");\n\n  // --- \"Alike\" components ---\n  it.todo(\"should return premium 80 G for 2 runes + 1 moonstone -- no block, different types (3×25 G + 5 G fee)\");\n  it.todo(\"should return premium 125 G for 3 runes + 3 moonstones -- two separate blocks (60+60 G + 5 G fee)\");\n\n  // --- Cursed modifier ---\n  it.todo(\"should return premium 155 G for a cursed sword (100 G + 50 G curse + 5 G fee)\");\n\n  // --- Highly enchanted modifier (enchantment >= 5) ---\n  it.todo(\"should return premium 140 G for a sword with enchantment 5 (100 G + 30 G enchantment + 5 G fee)\");\n  it.todo(\"should return