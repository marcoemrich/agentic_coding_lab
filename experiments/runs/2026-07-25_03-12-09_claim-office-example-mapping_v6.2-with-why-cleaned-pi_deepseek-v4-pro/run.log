x\n  // ============================================================\n\n  // --- Edge cases ---\n  it.todo(\"should exit with non-zero status for claim with damage entry whose item is not in policy\");\n  it.todo(\"should exit with non-zero status for claim with unknown item type in damages\");\n  it.todo(\"should exit with non-zero status for claim with negative damage amount (-200)\");\n  it.todo(\"should exit with non-zero status for claim with more damage entries of a type than insured\");\n\n  // --- Simple reimbursement ---\n  it.todo(\"should pay 400 G for regular sword (steel, enchantment 3), damage 500 G (500 - 100 deductible)\");\n  it.todo(\"should pay 100 G for rune (insurance value 250 G), damage 200 G (200 - 100 deductible)\");\n\n  // --- Deductible per damage event ---\n  it.todo(\"should pay 600 G for dragon attack damaging sword (500 G) and amulet (300 G) -- deductible per item: (500-100)+(300-100) = 600\");\n\n  // --- Enchantment threshold (>= 8) ---\n  it.todo(\"should reimburse at 50% for enchantment >= 8: steel sword enchantment 9, damage 1000 G → 400 G (500 - 100 deductible)\");\n  it.todo(\"should pay 700 G for dragon-material sword enchantment 5, damage 800 G — only dragon clause applies (800 - 100)\");\n  it.todo(\"should pay 400 G for dragon-material sword enchantment 9, damage 1000 G — 50% rule wins (500 - 100)\");\n\n  // --- Dragon material ---\n  it.todo(\"should fully reimburse dragon-material items (minus deductible)\");\n\n  // --- Cap exhaustion ---\n  it.todo(\"should cap insurance at 1600 G for sword + amulet policy (insurance sum 1600, cap 3200)\");\n  it.todo(\"should have cap 2000 G for cursed sword (based on unmodified insurance value 1000)\");\n  it.todo(\"should have insurance sum 1750 G for sword + 3 runes block (1000 + 3×250); block discount does not affect sum\");\n  it.todo(\"should exhaust cap correctly: two successive claims of 1500 G each — first=1400 G, second=600 G\");\n\n  // --- Rounding for payouts ---\n  it.to