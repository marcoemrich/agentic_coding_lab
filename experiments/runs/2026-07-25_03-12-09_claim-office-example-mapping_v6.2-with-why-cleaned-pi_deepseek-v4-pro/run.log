eturn { results: [{ premium: 5 }] };\n};"}],"isError":false,"timestamp":1784949209073},{"role":"toolResult","toolCallId":"call_2e59793abcef4887998e054b","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\n\nimport { processScenario } from \"./cli.js\";\n\ndescribe(\"Claim Office CLI\", () => {\n  // ============================================================\n  // QUOTE tests -- ordered simple to complex\n  // ============================================================\n\n  // --- Edge cases / simplest ---\n  it(\"should return premium 5 G for empty item list (only processing fee)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    };\n    const result = processScenario(input);\n    expect(result).toEqual({ results: [{ premium: 5 }] });\n  });\n  it(\"should exit with non-zero status code and write error to stderr for quote with unknown item type (e.g. broomstick)\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"broomstick\" }] }],\n    };\n    expect(() => processScenario(input)).toThrow();\n  });\n\n  // --- Single items, base premiums only ---\n  it.todo(\"should return premium 105 G for a single sword (100 G base + 5 G fee)\");\n  it.todo(\"should return premium 65 G for a single amulet (60 G base + 5 G fee)\");\n  it.todo(\"should return premium 85 G for a single staff (80 G base + 5 G fee)\");\n  it.todo(\"should return premium 45 G for a single potion (40 G base + 5 G fee)\");\n\n  // --- Components ---\n  it.todo(\"should return premium 55 G for 2 runes (2×25 G base + 5 G fee)\");\n  it.todo(\"should return premium 65 G for 3 runes -- block applies (60 G block + 5 G fee)\");\n  it.todo(\"should return premium 105 G for 4 runes -- no block (4×25 G + 5 G fee)\");\n  it.todo(\"should return premium 180 G for 7 runes (7×25 G + 5 G fee)\");\n\n  // --- \"Alike\" components ---\n  it.todo(\"should return premium 80 G for 2 runes + 1 moonstone -- no block, different types (3×25 G + 5 G fee)\");\n  it.todo(\"should return premium 125 G for 3 runes + 3 moonstones -- two separate blocks (60+60 G + 5 G fee)\");\n\n  // --- Cursed modifier ---\n  it.todo(\"should return premium 155 G for a cursed sword (100 G + 50 G curse + 5 G fee)\");\n\n  // --- Highly enchanted modifier (enchantment >= 5) ---\n  it.todo(\"should return premium 140 G for a sword with enchantment 5 (100 G + 30 G enchantment + 5 G fee)\");\n  it.todo(\"should return premium 105 G for a sword with enchantment 4 -- no enchantment surcharge (100 G + 5 G fee)\");\n\n  // --- Cursed + highly enchanted combined ---\n  it.todo(\"should return premium 185 G for a cursed sword with enchantment 5 (100 G + 50 G curse + 30 G enchantment + 5 G fee)\");\n\n  // --- Loyalty discount (>= 2 years with MHPCO) ---\n  it.todo(\"should return premium 89 G for a sword with loyalty discount, 2 years with MHPCO (100 G - 20 G loyalty + 5 G fee)\");\n\n  // --- First insurance surcharge (10%) ---\n  it.todo(\"should return premium 115 G for a sword as first insurance (100 G + 10 G first insurance + 5 G fee)\");\n\n  // --- Follow-up contract discount (15% on each contract after first) ---\n  it.todo(\"should return premium 94 G for a sword as second contract (100 G - 15 G follow-up discount + 5 G fee)\");\n\n  // --- Modifier scope on multi-item policies ---\n  it.todo(\"should apply cursed surcharge only to the cursed item, not policy total -- cursed sword (100 G), plain amulet (60 G) → 210 G before first-insurance/fee, final 236 G\");\n\n  // --- Integration example: Newcomer with cursed sword ---\n  it.todo(\"should return premium 165 G for newcomer (0 years, no previous contract) with cursed sword (steel, enchantment 3)\");\n\n  // --- Integration example: Long-standing customer's second contract ---\n  it.todo(\"should return premium 160 G for 3-year customer, second quote, cursed sword (enc