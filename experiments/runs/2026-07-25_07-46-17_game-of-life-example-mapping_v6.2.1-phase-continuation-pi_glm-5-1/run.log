didates.add(cellKey([cell[0] + dx, cell[1] + dy]));  -- invocation: 2\n    }\n    candidates.add(cellKey(cell));                       -- invocation: 2\n  }\n\n  const result: Cell[] = [];                             -- binding: 1\n  for (const key of candidates) {                        -- binding: 1, loop: 1\n    const cell = keyToCell(key);                         -- binding: 1, invocation: 1\n    const neighbors = countNeighbors(cell, liveSet);     -- binding: 1, invocation: 1\n    if (survives(liveSet.has(key), neighbors)) {         -- conditional: 1, invocation: 2\n      result.push(cell);                                 -- invocation: 1, assignment: 1\n    }\n  }\n\n  result.sort((a, b) => a[0] - b[0] || a[1] - b[1]);   -- bindings: 2, invocation: 1\n\n  return result;\n}\n```\n\n**Components:**\n- Constants: 1 (count=0) + 2 (===3, ===2) + 1 (===0) + 15 (NEIGHBOR_OFFSETS literals) = 19\n- Bindings: ~35\n- Invocations: ~20 → ×2 = 40\n- Conditionals: 6 → ×4 = 24\n- Loops: 6 → ×5 = 30\n- Assignments: 2 → ×6 = 12\n\n**Estimated Total: ~19 + 35 + 40 + 24 + 30 + 12 = 160**\n\nThe key mass reductions come from:\n- Eliminating 2 nested for-loops (replaced with for-of over NEIGHBOR_OFFSETS) — saves ~2 loops × 5 = 10\n- Eliminating the `if (dx === 0 && dy === 0) continue` conditional — saves ~4\n- Consolidating two conditional branches into `survives()` — reduced conditional complexity\n- The `survives` function adds clarity (Rule 2) with minimal mass overhead\n\n---\n\n**Refactoring Applied**:\n1. **Naming (Rule 2)**: Renamed `parseKey` → `keyToCell` — makes the inverse relationship with `cellKey` explicit and self-documenting\n2. **DRY (Rule 3)**: Extracted `NEIGHBOR_OFFSETS` constant — eliminated duplicated neighbor iteration logic in `countNeighbors` and `nextGeneration`, removing the need for `if (dx === 0 && dy === 0) continue` guard\n3. **Fewest Elements (Rule 4)**: Extracted `survives()` function — consolidated the two separate survival/birth conditionals (`isA