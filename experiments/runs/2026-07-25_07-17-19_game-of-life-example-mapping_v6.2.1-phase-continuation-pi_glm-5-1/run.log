=> {\n  // Empty grid\n  it.todo(\"should return empty array for empty grid -- no cells means no next generation\");\n\n  // Rule 1: Underpopulation (live cell with < 2 neighbors dies)\n  it.todo(\"should kill a single live cell with 0 neighbors -- Rule 1 underpopulation: [(0,0)] → []\");\n  it.todo(\"should kill two adjacent live cells each with only 1 neighbor -- Rule 1 underpopulation: [(0,1),(1,1)] → []\");\n\n  // Rule 2: Survival (live cell with 2 or 3 neighbors lives on)\n  it.todo(\"should keep a live cell alive with 2 neighbors -- Rule 2 survival\");\n  it.todo(\"should keep a live cell alive with 3 neighbors -- Rule 2 survival: center cell (1,1) with 3 neighbors survives in [(0,0),(1,0),(2,0),(1,2)]\");\n\n  // Rule 3: Overpopulation (live cell with > 3 neighbors dies)\n  it.todo(\"should kill a live cell with 4 neighbors -- Rule 3 overpopulation: center cell (1,1) with 4 neighbors dies in [(0,0),(1,0),(2,0),(0,1),(2,1),(0,2),(1,2),(2,2)]\");\n\n  // Rule 4: Reproduction (dead cell with exactly 3 neighbors becomes alive)\n  it.todo(\"should bring a dead cell to life with exactly 3 neighbors -- Rule 4 reproduction: dead cell (1,1) becomes alive from [(0,0),(1,0),(0,1)]\");\n\n  // Combined rules: Block (still life)\n  it.todo(\"should produce a stable block pattern -- Block still life: [(0,0),(1,0),(0,1),(1,1)] → unchanged\");\n\n  // Combined rules: Blinker (oscillator)\n  it.todo(\"should oscillate a blinker from vertical to horizontal -- Blinker Gen 0: [(0,0),(0,1),(0,2)] → [(-1,1),(0,1),(1,1)]\");\n  it.todo(\"should oscillate a blinker back from horizontal to vertical -- Blinker Gen 1: [(-1,1),(0,1),(1,1)] → [(0,0),(0,1),(0,2)]\");\n\n  // Negative coordinates\n  it.todo(\"should handle negative coordinates correctly -- cells at negative x/y positions\");\n});\n","path":"/home/experimenter/experiments/runs/2026-07-25_07-17-19_game-of-life-example-mapping_v6.2.1-phase-continuation-pi_glm-5-1/src/game-of-life.spec.ts"}}],"api":"openai-completions","provi