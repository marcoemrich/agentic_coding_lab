/** Base premium per single item type (components are 25 G each). */\nconst BASE_PREMIUM: Partial<Record<string, number>> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\n/** Base premium of one quoted item; unknown types contribute nothing (validated later). */\nfunction itemBase(item: { type: string }): number {\n  return BASE_PREMIUM[item.type] ?? 0;\n}\n\n/** Input shape for `runScenario`: a list of steps, each optionally carrying typed items. */\ntype Scenario = { steps: Array<{ op: string; items?: Array<{ type: string }> }> };\n\nexport function runScenario(input: unknown): { results: StepResult[] } {\n  const scenario = input as Scenario;\n  const step = scenario.steps[0];\n  const items = step.items ?? [];\n  const policyBase = items.reduce((sum, it) => sum + itemBase(it), 0);\n  const premium = roundUp(policyBase * (1 + FIRST_INSURANCE_RATE) + PROCESSING_FEE);\n  return { results: [{ premium }] };\n}\n"}],"isError":false,"timestamp":1784952055621},{"role":"toolResult","toolCallId":"call_4f3d06ee9bcd4815a1e435da","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { execFileSync } from \"node:child_process\";\nimport { resolve } from \"node:path\";\nimport { runScenario } from \"./office.js\";\n\n/** Run the CLI as a subprocess, feeding `input` as stdin JSON. */\nfunction runCli(input: unknown): { stdout: string; stderr: string; exitCode: number } {\n  const cliPath = resolve(process.cwd(), \"src/cli.ts\");\n  const bin = resolve(process.cwd(), \"node_modules/.bin/tsx\");\n  try {\n    const stdout = execFileSync(bin, [cliPath], {\n      input: JSON.stringify(input),\n      encoding: \"utf-8\",\n      timeout: 30000,\n    });\n    return { stdout, stderr: \"\", exitCode: 0 };\n  } catch (err) {\n    const e = err as { stdout?: string; stderr?: string; status?: number };\n    return {\n      stdout: e.stdout ?? \"\",\n      stderr: e.stderr ?? \"\",\n 