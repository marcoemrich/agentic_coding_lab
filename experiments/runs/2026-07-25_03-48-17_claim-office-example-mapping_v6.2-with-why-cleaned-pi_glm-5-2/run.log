mage,DEDUCTIBLE(4) = 12\n  }\n  const payout = roundDown(Math.min(uncappedPayout, policy.remainingCap));  // binding payout(1) + assignment(6) + invocation roundDown(2) + invocation Math.min(2) + bindings uncappedPayout,policy(2) = 13\n  policy.remainingCap -= payout;                               // assignment(6) + bindings policy,payout(2) = 8\n  return { payout, remainingCap: policy.remainingCap };        // binding payout(1) + const remainingCap key(1) + binding policy(1) = 3\n}\n```\n\nSum: 10+8+7+6+8+11+6+8+11+12+13+8+3 = 111\n\nLet me add: 10+8=18; +7=25; +6=31; +8=39; +11=50; +6=56; +8=64; +11=75; +12=87; +13=100; +8=108; +3=111.\n\n**Before mass (`processClaim`): 111**\n\n### AFTER — `takeInsuredItem` + `processClaim`\n\n`takeInsuredItem`:\n```typescript\nfunction takeInsuredItem(pool: Item[], damage: Damage): Item {\n  if (damage.amount < 0) {                                     // cond(4) + binding damage(1) + const 0(1) = 6\n    throw new Error(`...${damage.amount}`);                   // cond throw(4) + invocation(2) + const(1) + binding damage(1) = 8\n  }\n  const index = pool.findIndex((it) => it.type === damage.itemType);  // binding(1)+assign(6)+inv(2)+binding it(1)+binding damage(1) = 11\n  if (index === -1) {                                         // cond(4)+binding index(1)+const -1(1) = 6\n    throw new Error(`...${damage.itemType}`);                 // cond throw(4)+inv(2)+const(1)+binding damage(1) = 8\n  }\n  const [item] = pool.splice(index, 1);                      // binding item(1)+assign(6)+inv splice(2)+binding index(1)+const 1(1) = 11\n  return item;                                                // binding item(1) = 1\n}\n```\nSum: 6+8+11+6+8+11+1 = 51\n\n`processClaim` (after):\n```typescript\nfunction processClaim(policy: Policy, incident: Incident): ClaimResult {\n  const pool = [...policy.items];                              // 10\n  let uncappedPayout = 0;                                       // 8\n  for (const damage of incide