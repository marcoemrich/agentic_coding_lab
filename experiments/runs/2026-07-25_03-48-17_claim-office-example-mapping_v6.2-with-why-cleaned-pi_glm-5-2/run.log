  customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"staff\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 93 }] });\n  });\n  it.todo(\"quote: single potion -> premium 49\");\n  it.todo(\"quote: 2 runes -> premium 60\");\n  it.todo(\"quote: 3 runes (block applies) -> premium 71\");\n  it.todo(\"quote: 4 runes (no block) -> premium 115\");\n  it.todo(\"quote: 7 runes -> premium 198 (ceil 197.5)\");\n  it.todo(\"quote: 2 runes + 1 moonstone (no block) -> premium 88 (ceil 87.5)\");\n  it.todo(\"quote: 3 runes + 3 moonstones (two blocks) -> premium 137\");\n  it.todo(\"quote: cursed sword newcomer -> premium 165\");\n  it.todo(\"quote: high-enchanted sword enchant 5 -> premium 145\");\n  it.todo(\"quote: sword enchant 4 (no high enchant) -> premium 115\");\n  it.todo(\"quote: cursed sword enchant 5 (both surcharges) -> premium 195\");\n  it.todo(\"quote: loyalty at exactly 2 years -> premium 95\");\n  it.todo(\"quote: follow-up contract (2nd quote) sword -> 1st 115, 2nd 100\");\n  it.todo(\"quote: cursed sword + plain amulet scope -> premium 231\");\n  it.todo(\"quote: long-standing 2nd contract cursed enchant 7 -> 1st 95, 2nd 160\");\n  it.todo(\"claim: standard sword enchant 3 damage 500 -> payout 400, cap 1600\");\n  it.todo(\"claim: rune damage 200 -> payout 100, cap 400\");\n  it.todo(\"claim: dragon sword enchant 8 damage 1000 -> payout 400, cap 1600\");\n  it.todo(\"claim: dragon sword enchant 9 damage 1000 -> payout 400\");\n  it.todo(\"claim: dragon sword enchant 5 damage 800 -> payout 700\");\n  it.todo(\"claim: steel sword enchant 9 damage 1000 -> payout 400\");\n  it.todo(\"claim: deductible per event sword+amulet 500+300 -> payout 600, cap 2600\");\n  it.todo(\"claim: two swords both damaged 500+300 -> payout 600, cap 3400\");\n  it.todo(\"claim: cap exhaustion two claims of 1500 -> 1400 then 600, caps 600 then 0\");\n  it.todo(\"claim: cursed sword huge damage -> payout 2000 (cap unmodified), cap 0\");\