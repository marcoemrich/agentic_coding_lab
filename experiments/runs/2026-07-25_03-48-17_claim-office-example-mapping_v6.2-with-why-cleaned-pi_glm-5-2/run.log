et([\"rune\", \"moonstone\"]);\nconst COMPONENT_BASE = 25;\nconst BLOCK_SIZE = 3;\nconst BLOCK_PREMIUM = 60;\n\nconst isComponent = (type: string): boolean => COMPONENT_TYPES.has(type);\n\n/** Summed base premium of all quoted items, applying the 3-alike-component block. */\nfunction policyBasePremium(items: Item[]): number {\n  let total = 0;\n  const componentCounts: Record<string, number> = {};\n  for (const item of items) {\n    if (isComponent(item.type)) {\n      componentCounts[item.type] = (componentCounts[item.type] ?? 0) + 1;\n    } else {\n      total += itemBaseValue(item);\n    }\n  }\n  for (const count of Object.values(componentCounts)) {\n    total += count === BLOCK_SIZE ? BLOCK_PREMIUM : count * COMPONENT_BASE;\n  }\n  return total;\n}\n\n/** Per-item base value: a single item's premium, before block discounts. */\nfunction itemBaseValue(item: Item): number {\n  return isComponent(item.type) ? COMPONENT_BASE : BASE_PREMIUM[item.type] ?? 0;\n}\n\n/** Item-specific risk surcharges (cursed, high enchantment). Applied to the affected item's base premium. */\nfunction itemSurcharges(item: Item): number {\n  let surcharge = 0;\n  if (item.cursed) surcharge += CURSE_RATE * itemBaseValue(item);\n  if ((item.enchantment ?? 0) >= HIGH_ENCHANT_THRESHOLD) surcharge += HIGH_ENCHANT_RATE * itemBaseValue(item);\n  return surcharge;\n}\n\n/** Input shape for `runScenario`: a list of steps, each optionally carrying typed items. */\ntype Scenario = { steps: Array<{ op: string; items?: Item[] }> };\n\nexport function runScenario(input: unknown): { results: StepResult[] } {\n  const scenario = input as Scenario;\n  const step = scenario.steps[0];\n  const items = step.items ?? [];\n  const policyBase = policyBasePremium(items);\n  const surcharges = items.reduce((sum, it) => sum + itemSurcharges(it), 0);\n  const firstInsurance = policyBase * FIRST_INSURANCE_RATE;\n  const premium = roundUp(policyBase + surcharges + firstInsurance + PROCESSING_FEE);\n  return { results: [{ premium }] };\n}\n```\n\nLet me go through the refactoring process.\n\n### Step 1: Naming Evaluation\n\nLet me evaluate each function name:\n\n1. `roundUp` - It does `Math.ceil(amount - EPSILON)`. This rounds up, absorbing floating-point noise. Name fits.\n\n2. `policyBasePremium` - Sums the base premium of all quoted items applying the block discount. Name fits well.\n\n3. `itemBaseValue` - \"Per-item base value: a single item's premium, before block discounts.\" Returns `isComponent ? COMPONENT_BASE : BASE_PREMIUM[type] ?? 0`. Name fits.\n\n4. `itemSurcharges` - \"Item-specific risk surcharges (cursed, high enchantment).\" Name fits well.\n\n5. `isComponent` - Checks if a type is a component (rune, moonstone). Name fits.\n\n6. `runScenario` - Main entry point. Name fits.\n\nNaming looks good. Let me look at potential improvements.\n\n### Step 2: APP Mass Calculation\n\nLet me calculate the mass of the current code.\n\nActually, let me focus on what's most useful to refactor. Looking at the code:\n\nIn `itemSurcharges`:\n```typescript\nfunction itemSurcharges(item: Item): number {\n  let surcharge = 0;\n  if (item.cursed) surcharge += CURSE_RATE * itemBaseValue(item);\n  if ((item.enchantment ?? 0) >= HIGH_ENCHANT_THRESHOLD) surcharge += HIGH_ENCHANT_RATE * itemBaseValue(item);\n  return surcharge;\n}\n```\n\nThis calls `itemBaseValue(item)` potentially twice. There's conceptual duplication here - the base value is computed multiple times. We could compute it once.\n\nActually wait, let me think about this more carefully. The duplication of `itemBaseValue(item)` calls is a minor DRY concern. Let me compute the base value once:\n\n```typescript\nfunction itemSurcharges(item: Item): number {\n  const base = itemBaseValue(item);\n  let surcharge = 0;\n  if (item.cursed) surcharge += CURSE_RATE * base;\n  if ((item.enchantment ?? 0) >= HIGH_ENCHANT_THRESHOLD) surcharge += HIGH_ENCHANT_RATE * base;\n  return surcharge;\n}\n```\n\nThis is a clear improvement - it r