arsWithMHPCO >= 1 is considered to be on a follow-up contract\n  if (input.customer.yearsWithMHPCO >= 1) {\n    finalPremium = finalPremium * (1 - FOLLOW_UP_CONTRACT_DISCOUNT_PERCENT);\n  }","newText":"  // Store original policy base premium before modifiers\n  const basePremiumSum = policyBasePremium;\n  \n  // Apply policy-wide modifiers as percentages of the original base premium\n  let discountAmount = 0;\n  let surchargeAmount = 0;\n\n  // Apply 20% loyalty discount for customers with 2 or more years\n  if (input.customer.yearsWithMHPCO >= LOYALTY_THRESHOLD) {\n    discountAmount += basePremiumSum * LOYALTY_DISCOUNT_PERCENT;\n  }\n\n  // Apply 15% discount for follow-up contracts\n  // This applies to each contract after the first, regardless of customer history\n  // Note: A customer with yearsWithMHPCO >= 1 is considered to be on a follow-up contract\n  if (input.customer.yearsWithMHPCO >= 1) {\n    discountAmount += basePremiumSum * FOLLOW_UP_CONTRACT_DISCOUNT_PERCENT;\n  }\n\n  // Apply 10% initial assessment surcharge for first insurance\n  // Note: Each item in a quote is treated as a first insurance, regardless of customer history\n  surchargeAmount += basePremiumSum * FIRST_INSURANCE_SURCHARGE_PERCENT;\n\n  // Calculate final premium\n  let finalPremium = basePremiumSum - discountAmount + surchargeAmount + PROCESSING_FEE;"}]}}],"api":"openai-completions","provider":"requesty","model":"nebius/qwen/qwen3-235b-a22b-instruct-2507","usage":{"input":970,"output":887,"cacheRead":105056,"cacheWrite":0,"reasoning":0,"totalTokens":106913,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784975552465,"responseId":"rqsty-cmpl-dff96d99-0bb1-49d9-bca8-69916a974650","responseModel":"Qwen/Qwen3-235B-A22B-Instruct-2507"},{"role":"toolResult","toolCallId":"chatcmpl-tool-93f07c92dfe00c53","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 1 block(s) in src/claim-office.ts."}],"details":{"diff":