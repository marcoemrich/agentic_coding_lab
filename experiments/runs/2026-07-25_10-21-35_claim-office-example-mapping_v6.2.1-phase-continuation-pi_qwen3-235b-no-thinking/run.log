tion -- (potion: 400 G / 40 G)\", () => {\n    expect(calculateQuote({ \n      customer: { yearsWithMHPCO: 0 }, \n      items: [{ type: \"potion\" }] \n    })).toBe(45); // Base premium 40 G + 5 G fee = 45 G total premium\n  });\n  it(\"should return base premium 25 G for a single component (rune or moonstone) -- (component: 250 G / 25 G)\", () => {\n    expect(calculateQuote({ \n      customer: { yearsWithMHPCO: 0 }, \n      items: [{ type: \"rune\" }] \n    })).toBe(30); // Base premium 25 G + 5 G fee = 30 G total premium\n  });\n\n  it(\"should return 50 G base premium for 2 runes -- (2 runes: 2 × 25 G = 50 G)\", () => {\n    expect(calculateQuote({ \n      customer: { yearsWithMHPCO: 0 }, \n      items: [{ type: \"rune\" }, { type: \"rune\" }] \n    })).toBe(55); // 2 runes × 25 G = 50 G base + 5 G fee = 55 G total premium\n  });\n  it(\"should return 60 G base premium for 3 runes as a building block -- (3 runes: block premium 60 G)\", () => {\n    expect(calculateQuote({ \n      customer: { yearsWithMHPCO: 0 }, \n      items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }] \n    })).toBe(65); // 3 runes as building block: 60 G base + 5 G fee = 65 G total premium\n  });\n  it(\"should return 100 G base premium for 4 runes -- (4 runes: 4 × 25 G = 100 G, no block)\", () => {\n    expect(calculateQuote({ \n      customer: { yearsWithMHPCO: 0 }, \n      items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }] \n    })).toBe(105); // 4 runes: 4 × 25 G = 100 G base + 5 G fee = 105 G total premium (no block applies)\n  });\n  it(\"should return 50 G base premium for 2 runes and 1 moonstone (no block across types) -- (different component types: no block)\", () => {\n    expect(calculateQuote({ \n      customer: { yearsWithMHPCO: 0 }, \n      items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"moonstone\" }] \n    })).toBe(80); // 2 runes (50 G) + 1 moonstone (25 G) = 75 G base + 5 G fee = 80 G total premium (no block applies across types)\n  });\n  it.todo(\"should return 120 G base premium for 3 runes and 3 moonstones (two separate blocks) -- (3 runes + 3 moonstones = 60 G + 60 G)\");\n\n  it.todo(\"should add 50% surcharge for a cursed sword, increasing base premium to 150 G -- (cursed sword: 100 G + 50 G surcharge)\");\n  it.todo(\"should add 30% surcharge for a highly enchanted sword (enchantment ≥ 5), increasing base premium to 130 G -- (high enchantment: 100 G + 30 G)\");\n  it.todo(\"should add 50% surcharge only to the cursed sword in a multi-item policy with a plain amulet -- (cursed surcharge applies to item, not policy: 100 G + 50 G + 60 G = 210 G base + surcharges)\");\n\n  it.todo(\"should apply 20% loyalty discount to a long-standing customer (≥ 2 years) on policy base premium -- (loyalty: 20% off base sum)\");\n  it.todo(\"should apply 10% initial assessment surcharge on first insurance -- (first insurance: 10% surcharge)\");\n  it.todo(\"should apply 15% discount on each contract after the first -- (follow-up contract: 15% discount)\");\n  it.todo(\"should apply first insurance surcharge even for a long-standing customer's new sword -- (each item treated as first insurance)\");\n\n  it.todo(\"should add a 5 G processing fee to every premium -- (5 G fee added at the end)\");\n  it.todo(\"should round final premium up to whole G in MHPCO's favor -- (197.5 G → 198 G)\");\n  it.todo(\"should calculate premium as 165 G for a newcomer with a cursed sword -- (100 + 50 + 10 + 5 = 165 G)\");\n  it.todo(\"should calculate premium as 160 G for a long-standing customer's second contract with a cursed, highly enchanted sword -- (100 + 50 + 30 − 20 + 10 − 15 = 155 G + 5 G = 160 G)\");\n\n  it.todo(\"should return 400 G payout for damage 500 G to a regular sword (enchantment 3) after 100 G deductible -- (standard reimbursement)\");\n  it.todo(\"should return 100 G payout for damage 200 G to a rune after 100 G deductible -- (100 G cap applies)\");\n\n  it.todo(\"should apply 50% re