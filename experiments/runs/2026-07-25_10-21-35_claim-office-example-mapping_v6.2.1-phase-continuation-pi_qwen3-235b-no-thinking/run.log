onst basePremiumSum = policyBasePremium; // B:1, A:6\n  \n  let finalPremium = basePremiumSum; // B:1, A:6\n  \n  if (input.customer.yearsWithMHPCO >= LOYALTY_THRESHOLD) { // C:4\n    finalPremium -= basePremiumSum * LOYALTY_DISCOUNT_PERCENT; // I:1, A:6\n  }\n  \n  if (input.customer.yearsWithMHPCO >= 1) { // C:4\n    finalPremium -= basePremiumSum * FOLLOW_UP_CONTRACT_DISCOUNT_PERCENT; // I:1, A:6\n  }\n  \n  finalPremium += basePremiumSum * FIRST_INSURANCE_SURCHARGE_PERCENT; // I:1, A:6\n  \n  finalPremium += PROCESSING_FEE; // I:1, A:6\n  \n  finalPremium = Math.round(finalPremium * 100) / 100; // I:2, A:6\n  \n  return Math.ceil(finalPremium); // I:1\n}\n\nfunction getBaseItemPremium(itemType: string): number { // B:1\n  switch (itemType) { // C:4\n    case \"sword\": return 100; // C:1\n    case \"amulet\": return 60; // C:1\n    case \"staff\": return 80; // C:1\n    case \"potion\": return 40; // C:1\n    case \"rune\": case \"moonstone\": return 25; // C:2\n    default: throw new Error(`Unknown item type: ${itemType}`); // C:4, I:1\n  }\n}\n\nfunction addCursedSurcharge(premium: number): number { // B:1\n  return premium * 1.5; // C:1, I:1\n}\n\nfunction addHighEnchantmentSurcharge(premium: number): number { // B:1\n  return premium * 1.3; // C:1, I:1\n}\n\nfunction getItemPremium(item: { type: string, cursed?: boolean, enchantment?: number }): number { // B:1\n  let premium = getBaseItemPremium(item.type); // B:1, I:1, A:6\n  if (item.cursed) { // C:4\n    premium = addCursedSurcharge(premium); // I:1, A:6\n  }\n  if (item.enchantment !== undefined && item.enchantment >= 5) { // C:4, I:1\n    premium = addHighEnchantmentSurcharge(premium); // I:1, A:6\n  }\n  return premium; // I:1\n}\n\nfunction hasExactlyThreeOfAKind(items: { type: string }[], itemType: string): boolean { // B:2\n  return items.filter(item => item.type === itemType).length === 3; // I:2, C:1\n}\n```\n\nComponent Count:\n- Constants: ~25 (including literals and constants)\n- Bindings: ~25