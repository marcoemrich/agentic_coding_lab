late base premium by summing individual item values\n  const basePremium = input.items.reduce((sum, item) => {\n    return sum + getItemPremium(item);\n  }, 0);\n\n  return basePremium + PROCESSING_FEE;\n};\n\nfunction getBaseItemPremium(itemType: string): number {\n  switch (itemType) {\n    case \"sword\":\n      return 100;\n    case \"amulet\":\n      return 60;\n    case \"staff\":\n      return 80;\n    case \"potion\":\n      return 40;\n    case \"rune\":\n    case \"moonstone\":\n      return 25;\n    default:\n      throw new Error(`Unknown item type: ${itemType}`);\n  }\n}\n\nfunction addCursedSurcharge(premium: number): number {\n  return Math.ceil(premium * 1.5); // 50% surcharge\n}\n\nfunction addHighEnchantmentSurcharge(premium: number): number {\n  return Math.ceil(premium * 1.3); // 30% surcharge\n}\n\nfunction getItemPremium(item: { type: string, cursed?: boolean, enchantment?: number }): number {\n  let premium = getBaseItemPremium(item.type);\n  \n  if (item.cursed) {\n    premium = addCursedSurcharge(premium);\n  }\n  \n  if (item.enchantment !== undefined && item.enchantment >= 5) {\n    premium = addHighEnchantmentSurcharge(premium);\n  }\n  \n  return premium;\n}\n\nfunction hasExactlyThreeOfAKind(items: { type: string }[], itemType: string): boolean {\n  return items.filter(item => item.type === itemType).length === 3;\n}\n"}],"isError":false,"timestamp":1784975212311},{"role":"assistant","content":[{"type":"toolCall","id":"chatcmpl-tool-a961063344bd851b","name":"edit","arguments":{"path":"src/claim-office.ts","edits":[{"oldText":"export const calculateQuote = (input: { customer: { yearsWithMHPCO: number }, items: { type: string, cursed?: boolean, enchantment?: number }[] }): number => {","newText":"export const calculateQuote = (input: { customer: { yearsWithMHPCO: number }, items: { type: string, cursed?: boolean, enchantment?: number }[] }): number => {\n  const LOYALTY_THRESHOLD = 2;\n  const LOYALTY_DISCOUNT_PERCENT = 0.2;"}]}}],"api":"