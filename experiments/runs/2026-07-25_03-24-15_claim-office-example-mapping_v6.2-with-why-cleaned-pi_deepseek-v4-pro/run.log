eCounts[item.type] ?? 0) + 1;\n      // Constants: 2. Assignments: 1. Invocations: 4 ([], [], ??, +).  Mass: 12\n    }\n  }\n\n  let blockDiscount = 0;\n  // Constants: 1. Bindings: 1.  Mass: 2\n\n  for (const ct of COMPONENT_TYPES) {\n  // Loops: 1. Bindings: 1.  Mass: 6\n\n    const count = typeCounts[ct] ?? 0;\n    // Constants: 1. Bindings: 1. Invocations: 2 ([], ??).  Mass: 6\n\n    if (count % 3 === 0) {\n    // Conditionals: 1. Invocations: 1 (%). Constants: 1.  Mass: 7\n\n      blockDiscount += count * 5;\n      // Constants: 1. Assignments: 1. Invocations: 2 (*, +=).  Mass: 9\n    }\n  }\n\n  return basePremium + itemSurcharges - blockDiscount + PROCESSING_FEE;\n  // Invocations: 3 (+, -, +).  Mass: 6 (no bindings - these are references, counted as invocations)\n}\n```\n\n**Post-refactor totals (function body only, plus module-level shared with function)**:\n\nActually, let me compute just the function body for a fair before/after comparison, since module-level constants existed before too.\n\n**Before (function `quote` body only)**:\n- Constants: 2 (\"rune\", \"moonstone\" in Set) + 1 (0 in basePremium) + 1 (0 in itemSurcharges) + 1 (0 in ?? itemBase) + 1 (0.5) + 2 (0, 1 in typeCounts) + 1 (0 in blockDiscount) + 2 (0, 3 in count check) + 1 (0 in count > 0) + 1 (5 in blockDiscount) = **13**\n- Bindings: 1 (componentTypes) + 1 (typeCounts) + 1 (basePremium) + 1 (itemSurcharges) + 1 (item loop) + 1 (itemBase) + 1 (blockDiscount) + 1 (ct loop) + 1 (count) + 2 (items, _customerContext params) = **11**\n- Invocations: 1 (new Set) + 2 ([], ?? in itemBase) + 1 (+= basePremium) + 2 (*, += cursed) + 1 (.has) + 4 ([], []., ??, + in typeCounts) + 2 ([], ?? in count) + 2 (%, >) + 2 (*, += blockDiscount) + 3 (+, -, + in return) = **20**\n- Conditionals: 1 (cursed) + 1 (has) + 1 (count check) = **3**\n- Loops: 1 (items) + 1 (componentTypes) = **2**\n- Assignments: 1 (+= basePremium) + 1 (+= cursed) + 1 (= typeCounts) + 1 (+= blockDiscount) = **4**\n\n**After (function `q