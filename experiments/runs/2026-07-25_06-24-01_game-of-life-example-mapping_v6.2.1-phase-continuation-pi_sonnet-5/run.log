   }\n  }\n  return keys;\n}\n\nfunction survives(liveNeighborCount: number): boolean {\n  return liveNeighborCount === 2 || liveNeighborCount === 3;\n}\n\nfunction reproduces(liveNeighborCount: number): boolean {\n  return liveNeighborCount === 3;\n}\n\nexport function nextGeneration(cells: Cell[]): Cell[] {\n  const live = new Set(cells.map(([x, y]) => key(x, y)));\n  const candidates = new Set<string>();\n\n  for (const [x, y] of cells) {\n    candidates.add(key(x, y));\n    for (const neighborKey of neighborKeys(x, y)) {\n      candidates.add(neighborKey);\n    }\n  }\n\n  const result: Cell[] = [];\n\n  for (const candidateKey of candidates) {\n    const [x, y] = candidateKey.split(\",\").map(Number);\n    const neighbors = countLiveNeighbors(live, x, y);\n    const isAlive = live.has(candidateKey);\n\n    if (isAlive ? survives(neighbors) : reproduces(neighbors)) {\n      result.push([x, y]);\n    }\n  }\n\n  return result;\n}\n"}],"isError":false,"timestamp":1784961159025},{"role":"toolResult","toolCallId":"toolu_vrtx_012MytGGK4qBFr4bKWeT1Xag","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { nextGeneration } from \"./game-of-life.js\";\n\ndescribe(\"Game of Life - Next Generation\", () => {\n  it(\"should return an empty array when given an empty grid\", () => {\n    expect(nextGeneration([])).toEqual([]);\n  });\n\n  it(\"Rule 1 - Underpopulation: a live cell with fewer than 2 live neighbors dies -- [(0,1),(1,1)] -> []\", () => {\n    expect(nextGeneration([[0, 1], [1, 1]])).toEqual([]);\n  });\n\n  it(\"Rule 2 - Survival: a live cell with 2 or 3 live neighbors lives on -- center (1,1) with neighbors (0,0) and (0,2) survives into Gen 1\", () => {\n    const result = nextGeneration([\n      [0, 0],\n      [0, 2],\n      [1, 1],\n    ]);\n    expect(result).toContainEqual([1, 1]);\n  });\n\n  it(\"Rule 3 - Overpopulation: a live cell with more than 3 live neighbors dies -- center (1,1) surrounded by