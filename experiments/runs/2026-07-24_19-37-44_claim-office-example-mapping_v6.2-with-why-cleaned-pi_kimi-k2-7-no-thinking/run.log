\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 30 }] });\n  });\n  it(\"should quote a single moonstone at 30 G -- 25 G base + 5 G fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"moonstone\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 30 }] });\n  });\n\n  // Component blocks\n  it(\"should quote 2 runes at 55 G -- 50 G base + 5 G fee (no block)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 55 }] });\n  });\n  it(\"should quote 3 runes at 65 G -- 60 G block base + 5 G fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 65 }] });\n  });\n  it.todo(\"should quote 4 runes at 105 G -- 100 G base + 5 G fee (block requires exactly 3)\");\n  it.todo(\"should quote 7 runes at 180 G -- 175 G base + 5 G fee\");\n  it.todo(\"should quote 2 runes + 1 moonstone at 80 G -- 75 G base + 5 G fee (different types)\");\n  it.todo(\"should quote 3 runes + 3 moonstones at 125 G -- 120 G base + 5 G fee (two separate blocks)\");\n\n  // Item modifiers\n  it.todo(\"should apply a 50% cursed surcharge to a cursed sword -- premium 165 G\");\n  it.todo(\"should apply a 30% high-enchantment surcharge for enchantment >= 5 -- premium 145 G\");\n  it.todo(\"should not apply high-enchantment surcharge for enchantment 4 -- premium 115 G\");\n  it.todo(\"should apply both cursed and high-enchantment surcharges when both apply\");\n\n  // Customer and contract modifiers\n  it.todo(\"should apply a 20% loyalty discount for customers with >= 2 years\");\n  it.todo(\"should apply a 10% first-insurance surcharge\");\n  it.todo(\"should apply a 15% follow-up contract discount after the first contract\");\n\n  // Integration examples\n  it.todo(\"should quote a newcomer with a cursed sword at 165 G\");\n  it.todo(\"should quote a long-standing customer's second contract with a cursed highly-enchanted sword at 160 G\");\n\n  // Multi-item policies\n  it.todo(\"should apply item-specific cursed surcharge only to the cursed item -- cursed sword + plain amulet = 215 G\");\n\n  // Claims\n  it.todo(\"should pay out 400 G for regular sword damage 500 G after 100 G deductible\");\n  it.todo(\"should pay out 100 G for rune damage 200 G after 100 G deductible\");\n  it.todo(\"should fully reimburse a dragon-material sword -- 700 G for damage 800 G after 100 G deductible\");\n  it.todo(\"should reimburse 50% for an item with enchantment >= 8 -- 400 G for damage 1000 G after 100 G deductible\");\n  it.todo(\"should apply the 50% enchantment rule when both dragon material and enchantment >= 8 apply -- 400 G\");\n  it.todo(\"should apply the 100 G deductible per damaged item -- 600 G for sword 500 G + amulet 300 G\");\n\n  // Caps and multiple items\n  it.todo(\"should compute insurance sum 2000 G and cap 4000 G for two swords\");\n  it.todo(\"should treat each damage entry as a separate damage with its own deductible\");\n  it.todo(\"should reduce payout to remaining cap when cap is exhausted -- first 1400 G, then 600 G\");\n\n  // Error cases\n  it.todo(\"should reject a claim with more damage entries than insured items\");\n  it.todo(\"should exit non-zero for an unknown item type in a quote\");\n  it.todo(\"should exit non-zero for an unknown item type in a claim\");\n  it.todo(\"should exit non-zero for a negative damage amount\");\n\n  // Rounding\n  it.todo(\"should round a premium up in MHPCO favor -- 197.5 G becomes 198 G\");\n  it.todo(\"should round a p