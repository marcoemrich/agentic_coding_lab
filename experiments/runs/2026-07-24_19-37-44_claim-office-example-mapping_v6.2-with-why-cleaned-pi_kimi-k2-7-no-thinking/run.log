r;\n}\n\ninterface Item {\n  type: string;\n  cursed?: boolean;\n  enchantment?: number;\n  material?: string;\n}\n\ninterface Damage {\n  itemType: string;\n  amount: number;\n}\n\ninterface Incident {\n  cause: string;\n  damages: Damage[];\n}\n\ninterface ScenarioStep {\n  op: string;\n  items?: Item[];\n  policy?: number;\n  incident?: Incident;\n}\n\ninterface Scenario {\n  customer: Customer;\n  steps: ScenarioStep[];\n}\n\nconst basePremiumForType = (type: string): number =>\n  BASE_PREMIUMS[type] ?? DEFAULT_BASE_PREMIUM;\n\nconst COMPONENT_BLOCK_TYPES = new Set([\"rune\", \"moonstone\"]);\nconst BLOCK_SIZE = 3;\nconst BLOCK_BASE_PREMIUM = 60;\n\nconst basePremiumForItemGroup = (type: string, count: number): number => {\n  if (COMPONENT_BLOCK_TYPES.has(type) && count === BLOCK_SIZE) {\n    return BLOCK_BASE_PREMIUM;\n  }\n  return count * basePremiumForType(type);\n};\n\nconst CURSED_SURCHARGE_RATE = 0.5;\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\nconst FIRST_INSURANCE_SURCHARGE_RATE = 0.1;\nconst FOLLOW_UP_CONTRACT_DISCOUNT_RATE = 0.15;\nconst LOYALTY_DISCOUNT_RATE = 0.2;\n\nconst itemPremiumMultiplier = (item: Item): number =>\n  1 +\n  (item.cursed ? CURSED_SURCHARGE_RATE : 0) +\n  ((item.enchantment ?? 0) >= 5 ? HIGH_ENCHANTMENT_SURCHARGE_RATE : 0);\n\n// Tiny epsilon avoids floating-point artifacts (e.g. 197.5000000001) from pushing\n// a value that should round to N up to N+1.\nconst ROUNDING_EPSILON = 0.0001;\nconst roundUp = (value: number): number => Math.ceil(value - ROUNDING_EPSILON);\n\nconst countItemsByType = (items: Item[]): Record<string, number> => {\n  const counts: Record<string, number> = {};\n  for (const item of items) {\n    counts[item.type] = (counts[item.type] ?? 0) + 1;\n  }\n  return counts;\n};\n\nconst INSURANCE_VALUES: Record<string, number> = {\n  sword: 1000,\n  amulet: 600,\n  staff: 800,\n  potion: 400,\n  rune: 250,\n  moonstone: 250,\n};\nconst DEFAULT_INSURANCE_VALUE = 0;\n\nconst insuranceValueForType = (type: string): number =>\n  INSURANCE_VALUES[type] ?? DEFAULT_INSURANCE_VALUE;\n\nconst totalInsuranceValueFor = (items: Item[]): number =>\n  items.reduce((sum, item) => sum + insuranceValueForType(item.type), 0);\n\nconst totalBasePremiumFor = (itemTypeCounts: Record<string, number>): number =>\n  Object.entries(itemTypeCounts).reduce(\n    (sum, [type, count]) => sum + basePremiumForItemGroup(type, count),\n    0\n  );\n\nconst totalModifiedItemPremiumFor = (\n  items: Item[],\n  itemTypeCounts: Record<string, number>\n): number =>\n  items.reduce((sum, item) => {\n    const groupBase = basePremiumForItemGroup(item.type, itemTypeCounts[item.type]);\n    const share = groupBase / itemTypeCounts[item.type];\n    return sum + share * itemPremiumMultiplier(item);\n  }, 0);\n\nconst quoteModifiersFor = (\n  policyBase: number,\n  customer: Customer,\n  quoteIndex: number\n): number => {\n  const firstInsuranceSurcharge = policyBase * FIRST_INSURANCE_SURCHARGE_RATE;\n  const loyaltyDiscount =\n    customer.yearsWithMHPCO >= 2 ? policyBase * LOYALTY_DISCOUNT_RATE : 0;\n  const followUpDiscount =\n    quoteIndex > 0 ? policyBase * FOLLOW_UP_CONTRACT_DISCOUNT_RATE : 0;\n  return firstInsuranceSurcharge - loyaltyDiscount - followUpDiscount;\n};\n\nconst calculateQuotePremium = (\n  items: Item[],\n  customer: Customer,\n  quoteIndex: number\n): number => {\n  const itemTypeCounts = countItemsByType(items);\n  const policyBase = totalBasePremiumFor(itemTypeCounts);\n  const totalModifiedItemPremium = totalModifiedItemPremiumFor(items, itemTypeCounts);\n  const modifiers = quoteModifiersFor(policyBase, customer, quoteIndex);\n  return roundUp(totalModifiedItemPremium + modifiers + PROCESSING_FEE);\n};\n\nconst DEDUCTIBLE = 100;\nconst POLICY_CAP_MULTIPLIER = 2;\n\ntype Policy = { items: Item[]; cap: number };\ntype StepResult = { premium?: number; payout?: number; remainingCap?: number };\n\nconst enchantmentClaimMultiplier = (damage: Damage, policyItems: Item[]): number => {\n  const item = policyItems.find((i) => i.type === damage.itemType);\n  return (item?.enchantment ?? 0) >= 8 ? 0.5 : 1;\n};\n\nconst calculateClaimResult = (\n  policyCap: number,\n  step: ScenarioStep,\n  policyItems: Item[]\n): { payout: number; remainingCap: number } => {\n  let remainingCap = policyCap;\n  let totalPayout = 0;\n  for (const damage of step.incident?.damages ?? []) {\n    const multiplier = enchantmentClaimMultiplier(damage, policyItems);\n    const reimbursable = damage.amount * multiplier;\n    const cappedReimbursable = Math.min(reimbursable, remainingCap);\n    const payout = Math.max(0, cappedReimbursable - DEDUCTIBLE);\n    totalPayout += payout;\n    remainingCap -= payout;\n  }\n  return { payout: totalPayout, remainingCap };\n};\n\nexport const processScenario = (scenario: Scenario): { results: StepResult[] } => {\n  const policies: Policy[] = [];\n  const results: StepResult[] = [];\n  for (const step of scenario.steps) {\n    if (step.op === \"quote\") {\n      const quoteItems = step.items ?? [];\n      results.push({\n        premium: calculateQuotePremium(quoteItems, scenario.customer, results.length),\n      });\n      policies.push({ items: quoteItems, cap: totalInsuranceValueFor(quoteItems) * POLICY_CAP_MULTIPLIER });\n    } else if (step.op === \"claim\") {\n      const policy = policies[step.policy ?? 0];\n      const claimResult = calculateClaimResult(policy.cap, step, policy.items);\n      policy.cap = claimResult.remainingCap;\n      results.push(claimResult);\n    }\n  }\n  return { results };\n};\n"}],"isError":false,"timestamp":1784924538999},{"role":"assistant","content":[{"type":"thinking","thinking":"Tests.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"functions.bash:176","name":"bash","arguments":{"command":"pnpm test 2>&1 | head -30","timeout":60}}],"api":"openai-completions","provider":"requesty","model":"tensorx/kimi-k2.7-code","usage":{"input":1533,"output":35,"cacheRead":104256,"cacheWrite":0,"reasoning