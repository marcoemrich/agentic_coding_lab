stomer: Customer;\n  steps: ScenarioStep[];\n}\n\nconst basePremiumForType = (type: string): number =>\n  BASE_PREMIUMS[type] ?? DEFAULT_BASE_PREMIUM;\n\nconst COMPONENT_BLOCK_TYPES = new Set([\"rune\", \"moonstone\"]);\nconst BLOCK_SIZE = 3;\nconst BLOCK_BASE_PREMIUM = 60;\n\nconst basePremiumForItemGroup = (type: string, count: number): number => {\n  if (COMPONENT_BLOCK_TYPES.has(type) && count === BLOCK_SIZE) {\n    return BLOCK_BASE_PREMIUM;\n  }\n  return count * basePremiumForType(type);\n};\n\nconst sumBasePremiums = (items: Item[]): number => {\n  const itemTypeCounts: Record<string, number> = {};\n  for (const item of items) {\n    itemTypeCounts[item.type] = (itemTypeCounts[item.type] ?? 0) + 1;\n  }\n  let total = 0;\n  for (const [type, count] of Object.entries(itemTypeCounts)) {\n    total += basePremiumForItemGroup(type, count);\n  }\n  return total;\n};\n\nexport const processScenario = (\n  scenario: Scenario\n): { results: Array<{ premium: number }> } => {\n  const itemsToQuote = scenario.steps[0]?.items ?? [];\n  return {\n    results: [{ premium: sumBasePremiums(itemsToQuote) + PROCESSING_FEE }],\n  };\n};\n"}],"isError":false,"timestamp":1784923523159},{"role":"assistant","content":[{"type":"thinking","thinking":"Tests.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"functions.bash:84","name":"bash","arguments":{"command":"pnpm test 2>&1 | head -30","timeout":60}}],"api":"openai-completions","provider":"requesty","model":"tensorx/kimi-k2.7-code","usage":{"input":438,"output":35,"cacheRead":50752,"cacheWrite":0,"reasoning":3,"totalTokens":51225,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784923523161,"responseId":"rqsty-cmpl-077144ee-ceac-4852-b120-3e321ee62341","responseModel":"moonshotai/kimi-k2.7-code"},{"role":"toolResult","toolCallId":"functions.bash:84","toolName":"bash","content":[{"type":"text","text":"\n> tdd-experiment-run@ test /home/experimenter/experimen