tracted from every damage payout (in G).\n */\nconst DAMAGE_DEDUCTIBLE = 100;\n\n/**\n * Insurance values (in G) per item type. Per spec:\n *   sword=1000, amulet=600, staff=800, potion=400;\n *   components (rune/moonstone)=250 each.\n */\nconst INSURANCE_VALUES: Record<string, number> = {\n  sword: 1000,\n  amulet: 600,\n  staff: 800,\n  potion: 400,\n  rune: 250,\n  moonstone: 250,\n};\n\nexport type PolicyItem = {\n  type: string;\n  material?: string;\n  enchantment?: number;\n  cursed?: boolean;\n};\n\nexport type Policy = {\n  items: PolicyItem[];\n  insuranceSum: number;\n  cap: number;\n  remainingCap: number;\n};\n\nexport type Damage = { itemType: string; amount: number };\n\nexport type Incident = { cause: string; damages: Damage[] };\n\nexport function createPolicy(items: PolicyItem[]): Policy {\n  const insuranceSum = items.reduce((sum, item) => sum + INSURANCE_VALUES[item.type], 0);\n  const cap = insuranceSum * 2;\n  return { items, insuranceSum, cap, remainingCap: cap };\n}\n\nexport function processClaim(\n  policy: Policy,\n  incident: Incident,\n): { payout: number; remainingCap: number } {\n  let totalRaw = 0;\n  for (const damage of incident.damages) {\n    const item = policy.items.find((i) => i.type === damage.itemType);\n    const isHighEnchant = (item?.enchantment ?? 0) >= 8;\n    const gross = isHighEnchant ? damage.amount * 0.5 : damage.amount;\n    totalRaw += gross - DAMAGE_DEDUCTIBLE;\n  }\n  const payout = Math.min(Math.floor(totalRaw), policy.remainingCap);\n  return { payout, remainingCap: policy.remainingCap - payout };\n}\n"}],"isError":false,"timestamp":1784955591972},{"role":"assistant","content":[{"type":"thinking","thinking":"Wait - the refactor removed the dragon material logic! I need to think about this. Looking at the test cases:\n- Test 17: dragon material sword enchantment 5, damage 800 → payout 700 (full reimbursement)\n\nCurrently, `isHighEnchant` is false (enchantment 5 < 8), so `gross = damage.amount = 800`. After de