shotai/kimi-k2.7-code"},{"role":"toolResult","toolCallId":"functions.read:0","toolName":"read","content":[{"type":"text","text":"const PROCESSING_FEE = 5;\nconst COMPONENT_BLOCK_SIZE = 3;\nconst COMPONENT_BLOCK_PREMIUM = 60;\nconst CURSED_SURCHARGE_RATE = 0.5;\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\n\nconst BASE_PREMIUMS: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\ninterface Item {\n  type: string;\n  cursed?: boolean;\n  enchantment?: number;\n  material?: string;\n  damage?: number;\n}\n\ninterface QuoteStep {\n  op: string;\n  items: Item[];\n}\n\ninterface Scenario {\n  customer: { yearsWithMHPCO: number };\n  steps: QuoteStep[];\n}\n\ntype Quote = Array<{ premium: number }>;\n\nconst isComponent = (type: string): boolean => type === \"rune\" || type === \"moonstone\";\n\nconst basePremiumForItem = (type: string): number =>\n  BASE_PREMIUMS[type] ?? BASE_PREMIUMS.sword;\n\nconst basePremiumForGroup = (type: string, count: number): number =>\n  isComponent(type) && count === COMPONENT_BLOCK_SIZE\n    ? COMPONENT_BLOCK_PREMIUM\n    : count * basePremiumForItem(type);\n\nconst surchargeForItem = (item: Item): number => {\n  const base = basePremiumForItem(item.type);\n  let surcharge = 0;\n  if (item.cursed) {\n    surcharge += CURSED_SURCHARGE_RATE * base;\n  }\n  if (typeof item.enchantment === \"number\" && item.enchantment >= HIGH_ENCHANTMENT_THRESHOLD) {\n    surcharge += HIGH_ENCHANTMENT_SURCHARGE_RATE * base;\n  }\n  return surcharge;\n};\n\nconst LOYALTY_DISCOUNT_RATE = 0.2;\nconst LOYALTY_YEARS_THRESHOLD = 2;\n\nconst quoteForItems = (items: Item[], customerYears: number): Quote => {\n  const counts = new Map<string, number>();\n  items.forEach((item) => {\n    counts.set(item.type, (counts.get(item.type) ?? 0) + 1);\n  });\n\n  const baseTotal = Array.from(counts.entries()).reduce(\n    (total, [type, count]) => total + basePremiumForGroup(type, count),\n    0\n  );\n\n  const itemSurcharges = items.reduce(\n    (total, item) => total + surchargeForItem(item),\n    0\n  );\n\n  const loyaltyDiscount =\n    customerYears >= LOYALTY_YEARS_THRESHOLD\n      ? LOYALTY_DISCOUNT_RATE * baseTotal\n      : 0;\n\n  return [{ premium: baseTotal + itemSurcharges - loyaltyDiscount + PROCESSING_FEE }];\n};\n\nexport const processScenario = (scenario: Scenario): Quote =>\n  quoteForItems(scenario.steps[0].items, scenario.customer.yearsWithMHPCO);\n"}],"isError":false,"timestamp":1784944065849},{"role":"toolResult","toolCallId":"functions.read:1","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"MHPCO Claim Office\", () => {\n  // Basic quote premiums\n  it(\"should return only the processing fee for an empty item list -- premium 5 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    });\n    expect(result).toEqual([{ premium: 5 }]);\n  });\n  it(\"should quote a single sword -- premium 105 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"sword\", material: \"steel\", enchantment: 3, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 105 }]);\n  });\n  it(\"should quote a single amulet -- premium 65 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"amulet\", material: \"silver\", enchantment: 2, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 65 }]);\n  });\n  it(\"should quote a single staff -- premium 85 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"staff\", material: \"oak\", enchantment: 1, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 85 }]);\n  });\n  it(\"should quote a single potion -- premium 45 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"potion\", material: \"glass\", enchantment: 0, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 45 }]);\n  });\n  it(\"should quote a single rune -- premium 30 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 30 }]);\n  });\n  it(\"should quote a single moonstone -- premium 30 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"moonstone\" }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 30 }]);\n  });\n\n  // Component block rules\n  it(\"should quote 2 runes without block discount -- premium 55 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 55 }]);\n  });\n  it(\"should quote exactly 3 runes with block discount -- premium 65 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 65 }]);\n  });\n  it(\"should quote 4 runes without block discount -- premium 105 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 105 }]);\n  });\n  it(\"should quote 7 runes without block discount -- premium 180 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: Array.from({ length: 7 }, () => ({ type: \"rune\" })),\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 180 }]);\n  });\n  it(\"should not mix different component types for the block discount -- 2 runes + 1 moonstone premium 80 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"moonstone\" }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 80 }]);\n  });\n  it(\"should apply separate blocks for each component type -- 3 runes + 3 moonstones premium 125 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n          ],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 125 }]);\n  });\n\n  // Item-specific modifiers\n  it(\"should add cursed surcharge to a sword -- premium 155 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"sword\", material: \"steel\", enchantment: 3, cursed: true }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 155 }]);\n  });\n  it(\"should add high-enchantment surcharge at level 5 -- premium 135 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"sword\", material: \"steel\", enchantment: 5, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 135 }]);\n  });\n  it(\"should add both cursed and high-enchantment surcharges -- premium 185 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"sword\", material: \"steel\", enchantment: 5, cursed: true }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 185 }]);\n  });\n  it(\"should not apply high-enchantment surcharge below level 5 -- premium 105 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"sword\", material: \"steel\", enchantment: 4, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 105 }]);\n  });\n\n  // Policy-wide modifiers\n  it(\"should apply loyalty discount at exactly 2 years -- premium 85 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 2 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"sword\", material: \"steel\", enchantment: 3, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 85 }]);\n  });\n  it.todo(\"should apply first insurance surcharge -- premium 115 G\");\n  it.todo(\"should apply follow-up contract discount -- premium 90 G\");\n  it.t