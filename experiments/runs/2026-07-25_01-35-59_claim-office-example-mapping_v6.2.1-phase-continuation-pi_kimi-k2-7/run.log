remium: 105 }]);\n  });\n  it(\"should quote a single amulet -- premium 65 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"amulet\", material: \"silver\", enchantment: 2, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 65 }]);\n  });\n  it(\"should quote a single staff -- premium 85 G\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"staff\", material: \"oak\", enchantment: 1, cursed: false }],\n        },\n      ],\n    });\n    expect(result).toEqual([{ premium: 85 }]);\n  });\n  it.todo(\"should quote a single potion -- premium 45 G\");\n  it.todo(\"should quote a single rune -- premium 30 G\");\n  it.todo(\"should quote a single moonstone -- premium 30 G\");\n\n  // Component block rules\n  it.todo(\"should quote 2 runes without block discount -- premium 55 G\");\n  it.todo(\"should quote exactly 3 runes with block discount -- premium 65 G\");\n  it.todo(\"should quote 4 runes without block discount -- premium 105 G\");\n  it.todo(\"should quote 7 runes without block discount -- premium 180 G\");\n  it.todo(\"should not mix different component types for the block discount -- 2 runes + 1 moonstone premium 80 G\");\n  it.todo(\"should apply separate blocks for each component type -- 3 runes + 3 moonstones premium 125 G\");\n\n  // Item-specific modifiers\n  it.todo(\"should add cursed surcharge to a sword -- premium 155 G\");\n  it.todo(\"should add high-enchantment surcharge at level 5 -- premium 135 G\");\n  it.todo(\"should add both cursed and high-enchantment surcharges -- premium 185 G\");\n  it.todo(\"should not apply high-enchantment surcharge below level 5 -- premium 105 G\");\n\n  // Policy-wide modifiers\n  it.todo(\"should apply loyalty discount at exactly 2 years -- prem