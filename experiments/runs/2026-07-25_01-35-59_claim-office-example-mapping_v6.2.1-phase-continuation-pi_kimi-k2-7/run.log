em[];\n}\n\ninterface Scenario {\n  customer: { yearsWithMHPCO: number };\n  steps: QuoteStep[];\n}\n\ntype Quote = Array<{ premium: number }>;\n\nconst isComponent = (type: string): boolean => type === \"rune\" || type === \"moonstone\";\n\nconst basePremiumForItem = (type: string): number =>\n  BASE_PREMIUMS[type] ?? BASE_PREMIUMS.sword;\n\nconst basePremiumForGroup = (type: string, count: number): number =>\n  isComponent(type) && count === COMPONENT_BLOCK_SIZE\n    ? COMPONENT_BLOCK_PREMIUM\n    : count * basePremiumForItem(type);\n\nconst surchargeWhen = (applies: boolean, base: number, rate: number): number =>\n  applies ? base * rate : 0;\n\nconst surchargeForItem = (item: Item): number => {\n  const base = basePremiumForItem(item.type);\n  return (\n    surchargeWhen(item.cursed ?? false, base, CURSED_SURCHARGE_RATE) +\n    surchargeWhen(\n      typeof item.enchantment === \"number\" && item.enchantment >= HIGH_ENCHANTMENT_THRESHOLD,\n      base,\n      HIGH_ENCHANTMENT_SURCHARGE_RATE\n    )\n  );\n};\n\nconst basePremiumTotal = (items: Item[]): number => {\n  const quantityByType = new Map<string, number>();\n  items.forEach((item) => {\n    quantityByType.set(item.type, (quantityByType.get(item.type) ?? 0) + 1);\n  });\n\n  return Array.from(quantityByType.entries()).reduce(\n    (total, [type, count]) => total + basePremiumForGroup(type, count),\n    0\n  );\n};\n\nconst policyAdjustment = (baseTotal: number, customerYears: number, isFollowUp: boolean): number => {\n  const loyaltyDiscount =\n    customerYears >= LOYALTY_YEARS_THRESHOLD\n      ? LOYALTY_DISCOUNT_RATE * baseTotal\n      : 0;\n\n  const firstInsuranceSurcharge = FIRST_INSURANCE_SURCHARGE_RATE * baseTotal;\n  const followUpDiscount = isFollowUp ? FOLLOW_UP_DISCOUNT_RATE * baseTotal : 0;\n\n  return -loyaltyDiscount + firstInsuranceSurcharge - followUpDiscount;\n};\n\nconst quoteForItems = (items: Item[], customerYears: number, isFollowUp: boolean): Quote => {\n  const baseTotal = basePremiumTotal(items);\n\n  const itemSurcharges = items.reduce(\n    (total, item) => total + surchargeForItem(item),\n    0\n  );\n\n  const policyBase = baseTotal + itemSurcharges;\n  const rawPremium = policyBase + policyAdjustment(baseTotal, customerYears, isFollowUp) + PROCESSING_FEE;\n  return [{ premium: Math.ceil(rawPremium) }];\n};\n\nexport const processScenario = (scenario: Scenario): Quote =>\n  scenario.steps.flatMap((step, index) =>\n    quoteForItems(step.items, scenario.customer.yearsWithMHPCO, index > 0)\n  );\n```\n\nWait, I accidentally typed `LOYALTY_DISCHARGE_RATE` instead of `LOYALTY_DISCOUNT_RATE`. Let me fix that.\n\nActually I want to make sure I keep the original constant name. Let me write it correctly.\n\nLet me also think: is `policyAdjustment` the right name? It represents the net effect of policy-wide modifiers (loyalty discount, first insurance surcharge, follow-up discount). The name is OK. Maybe `policyWideAdjustment` is more explicit. Or `policyModifiersNetEffect`. I'll use `policyAdjustment` for brevity.\n\nActually, looking at this more, the term \"adjustment\" can be positive or negative. `policyAdjustment` is fine.\n\nOne more thing: the function `policyAdjustment` depends on `baseTotal` to compute the modifiers. The modifiers are all percentages of `baseTotal`. That's correct based on current logic. The name fits.\n\nLet me also think about `quoteForItems` after extraction. It now has:\n1. baseTotal\n2. itemSurcharges\n3. policyBase = baseTotal + itemSurcharges\n4. rawPremium = policyBase + policyAdjustment + fee\n\nThis reads like: subtotal of base + surcharges, then add policy adjustments and fee. Very clear.\n\nLet me write the file and run tests.\n\nActually, before I write, let me reconsider if I should also rename `LOYALTY_DISCOUNT_RATE` or not. No, keep it.\n\nOne more naming thought: `basePremiumTotal` vs `basePremiumForItems`. I think `basePremiumTotal` is clearer because \"total\" is unambiguous. But `basePremiumForItems` is