oduleInterop\": true,\n    \"skipLibCheck\": true,\n    \"outDir\": \"./dist\"\n  },\n  \"include\": [\"src/**/*\"]\n}\n---\nexport interface Item {\n  type: string;\n  material?: string;\n  enchantment?: number;\n  cursed?: boolean;\n}\n\nconst ITEM_BASE_PREMIUM: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\nconst BLOCK_SIZE = 3;\nconst BLOCK_PREMIUM = 60;\n\nconst computeTypePremium = (type: string, count: number): number => {\n  if (!(type in ITEM_BASE_PREMIUM)) {\n    throw new Error(`Unknown item type: ${type}`);\n  }\n  return count === BLOCK_SIZE ? BLOCK_PREMIUM : count * ITEM_BASE_PREMIUM[type];\n};\n\nexport const computeItemBasePremium = (item: Item): number => computeTypePremium(item.type, 1);\n\nexport const computeItemsBasePremium = (items: Item[]): number => {\n  const countsByType = new Map<string, number>();\n  for (const { type } of items) {\n    countsByType.set(type, (countsByType.get(type) ?? 0) + 1);\n  }\n  return [...countsByType].reduce(\n    (total, [type, count]) => total + computeTypePremium(type, count),\n    0\n  );\n};\n\nconst ITEM_INSURANCE_VALUE: Record<string, number> = {\n  sword: 1000,\n  amulet: 600,\n  rune: 250,\n};\n\nexport const computeInsuranceSum = (items: Item[]): number =>\n  items.reduce((sum, { type }) => sum + ITEM_INSURANCE_VALUE[type], 0);\n---\nsrc/scenario.spec.ts(2,29): error TS2307: Cannot find module './scenario.js' or its corresponding type declarations.\n"}],"isError":false,"timestamp":1784914369311},{"role":"assistant","content":[{"type":"text","text":"Now let me evaluate the current implementation of `claim.ts`.\n\n**Naming Evaluation**:\n- Current name: `computeClaimPayout`\n- Function purpose (based on the single passing test): given a policy's items, an incident with damages, and the cap remaining before the claim, computes the payout (sum of damage amounts minus a per-damage deductible) and the remaining cap after paying out.\