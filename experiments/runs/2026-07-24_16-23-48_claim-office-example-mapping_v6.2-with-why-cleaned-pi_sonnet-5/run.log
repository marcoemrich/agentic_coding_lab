  policy: number;\n  incident: Incident;\n}\n\nexport type Step = QuoteStep | ClaimStep;\n\nexport interface ScenarioInput {\n  customer: Customer;\n  steps: Step[];\n}\n\nexport interface QuoteResult {\n  premium: number;\n}\n\nexport interface ClaimStepResult {\n  payout: number;\n  remainingCap: number;\n}\n\nexport type StepResult = QuoteResult | ClaimStepResult;\n\nexport interface ScenarioOutput {\n  results: StepResult[];\n}\n\ninterface Policy {\n  items: Item[];\n  remainingCap: number;\n}\n\nexport const runScenario = (input: ScenarioInput): ScenarioOutput => {\n  const policiesByStepIndex = new Map<number, Policy>();\n  const results: StepResult[] = input.steps.map((step, index) => {\n    if (step.op === \"quote\") {\n      const premium = computeQuotePremium(input.customer, step.items, true);\n      policiesByStepIndex.set(index, { items: step.items, remainingCap: computeCap(step.items) });\n      return { premium };\n    }\n    const policy = policiesByStepIndex.get(step.policy);\n    if (!policy) {\n      throw new Error(`No policy found at step index ${step.policy}`);\n    }\n    const { payout, remainingCap } = computeClaimPayout(policy.items, step.incident, policy.remainingCap);\n    policy.remainingCap = remainingCap;\n    return { payout, remainingCap };\n  });\n  return { results };\n};\n","path":"/home/experimenter/experiments/runs/2026-07-24_16-23-48_claim-office-example-mapping_v6.2-with-why-cleaned-pi_sonnet-5/src/scenario.ts"}}],"api":"openai-completions","provider":"requesty","model":"vertex/claude-sonnet-5@eu","usage":{"input":1130,"output":913,"cacheRead":199606,"cacheWrite":0,"reasoning":0,"totalTokens":201649,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784915363341,"responseId":"rqsty-cmpl-ff48fdc7-d0bc-4694-9101-0a85000242f4","responseModel":"claude-sonnet-5"},{"role":"toolResult","toolCallId":"toolu_vrtx_01TQHYq7qqMesNiqKv7N7KBi","toolName":"write","content":[{"type":"text"