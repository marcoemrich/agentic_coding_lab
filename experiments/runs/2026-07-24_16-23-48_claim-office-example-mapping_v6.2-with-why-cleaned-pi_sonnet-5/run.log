"content":[{"type":"text","text":"import type { Item } from \"./catalog.js\";\nimport { computeItemBasePremium, computeItemsBasePremium } from \"./catalog.js\";\nimport { roundPremium } from \"./rounding.js\";\n\nconst CURSE_SURCHARGE_RATE = 0.5;\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\n\nconst computeItemSurchargeRate = (item: Item): number => {\n  let rate = 0;\n  if (item.cursed) rate += CURSE_SURCHARGE_RATE;\n  if ((item.enchantment ?? 0) >= HIGH_ENCHANTMENT_THRESHOLD) rate += HIGH_ENCHANTMENT_SURCHARGE_RATE;\n  return rate;\n};\n\nexport const computeRawPolicyPremium = (items: Item[]): number => {\n  const policyBase = computeItemsBasePremium(items);\n  const itemSurcharges = items.reduce(\n    (sum, item) => sum + computeItemBasePremium(item) * computeItemSurchargeRate(item),\n    0\n  );\n  return policyBase + itemSurcharges;\n};\n\nexport interface Customer {\n  yearsWithMHPCO: number;\n}\n\nconst PROCESSING_FEE = 5;\nconst FIRST_INSURANCE_SURCHARGE_RATE = 0.1;\nconst LOYALTY_DISCOUNT_YEARS_THRESHOLD = 2;\nconst LOYALTY_DISCOUNT_RATE = 0.2;\n\nexport const computeQuotePremium = (customer: Customer, items: Item[], isFirstQuote: boolean): number => {\n  const policyBase = computeItemsBasePremium(items);\n  const raw = computeRawPolicyPremium(items);\n  const firstInsuranceSurcharge = isFirstQuote ? policyBase * FIRST_INSURANCE_SURCHARGE_RATE : 0;\n  const loyaltyDiscount =\n    customer.yearsWithMHPCO >= LOYALTY_DISCOUNT_YEARS_THRESHOLD ? policyBase * LOYALTY_DISCOUNT_RATE : 0;\n  return roundPremium(raw + firstInsuranceSurcharge - loyaltyDiscount) + PROCESSING_FEE;\n};\n"}],"isError":false,"timestamp":1784913747739},{"role":"toolResult","toolCallId":"toolu_vrtx_01MB1Jzt5bXhdeQdPcDNN3vW","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { computeRawPolicyPremium, computeQuotePremium } from \"./quote.js\";\n\ndescribe(\"Quote - modifier scope on multi-item po