 surchargeScaled } = baseAndSurcharges(items);\n\n  let policyRate = FIRST_INSURANCE_RATE;\n  if (stepIndex >= 1) {\n    policyRate += FOLLOW_UP_RATE;\n  }\n  if (customerYears >= 2) {\n    policyRate += LOYALTY_RATE;\n  }\n\n  const totalScaled = policyBase * SCALING + surchargeScaled + policyBase * policyRate + PROCESSING_FEE_SCALED;\n  return Math.floor((totalScaled + SCALING - 1) / SCALING);\n}\n\nexport function processScenario(scenario: unknown): { results: Array<{ premium: number }> } {\n  const typed = scenario as Scenario;\n  const customerYears = typed.customer.yearsWithMHPCO;\n  const results: Array<{ premium: number }> = [];\n\n  for (let i = 0; i < typed.steps.length; i++) {\n    const step = typed.steps[i];\n    if (step.op === \"quote\") {\n      results.push({ premium: quotePremium(step.items ?? [], customerYears, i) });\n    }\n  }\n\n  return { results };\n}\n"}],"isError":false,"timestamp":1784921741921},{"role":"toolResult","toolCallId":"functions.read:2","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"MHPCO Claim Office\", () => {\n  // Quote basics\n  it(\"should quote premium 5 G for an empty item list (processing fee only)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 5 }] });\n  });\n  it(\"should quote premium 115 G for a single sword (base 100 + 10% first insurance + 5 fee)\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 115 }] });\n  });\n  it(\"should quote premium 71 G for a single amulet\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\",