quote\", items: [{ type: \"potion\" }] }],\n    });\n    expect(result).toEqual({ results: [{ premium: 49 }] });\n  });\n\n  // Components and building blocks\n  it.todo(\"should quote premium 60 G for 2 runes (2 * 25 base + 10% fee modifiers + 5 fee)\");\n  it.todo(\"should quote premium 71 G for 3 runes (block base 60 + 10% + 5 fee)\");\n  it.todo(\"should quote premium 115 G for 4 runes (no block, 4 * 25 + 10% + 5 fee)\");\n  it.todo(\"should quote premium 198 G for 7 runes (7 * 25 + 10% + 5 fee, rounded up)\");\n  it.todo(\"should quote premium 88 G for 2 runes + 1 moonstone (different types, no block)\");\n  it.todo(\"should quote premium 137 G for 3 runes + 3 moonstones (two separate blocks)\");\n\n  // Item-specific modifiers\n  it.todo(\"should quote premium 165 G for a cursed sword (base + 50% curse + first insurance + fee)\");\n  it.todo(\"should quote premium 145 G for a sword with enchantment 5 (base + 30% high enchant + first insurance + fee)\");\n  it.todo(\"should quote premium 115 G for a sword with enchantment 4 (no high enchant)\");\n  it.todo(\"should quote premium 181 G for a cursed, highly enchanted sword (both surcharges apply)\");\n\n  // Policy-wide modifiers\n  it.todo(\"should quote premium 95 G for a plain sword with a 2-year loyalty discount\");\n  it.todo(\"should quote premium 100 G for a plain sword on a follow-up contract\");\n\n  // Modifier scope and stacking\n  it.todo(\"should apply cursed surcharge to the cursed item only and policy-wide modifiers to the policy base\");\n  it.todo(\"should quote the newcomer-with-cursed-sword integration premium of 165 G\");\n  it.todo(\"should quote the long-standing-customer-second-contract integration premium of 160 G\");\n\n  // Errors\n  it.todo(\"should reject a quote with an unknown item type\");\n\n  // Claim basics\n  it.todo(\"should pay out 400 G for damage 500 G to a regular steel sword (full - 100 deductible)\");\n  it.todo(\"should pay out 100 G for damage 200 G to a rune (full - 100 deductible)\");\n  it.todo(\"should pay out 400 G for damage 1000 G to a steel sword with enchantment 9 (50% then deductible)\");\n  it.todo(\"should pay out 700 G for damage 800 G to a dragon-material sword with enchantment 5 (full then deductible)\");\n  it.todo(\"should pay out 400 G for damage 1000 G to a dragon-material sword with enchantment 9 (50% rule wins)\");\n  it.todo(\"should pay out 400 G for damage 1000 G to a dragon-material sword with enchantment 8 (high-enchantment clause applies)\");\n  it.todo(\"should pay out 600 G for a dragon attack damaging a sword (500) and an amulet (300) (deductible per item)\");\n\n  // Policy sums and caps\n  it.todo(\"should track an insurance sum of 2000 G and cap of 4000 G for two swords\");\n  it.todo(\"should keep cap at 2000 G for a cursed sword (modifiers do not raise cap)\");\n  it.todo(\"should reject a claim with more damage entries of a type than the policy covers\");\n  it.todo(\"should reject a claim referencing an unknown item type\");\n  it.todo(\"should reject a claim with a negative damage amount\");\n\n  // Cap exhaustion and rounding\n  it.todo(\"should exhaust cap across two successive claims: 1400/600 then 600/0\");\n  it.todo(\"should round payouts down (e.g. 350.5 becomes 350)\");\n});\n"}],"isError":false,"timestamp":1784921436046},{"role":"toolResult","toolCallId":"functions.read:1","toolName":"read","content":[{"type":"text","text":"const PROCESSING_FEE = 5;\n\nconst SINGLE_ITEM_PREMIUMS: Record<string, number> = {\n  sword: 115,\n  amulet: 71,\n  staff: 93,\n  potion: 49,\n};\n\nfunction quotePremium(items: Array<{ type: string }>): number {\n  if (items.length === 0) {\n    return PROCESSING_FEE;\n  }\n  return SINGLE_ITEM_PREMIUMS[items[0].type] ?? PROCESSING_FEE;\n}\n\nexport function processScenario(scenario: unknown): { results: Array<{ premium: number }> } {\n  const items = (scenario as { steps: Array<{ items: Array<{ type: string }> }> }).steps[0].items;\n  return { results: [{ premiu