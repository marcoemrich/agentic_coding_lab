ars, i >= 1) });\n```\nInvocations: quotePremium, ??, >=. So 3 invocations.\n\nSo `processScenario` gained 1 invocation (2 mass). Total program mass change: quotePremium+helper decreased by 2, processScenario increased by 2. Net change: 0.\n\nBut the clarity improved because the boolean intent is now explicit at the function signature level, and the rounding logic is encapsulated with a domain-specific name.\n\nActually, since mass is roughly the same and clarity improved, this is a good tradeoff (Rule 2 trumps APP).\n\nLet me also check if there are any other improvements. Looking at the code now:\n\n```ts\nconst PROCESSING_FEE = 5;\nconst SCALING = 20;\nconst PROCESSING_FEE_SCALED = PROCESSING_FEE * SCALING;\n\nconst BASE_PREMIUMS: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n};\n\nconst COMPONENT_PREMIUM = 25;\nconst COMPONENT_BLOCK_PREMIUM = 60;\nconst COMPONENT_BLOCK_SIZE = 3;\nconst COMPONENT_TYPES = new Set([\"rune\", \"moonstone\"]);\n\nconst CURSE_RATE = 10; // 50% == 10/20\nconst HIGH_ENCHANT_RATE = 6; // 30% == 6/20\nconst FIRST_INSURANCE_RATE = 2; // 10% == 2/20\nconst FOLLOW_UP_RATE = -3; // -15% == -3/20\nconst LOYALTY_RATE = -4; // -20% == -4/20\n\ntype Item = {\n  type: string;\n  material?: string;\n  enchantment?: number;\n  cursed?: boolean;\n};\n\ntype Step = {\n  op?: string;\n  items?: Array<Item>;\n};\n\ntype Scenario = {\n  customer: { yearsWithMHPCO: number };\n  steps: Array<Step>;\n};\n\nfunction roundUpGold(scaledAmount: number): number {\n  return Math.floor((scaledAmount + SCALING - 1) / SCALING);\n}\n\nfunction isComponent(item: Item): boolean {\n  return COMPONENT_TYPES.has(item.type);\n}\n\nfunction itemSurchargeRate(item: Item): number {\n  let rate = 0;\n  if (item.cursed) {\n    rate += CURSE_RATE;\n  }\n  if ((item.enchantment ?? 0) >= 5) {\n    rate += HIGH_ENCHANT_RATE;\n  }\n  return rate;\n}\n\nfunction calculateBaseAndSurcharges(items: Array<Item>): { policyBase: number; surchargeScaled: number } {\n  let policyBase = 0;\n  let surchargeScaled = 0;\n  const componentCounts: Record<string, number> = {};\n\n  for (const item of items) {\n    if (isComponent(item)) {\n      componentCounts[item.type] = (componentCounts[item.type] ?? 0) + 1;\n      continue;\n    }\n\n    const itemBase = BASE_PREMIUMS[item.type];\n    if (itemBase === undefined) {\n      throw new Error(`Unknown item type: ${item.type}`);\n    }\n    policyBase += itemBase;\n    surchargeScaled += itemBase * itemSurchargeRate(item);\n  }\n\n  for (const count of Object.values(componentCounts)) {\n    policyBase += count === COMPONENT_BLOCK_SIZE ? COMPONENT_BLOCK_PREMIUM : count * COMPONENT_PREMIUM;\n  }\n\n  return { policyBase, surchargeScaled };\n}\n\nfunction quotePremium(items: Array<Item>, customerYears: number, isFollowUp: boolean): number {\n  const { policyBase, surchargeScaled } = calculateBaseAndSurcharges(items);\n  const policyRate =\n    FIRST_INSURANCE_RATE +\n    (isFollowUp ? FOLLOW_UP_RATE : 0) +\n    (customerYears >= 2 ? LOYALTY_RATE : 0);\n\n  const totalScaled = policyBase * (SCALING + policyRate) + surchargeScaled + PROCESSING_FEE_SCALED;\n  return roundUpGold(totalScaled);\n}\n\nexport function processScenario(scenario: unknown): { results: Array<{ premium: number }> } {\n  const typed = scenario as Scenario;\n  const customerYears = typed.customer.yearsWithMHPCO;\n  const results: Array<{ premium: number }> = [];\n\n  for (let i = 0; i < typed.steps.length; i++) {\n    const step = typed.steps[i];\n    if (step.op === \"quote\") {\n      results.push({ premium: quotePremium(step.items ?? [], customerYears, i >= 1) });\n    }\n  }\n\n  return { results };\n}\n```\n\nCould I improve further? Maybe rename `calculateBaseAndSurcharges`? It calculates policy base and surcharges. The name is OK.\n\nMaybe rename `policyBase`? It represents the sum of item base premiums. `totalBasePremium` might be clearer. But the name `policyBase` is used in the return type and in