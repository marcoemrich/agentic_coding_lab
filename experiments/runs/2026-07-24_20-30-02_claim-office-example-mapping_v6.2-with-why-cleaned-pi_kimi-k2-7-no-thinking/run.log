uoteResult = { premium: number };\ntype QuoteStep = { op: \"quote\"; items: unknown[] };\n\nconst itemType = (item: unknown): string => (item as { type: string }).type;\n\nconst nonComponentBasePremium = (item: unknown): number => {\n  const type = itemType(item);\n  if (type === \"amulet\") return 60;\n  if (type === \"rune\") return 25;\n  return 100;\n};\n\nconst COMPONENT_TYPES = [\"rune\", \"moonstone\"];\nconst COMPONENT_BLOCK_SIZE = 3;\nconst COMPONENT_BLOCK_PREMIUM = 60;\nconst COMPONENT_UNIT_PREMIUM = 25;\n\nconst componentBasePremium = (count: number): number => {\n  if (count === COMPONENT_BLOCK_SIZE) return COMPONENT_BLOCK_PREMIUM;\n  return count * COMPONENT_UNIT_PREMIUM;\n};\n\nconst calculateQuotePremium = (items: unknown[]): number => {\n  const mainItems = items.filter((item) => !COMPONENT_TYPES.includes(itemType(item)));\n  const mainBase = mainItems.reduce((sum, item) => sum + nonComponentBasePremium(item), 0);\n  const runeCount = items.filter((item) => itemType(item) === \"rune\").length;\n  const policyBase = mainBase + componentBasePremium(runeCount);\n  const beforeFee = policyBase * (1 + FIRST_INSURANCE_SURCHARGE_RATE);\n  const roundedToNearestCent = Math.round(beforeFee * 100) / 100;\n  return Math.ceil(roundedToNearestCent + PROCESSING_FEE);\n};\n\nexport const processScenario = (input: { steps: unknown[] }): { results: QuoteResult[] } => {\n  const results: QuoteResult[] = [];\n  for (const step of input.steps) {\n    const quoteStep = step as QuoteStep;\n    if (quoteStep.op === \"quote\") {\n      results.push({ premium: calculateQuotePremium(quoteStep.items) });\n    }\n  }\n  return { results };\n};\n```\n\nWait, but `nonComponentBasePremium` still has `if (type === \"rune\") return 25;` - but runes ARE components! This is contradictory. Looking at the function: it's called only for mainItems (filtered to exclude COMPONENT_TYPES). So it should never receive a rune or moonstone. But the function still has a branch for rune returning 2