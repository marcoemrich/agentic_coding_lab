\n  return curseSurcharge + enchantmentSurcharge;\n};\n\nconst componentPremiumFor = (count: number): number =>\n  count === COMPONENT_BLOCK_SIZE ? COMPONENT_BLOCK_PREMIUM : count * COMPONENT_UNIT_PREMIUM;\n\nconst calculateFinalPremium = (\n  policyBase: number,\n  itemSurcharges: number,\n  yearsWithMHPCO: number,\n  isFirstQuote: boolean,\n): number => {\n  const loyaltyDiscount =\n    yearsWithMHPCO >= LOYALTY_YEARS_THRESHOLD ? LOYALTY_DISCOUNT_RATE : 0;\n  const followUpDiscount = isFirstQuote ? 0 : FOLLOW_UP_DISCOUNT_RATE;\n  const policyMultiplier =\n    1 + FIRST_INSURANCE_SURCHARGE_RATE - loyaltyDiscount - followUpDiscount;\n  const beforeFee = policyBase * policyMultiplier + itemSurcharges;\n  const roundedToNearestCent = Math.round(beforeFee * 100) / 100;\n  return Math.ceil(roundedToNearestCent + PROCESSING_FEE);\n};\n\nconst standardItemTotals = (items: unknown[]): { base: number; surcharges: number } =>\n  items\n    .filter((item) => !COMPONENT_TYPES.includes(itemType(item)))\n    .reduce(\n      (totals, item) => ({\n        base: totals.base + basePremiumForItem(item),\n        surcharges: totals.surcharges + surchargesForItem(item),\n      }),\n      { base: 0, surcharges: 0 },\n    );\n\nconst calculateQuotePremium = (\n  items: unknown[],\n  customer: { yearsWithMHPCO: number },\n  isFirstQuote: boolean,\n): number => {\n  const { base: standardBase, surcharges: itemSurcharges } = standardItemTotals(items);\n  const componentBase = COMPONENT_TYPES.reduce((sum, type) => {\n    const count = items.filter((item) => itemType(item) === type).length;\n    return sum + componentPremiumFor(count);\n  }, 0);\n  const policyBase = standardBase + componentBase;\n  return calculateFinalPremium(policyBase, itemSurcharges, customer.yearsWithMHPCO, isFirstQuote);\n};\n\ntype ScenarioInput = { customer: { yearsWithMHPCO: number }; steps: unknown[] };\n\nexport const processScenario = (input: ScenarioInput): { results: QuoteResult[] } => {\n  const results: QuoteResult[] = [];\n  let quoteCount = 0;\n  for (const step of input.steps) {\n    const quoteStep = step as QuoteStep;\n    if (quoteStep.op === \"quote\") {\n      results.push({\n        premium: calculateQuotePremium(quoteStep.items, input.customer, quoteCount === 0),\n      });\n      quoteCount += 1;\n    }\n  }\n  return { results };\n};\n"}],"isError":false,"timestamp":1784925728864},{"role":"assistant","content":[{"type":"thinking","thinking":"The code now has `basePremiumForItem` and `surchargesForItem` nicely paired. The duplicate base premium calculation removed.\n\nCould we also improve `calculateFinalPremium` naming or duplication? Maybe rename `isFirstQuote` to `firstQuote`? The boolean parameter indicates if this is the first quote. `isFirstQuote` is fine. But maybe `followUpDiscount = firstQuote ? 0 : FOLLOW_UP_DISCOUNT_RATE` reads odd? It reads okay.\n\nPotential duplication in `calculateFinalPremium`: two ternary discount computations share pattern. Could extract a helper `discountRate(isEligible, rate)` or `rateIf`. That would reduce duplication and improve intent. Let's consider.\n\nCurrent:\n```\nconst loyaltyDiscount =\n    yearsWithMHPCO >= LOYALTY_YEARS_THRESHOLD ? LOYALTY_DISCOUNT_RATE : 0;\nconst followUpDiscount = isFirstQuote ? 0 : FOLLOW_UP_DISCOUNT_RATE;\n```\nBoth compute discount rate based on condition. Extract helper:\n```\nconst discountRate = (qualifies: boolean, rate: number): number =>\n  qualifies ? rate : 0;\n```\nThen:\n```\nconst loyaltyDiscount = discountRate(\n  yearsWithMHPCO >= LOYALTY_YEARS_THRESHOLD,\n  LOYALTY_DISCOUNT_RATE,\n);\nconst followUpDiscount = discountRate(!isFirstQuote, FOLLOW_UP_DISCOUNT_RATE);\n```\nThis removes duplication of `? rate : 0` pattern. Mass? Add helper function with bindings (qualifies, rate) and conditional => mass maybe 1+2+4=7 plus invocations 2 uses => +4. Remove two ternaries => -8. Net +3. Slight increase, but DRY and intent. However the helper `discountRate` name is generic and might no