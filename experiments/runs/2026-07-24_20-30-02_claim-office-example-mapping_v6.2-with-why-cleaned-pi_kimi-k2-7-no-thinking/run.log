wn[] };\n\nconst itemType = (item: unknown): string => (item as { type: string }).type;\n\nconst basePremiumForItemType = (type: string): number => (type === \"amulet\" ? 60 : 100);\n\nconst basePremiumForStandardItem = (item: unknown): number =>\n  basePremiumForItemType(itemType(item));\n\nconst HIGH_ENCHANTMENT_THRESHOLD = 5;\nconst HIGH_ENCHANTMENT_SURCHARGE_RATE = 0.3;\nconst LOYALTY_DISCOUNT_RATE = 0.2;\nconst LOYALTY_YEARS_THRESHOLD = 2;\n\nconst itemSpecificSurchargeFor = (item: unknown): number => {\n  const typedItem = item as { type: string; cursed?: boolean; enchantment?: number };\n  const base = basePremiumForItemType(typedItem.type);\n  const curseSurcharge = typedItem.cursed ? base * CURSE_SURCHARGE_RATE : 0;\n  const enchantmentSurcharge =\n    (typedItem.enchantment ?? 0) >= HIGH_ENCHANTMENT_THRESHOLD\n      ? base * HIGH_ENCHANTMENT_SURCHARGE_RATE\n      : 0;\n  return curseSurcharge + enchantmentSurcharge;\n};\n\nconst componentPremiumFor = (count: number): number =>\n  count === COMPONENT_BLOCK_SIZE ? COMPONENT_BLOCK_PREMIUM : count * COMPONENT_UNIT_PREMIUM;\n\nconst applyPolicyWideModifiers = (\n  policyBase: number,\n  itemSurcharges: number,\n  yearsWithMHPCO: number,\n): number => {\n  const loyaltyRate = yearsWithMHPCO >= LOYALTY_YEARS_THRESHOLD ? 1 - LOYALTY_DISCOUNT_RATE : 1;\n  const beforeFee = policyBase * (FIRST_INSURANCE_SURCHARGE_RATE + loyaltyRate) + itemSurcharges;\n  const roundedToNearestCent = Math.round(beforeFee * 100) / 100;\n  return Math.ceil(roundedToNearestCent + PROCESSING_FEE);\n};\n\nconst calculateQuotePremium = (items: unknown[], customer: { yearsWithMHPCO: number }): number => {\n  const standardItems = items.filter((item) => !COMPONENT_TYPES.includes(itemType(item)));\n  const standardBase = standardItems.reduce(\n    (sum, item) => sum + basePremiumForStandardItem(item),\n    0,\n  );\n  const itemSurcharges = standardItems.reduce(\n    (sum, item) => sum + itemSpecificSurchargeFor(item),\n    0,\n  );\n  const componentBase = COMPONENT_TYPES.reduce((sum, type) => {\n    const count = items.filter((item) => itemType(item) === type).length;\n    return sum + componentPremiumFor(count);\n  }, 0);\n  const policyBase = standardBase + componentBase;\n  return applyPolicyWideModifiers(policyBase, itemSurcharges, customer.yearsWithMHPCO);\n};\n\ntype ScenarioInput = { customer: { yearsWithMHPCO: number }; steps: unknown[] };\n\nexport const processScenario = (input: ScenarioInput): { results: QuoteResult[] } => {\n  const results: QuoteResult[] = [];\n  for (const step of input.steps) {\n    const quoteStep = step as QuoteStep;\n    if (quoteStep.op === \"quote\") {\n      results.push({ premium: calculateQuotePremium(quoteStep.items, input.customer) });\n    }\n  }\n  return { results };\n};\n"}],"isError":false,"timestamp":1784925564501},{"role":"toolResult","toolCallId":"functions.read:1","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"MHPCO Claim Office\", () => {\n  // Quote tests - ordered simple to complex\n  it(\"should quote an empty item list -- premium 5 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 5 }] });\n  });\n  it(\"should quote a single sword -- premium 115 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 115 }] });\n  });\n  it(\"should quote a single amulet -- premium 71 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"amulet\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 71 }] });\n  });\n  it(\"should quote a single rune -- premium 33 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 33 }] });\n  });\n  it(\"should quote two runes -- premium 60 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 60 }] });\n  });\n  it(\"should quote three runes as a block -- premium 71 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 71 }] });\n  });\n  it(\"should quote four runes without block -- premium 115 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 115 }] });\n  });\n  it(\"should quote seven runes -- premium 198 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n          ],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 198 }] });\n  });\n  it(\"should quote 2 runes and 1 moonstone as different types -- premium 88 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"moonstone\" }],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 88 }] });\n  });\n  it(\"should quote 3 runes and 3 moonstones as two separate blocks -- premium 137 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n          ],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 137 }] });\n  });\n  it(\"should quote a cursed sword with 50% curse surcharge -- premium 165 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\", cursed: true }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 165 }] });\n  });\n  it(\"should quote a sword with enchantment 5 with 30% high-enchantment surcharge -- premium 145 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\", enchantment: 5 }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 145 }] });\n  });\n  it(\"should quote a cursed sword with enchantment 5 with both surcharges -- premium 195 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\", cursed: true, enchantment: 5 }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 195 }] });\n  });\n  it(\"should quote a sword for a long-standing customer (>=2 years) with 20% loyalty discount -- premium 95 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 2 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 95 }] });\n  });\n  it.todo(\"should quote a sword as first insurance with 10% surcharge -- premium 115 G\");\n  it.todo(\"should quote a second contract with 15% follow-up discount -- premium 90 G\");\n  it.todo(\"should apply item-specific modifiers per item and policy-wide modifiers to policy base -- premium 210 G\");\n  it.todo(\"should quote a newcomer with a cursed sword -- premium 165 G\");\n  it.todo(\"should quote a long-standing customer's second cursed highly-enchanted sword -- premium 160 G\");\n\n  // Claim tests\n  it.todo(\"should process a standard claim with deductible -- payout 400 G\");\n  it.todo(\"should process a claim for a rune with deductible -- payout 100 G\");\n  it.todo(\"should apply 50% reimbursement for enchantment >= 8, then deductible -- payout 400 G\");\n  it.todo(\"should fully reimburse dragon-material damage, then deductible -- payout 700 G\");\n  it.todo(\"should choose 50% rule when both high enchantment and dragon material apply -- payout 400 G\");\n  it.todo(\"should apply deductible per damaged item in a single incident -- payout 600 G\");\n\n  // Policy / cap / validation tests\n  it.todo(\"should cap payout at twice the insurance sum\");\n  it.todo(\"should track remaining cap across successive claims -- payouts 1400 G and 600 G\");\n  it.todo(\"should reject a claim with more damage entries of a type than the policy covers\");\n  it.todo(\"should reject a quote with an unknown item type\");\n  it.todo(\"should reject a claim referencing an item not in the policy\");\n  it.todo(\"should reject a claim with a negative damage amount\");\n\n  // Rounding tests\n  it.todo(\"should round a premium of 197.5 G up to 198 G\");\n  it.todo(\"should round a payout of 350.5 G down to 350 G\");\n});\n"}],"isError":false,"timestamp":1784925564501},{"role":"assistant","content":[{"type":"t