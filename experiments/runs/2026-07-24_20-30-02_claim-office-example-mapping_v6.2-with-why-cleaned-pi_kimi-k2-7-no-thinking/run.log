t)).toEqual({ results: [{ premium: 33 }] });\n  });\n  it(\"should quote two runes -- premium 60 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 60 }] });\n  });\n  it(\"should quote three runes as a block -- premium 71 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 71 }] });\n  });\n  it(\"should quote four runes without block -- premium 115 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }, { type: \"rune\" }],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 115 }] });\n  });\n  it(\"should quote seven runes -- premium 198 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n          ],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 198 }] });\n  });\n  it(\"should quote 2 runes and 1 moonstone as different types -- premium 88 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [{ type: \"rune\" }, { type: \"rune\" }, { type: \"moonstone\" }],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 88 }] });\n  });\n  it(\"should quote 3 runes and 3 moonstones as two separate blocks -- premium 137 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [\n        {\n          op: \"quote\",\n          items: [\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"rune\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n            { type: \"moonstone\" },\n          ],\n        },\n      ],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 137 }] });\n  });\n  it(\"should quote a cursed sword with 50% curse surcharge -- premium 165 G\", () => {\n    const input = {\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\", cursed: true }] }],\n    };\n    expect(processScenario(input)).toEqual({ results: [{ premium: 165 }] });\n  });\n  it.todo(\"should quote a sword with enchantment 5 with 30% high-enchantment surcharge -- premium 135 G\");\n  it.todo(\"should quote a cursed sword with enchantment 5 with both surcharges -- premium 185 G\");\n  it.todo(\"should quote a sword for a long-standing customer (>=2 years) with 20% loyalty discount -- premium 85 G\");\n  it.todo(\"should quote a sword as first insurance with 10% surcharge -- premium 115 G\");\n  it.todo(\"should quote a second contract with 15% follow-up discount -- premium 90 G\");\n  it.todo(\"should apply item-specific modifiers per item and policy-wide modifiers to policy base -- premium 210 G\");\n  it.todo(\"should quote a newcomer with a cursed sword -- premium 165 G\");\n  it.todo(\"should quote a long-standing customer's second cursed highly-enchanted sword -- premium 160 G\");\n\n  // Claim tests\n  it.todo(\"should process a standard claim with deductible -- payout 400 G\");\n  it.todo(\"should process a claim for a rune with deductible -- payout 100 G\");\n  it.todo(\"should apply 50% reimbursement for enchantment >= 8, then deductible -- payout 400 G\");\n  it.todo(\"should fully reimburse dragon-material damage, then deductible -- payout 700 G\");\n  it.todo(\"should choose 50% rule when both high enchantment and dragon material apply -- payout 400 G\");\n  it.todo(\"should apply deductible per damaged item in a single incident -- payout 600 G\");\n\n  // Policy / cap / validation tests\n  it.todo(\"should cap payout at twice the insurance sum\");\n  it.todo(\"should track remaining cap across successive claims -- payouts 1400 G and 600 G\");\n  it.todo(\"should reject a claim with more damage entries of a type than the policy covers\");\n  it.todo(\"should reject a quote with an unknown item type\");\n  it.todo(\"should reject a claim referencing an item not in the policy\");\n  it.todo(\"should reject a claim with a negative damage amount\");\n\n  // Rounding tests\n  it.todo(\"should round a premium of 197.5 G up to 198 G\");\n  it.todo(\"should round a payout of 350.5 G down to 350 G\");\n});\n"}],"isError":false,"timestamp":1784925424064},{"role":"toolResult","toolCallId":"functions.read:1","toolName":"read","content":[{"type":"text","text":"const PROCESSING_FEE = 5;\nconst FIRST_INSURANCE_SURCHARGE_RATE = 0.1;\n\ntype QuoteResult = { premium: number };\ntype QuoteStep = { op: \"quote\"; items: unknown[] };\n\nconst itemType = (item: unknown): string => (item as { type: string }).type;\n\nconst CURSE_SURCHARGE_RATE = 0.5;\n\nconst nonComponentBasePremium = (item: unknown): number => {\n  const type = itemType(item);\n  if (type === \"amulet\") return 60;\n  return 100;\n};\n\nconst itemSpecificSurcharge = (item: unknown): number => {\n  const typed = item as { type: string; cursed?: boolean };\n  const base = typed.type === \"amulet\" ? 60 : 100;\n  return typed.cursed ? base * CURSE_SURCHARGE_RATE : 0;\n};\n\nconst COMPONENT_TYPES = [\"rune\", \"moonstone\"];\nconst COMPONENT_BLOCK_SIZE = 3;\nconst COMPONENT_BLOCK_PREMIUM = 60;\nconst COMPONENT_UNIT_PREMIUM = 25;\n\nconst componentBasePremium = (count: number): number => {\n  if (count === COMPONENT_BLOCK_SIZE) return COMPONENT_BLOCK_PREMIUM;\n  return count * COMPONENT_UNIT_PREMIUM;\n};\n\nconst finalPremium = (policyBase: number, itemSurcharges: number): number => {\n  const beforeFee = policyBase * (1 + FIRST_INSURANCE_SURCHARGE_RATE) + itemSurcharges;\n  const roundedToNearestCent = Math.round(beforeFee * 100) / 100;\n  return Math.ceil(roundedToNearestCent + PROCESSING_FEE);\n};\n\nconst quotePremiumFor = (items: unknown[]): number => {\n  const nonComponentItems = items.filter((item) => !COMPONENT_TYPES.includes(itemType(item)));\n  const nonComponentBase = nonComponentItems.reduce(\n    (sum, item) => sum + nonComponentBasePremium(item),\n    0,\n  );\n  const nonComponentSurcharges = nonComponentItems.reduce(\n    (sum, item) => sum + itemSpecificSurcharge(item),\n    0,\n  );\n  const componentBase = COMPONENT_TYPES.reduce((sum, type) => {\n    const count = items.filter((item) => itemType(item) === type).length;\n    return sum + componentBasePremium(count);\n  }, 0);\n  const policyBase = nonComponentBase + componentBase;\n  return finalPremium(policyBase, nonComponentSurcharges);\n};\n\nexport const processScenario = (input: { steps: unknown[] }): { results: QuoteResult[] } => {\n  const results: QuoteResult[] = [];\n  for (const step of input.steps) {\n    const quoteStep = step as QuoteStep;\n    if (quoteStep.op === \"quote\") {\n      results.push({ premium: quotePremiumFor(quoteStep.items) });\n    }\n  }\n  return { results };\n};\n"}],"isError":false,"timestamp":1784925424064},{"role":"toolResult","toolCallId":"functions.read:2","toolName":"read","content":[{"type":"text","text":"{\n  \"name\": \"tdd-experiment-run\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"test\": \"vitest run\",\n    \"test:unit:basic\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"test:coverage\": \"vitest run --coverage --coverage.reporter=json-summary\"\n  },\n  \