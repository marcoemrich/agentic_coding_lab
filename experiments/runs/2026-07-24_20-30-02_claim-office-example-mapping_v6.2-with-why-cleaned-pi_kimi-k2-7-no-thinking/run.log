eturn s.op === \"claim\";\n};\n\nexport const processScenario = (input: ScenarioInput): { results: StepResult[] } => {\n  const results: StepResult[] = [];\n  const policies: Policy[] = [];\n  for (const step of input.steps) {\n    if (isQuoteStep(step)) {\n      const isFirstQuote = policies.length === 0;\n      results.push({\n        premium: calculateQuotePremium(step.items, input.customer, isFirstQuote),\n      });\n      policies.push(createPolicy(step.items));\n    } else if (isClaimStep(step)) {\n      const policy = policies[step.policy];\n      const claimResult = processClaim(policy, step.incident);\n      policy.remainingCap = claimResult.remainingCap;\n      results.push(claimResult);\n    }\n  }\n  return { results };\n};\n```\n\nComponent count:\n- `policyCapForItems`: bindings 3, constants 1, invocations 2, loop 1 → **13**\n- `createPolicy`: bindings 1, invocations 1 → **3**\n- `isQuoteStep`: bindings 2, constants 1, conditional 1 → **7**\n- `isClaimStep`: bindings 2, constants 1, conditional 1 → **7**\n- `processScenario`: bindings 7, constants 1, invocations 8, conditionals 2, loop 1, assignment 1 → **43**\n\n**Total Mass: 73**\n\n**Mass Change:** 47 → 73 (Δ +26)\n\n## Refactoring Decision\n\nMass increased because the refactor introduced named helpers and explicit type guards. This is intentional: Rule 2 (reveals intent) and type safety take priority over raw mass. The benefits are:\n\n- `policyCapForItems` and `createPolicy` make policy creation self-documenting.\n- `isQuoteStep` / `isClaimStep` replace the opaque `as Step` cast with named, type-safe dispatch checks.\n- `processScenario` is now shorter and its branches read as plain business logic.\n\nNo further refactorings were attempted to avoid over-engineering. All tests pass and TypeScript compiles cleanly.\n\nRefactoring Complete:\n**Refactoring**: Extracted `policyCapForItems`, `createPolicy`, and added `isQuoteStep`/`isClaimStep` type guards.\n**Mass Change**: 47 → 73 (increase justified