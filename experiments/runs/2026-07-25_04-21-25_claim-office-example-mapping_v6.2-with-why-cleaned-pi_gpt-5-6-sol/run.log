n\nconst quote = (items: Array<Record<string, unknown>>, yearsWithMHPCO = 0) =>\n  processScenario({ customer: { yearsWithMHPCO }, steps: [{ op: \"quote\", items }] }).results[0];\n\nconst claim = (items: Array<Record<string, unknown>>, damages: Array<{ itemType: string; amount: number }>) =>\n  processScenario({\n    customer: { yearsWithMHPCO: 0 },\n    steps: [\n      { op: \"quote\", items },\n      { op: \"claim\", policy: 0, incident: { cause: \"test\", damages } },\n    ],\n  }).results[1];\n\ndescribe(\"MHPCO claim office\", () => {\n  it(\"quotes an empty item list at the 5 G processing fee\", () => {\n    expect(quote([])).toEqual({ premium: 5 });\n  });\n  it(\"uses the price list for sword, amulet, staff, and potion premiums: 115, 71, 93, and 49 G for first insurance\", () => {\n    expect(quote([{ type: \"sword\" }])).toEqual({ premium: 115 });\n    expect(quote([{ type: \"amulet\" }])).toEqual({ premium: 71 });\n    expect(quote([{ type: \"staff\" }])).toEqual({ premium: 93 });\n    expect(quote([{ type: \"potion\" }])).toEqual({ premium: 49 });\n  });\n  it(\"prices component quantities and exact alike blocks\", () => {\n    const components = (type: string, count: number) => Array.from({ length: count }, () => ({ type }));\n    expect(quote(components(\"rune\", 2))).toEqual({ premium: 60 });\n    expect(quote(components(\"rune\", 3))).toEqual({ premium: 71 });\n    expect(quote(components(\"rune\", 4))).toEqual({ premium: 115 });\n    expect(quote(components(\"rune\", 7))).toEqual({ premium: 198 });\n    expect(quote([...components(\"rune\", 2), ...components(\"moonstone\", 1)])).toEqual({ premium: 88 });\n    expect(quote([...components(\"rune\", 3), ...components(\"moonstone\", 3)])).toEqual({ premium: 137 });\n  });\n  it.todo(\"applies a cursed surcharge only to the affected sword in a sword-and-amulet policy: 231 G total\");\n  it.todo(\"applies the loyalty discount at exactly 2 years: plain sword premium 95 G\");\n  it.todo(\"applies both curse and high-enchantment surcharges at enchantment 5: sword premium 195 G\");\n  it.todo(\"does not apply high-enchantment surcharge at enchantment 4: cursed sword premium 165 G\");\n  it.todo(\"rounds a 197.5 G premium up to 198 G in MHPCO's favor\");\n  it.todo(\"quotes a newcomer cursed sword at 165 G\");\n  it.todo(\"quotes a long-standing customer's second contract cursed enchantment-7 sword at 160 G, including first-insurance and follow-up modifiers\");\n  it.todo(\"leaves a 3200 G cap for an undamaged sword-and-amulet policy\");\n  it.todo(\"bases a cursed sword cap on its unmodified value: 2000 G\");\n  it.todo(\"bases sword plus 3-rune block insurance sum on each component value: cap 3500 G\");\n  it.todo(\"pays 400 G for regular sword damage of 500 G after one deductible\");\n  it.todo(\"pays 100 G for rune damage of 200 G with no special clauses\");\n  it.todo(\"pays 400 G for dragon-material enchantment-8 sword damage of 1000 G because the 50% clause wins\");\n  it.todo(\"pays 400 G for dragon-material enchantment-9 sword damage of 1000 G\");\n  it.todo(\"pays 700 G for dragon-material enchantment-5 sword damage of 800 G\");\n  it.todo(\"pays 400 G for steel enchantment-9 sword damage of 1000 G\");\n  it.todo(\"applies a separate deductible to sword and amulet damage, paying 600 G total\");\n  it.todo(\"treats two insured swords and two sword damage entries separately, with a 4000 G initial cap\");\n  it.todo(\"rounds a 350.5 G payout down to 350 G in MHPCO's favor\");\n  it.todo(\"exhausts a sword policy cap across claims: payouts 1400 then 600, ending at 0\");\n  it.todo(\"rejects a quote containing unknown item type broomstick\");\n  it.todo(\"rejects a claim for an item type absent from the policy\");\n  it.todo(\"rejects more damage entries of a type than the policy covers\");\n  it.todo(\"rejects a negative damage amount\");\n});\n"}],"isError":false,"timestamp":1784953393088},{"role":"toolResult","toolCallId":"call_JTbLG9nk02ITHmZiAJOoZirW","toolName