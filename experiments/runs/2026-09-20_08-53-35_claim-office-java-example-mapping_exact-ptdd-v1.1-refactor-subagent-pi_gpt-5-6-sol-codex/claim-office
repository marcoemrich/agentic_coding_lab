#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")" && pwd)
if [[ ! -f "$ROOT/target/classes/ClaimOfficeCli.class" ]]; then
  mvn -q -f "$ROOT/pom.xml" -DskipTests compile >/dev/null
fi
JACKSON="$HOME/.m2/repository/com/fasterxml/jackson/core"
CLASSPATH="$ROOT/target/classes:$JACKSON/jackson-databind/2.18.3/jackson-databind-2.18.3.jar:$JACKSON/jackson-core/2.18.3/jackson-core-2.18.3.jar:$JACKSON/jackson-annotations/2.18.3/jackson-annotations-2.18.3.jar"
exec java -cp "$CLASSPATH" ClaimOfficeCli
