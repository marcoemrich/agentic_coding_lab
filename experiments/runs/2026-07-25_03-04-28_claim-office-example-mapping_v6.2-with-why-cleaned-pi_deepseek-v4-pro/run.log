nt 5: 1\n    } else if (step.op === \"claim\") {                                    // conditional: 4, constant \"claim\": 1\n      const policy = policies[step.policy];                              // binding: 1\n      for (const damage of step.incident.damages) {                      // loop: 5, binding damage: 1\n        if (!policy.has(damage.itemType)) {                              // conditional: 4, invocation: 2 (has)\n          throw new Error(`${damage.itemType} not covered by policy`);   // invocation: 2 (Error)\n        }\n      }\n      results.push({ payout: 0, remainingCap: 0 });                     // invocation: 2 (push), constants: 2 (0,0)\n    }\n  }\n  return { results: results as { premium: number }[] };                  // invocation: 2 (type assertion)\n}\n\nvalidate function:\n- loop: 5 (for...of)\n- conditional: 4 (if step.op === \"quote\")\n- constant: 1 (\"quote\")\n- binding: 1 (step)\n- loop inner: for (const item of step.items) = loop: 5, binding item: 1\n- conditional: 4 (if !VALID_ITEM_TYPES.has)\n- invocation: 2 (has)\n- invocation: 2 (Error)\n\nActually, let me be more systematic. APP mass:\n\n### processScenario:\n- **Constants**: 3 (`\"quote\"`, `\"claim\"`, `5`) = 3\n- **Bindings**: `scenario`, `step` (outer for), `covered`, `i` (map), `policy`, `damage` (inner for) = 6\n- **Invocations**: `validate`, `step.items.map`, `Set`, `policies.push`, `results.push` (quote), `policy.has`, `results.push` (claim), `Error`, type assertion = 9 invocations × 2 = 18\n- **Conditionals**: `step.op === \"quote\"`, `step.op === \"claim\"`, `!policy.has(...)` = 3 × 4 = 12\n- **Loops**: outer `for...of steps`, inner `for...of damages`, `items.map` = 3 × 5 = 15\n- **Assignments**: `policies.push` (assignment via push), `results.push` = 2 × 6 = 12 (actually... push is an invocation not assignment)\n\nWait, let me reconsider. The APP model counts:\n- Constants: literals\n- Bindings: variables/parameters\n- Invocations: function calls\n- Conditionals: if