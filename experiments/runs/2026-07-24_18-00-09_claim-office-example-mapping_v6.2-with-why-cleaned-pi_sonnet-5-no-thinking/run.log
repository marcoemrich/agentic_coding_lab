ys 400 G for a regular sword (steel, enchantment 3) with 500 G damage (full reimbursement minus 100 G deductible; no special clause applies)\", () => {\nsrc/claims.spec.ts:9:     expect(computeClaim(policyItems, damages, 0).payout).toBe(400);\nsrc/claims.spec.ts:11:   it(\"computeClaim pays 100 G for a rune (insurance value 250 G) with 200 G damage (full reimbursement minus deductible; runes have no enchantment level or material, so no special clause applies)\", () => {\nsrc/claims.spec.ts:14:     expect(computeClaim(policyItems, damages, 0).payout).toBe(100);\nsrc/claims.spec.ts:18:   it(\"computeClaim pays 400 G for a dragon-material sword, enchantment 9, damage 1000 G (both clauses apply; the 50% rule wins, then deductible: 500-100)\", () => {\nsrc/claims.spec.ts:21:     expect(computeClaim(policyItems, damages, 0).payout).toBe(400);\nsrc/claims.spec.ts:23:   it(\"computeClaim pays 700 G for a dragon-material sword, enchantment 5, damage 800 G (only the dragon-material clause applies: full reimbursement, then deductible: 800-100)\", () => {\nsrc/claims.spec.ts:26:     expect(computeClaim(policyItems, damages, 0).payout).toBe(700);\nsrc/claims.spec.ts:28:   it(\"computeClaim pays 400 G for a steel sword, enchantment 9, damage 1000 G (only the high-enchantment clause applies: 50% first, then deductible: 500-100)\", () => {\nsrc/claims.spec.ts:31:     expect(computeClaim(policyItems, damages, 0).payout).toBe(400);\nsrc/claims.spec.ts:35:   it(\"computeClaim pays 400 G for a dragon-material sword with exactly enchantment 8, damage 1000 G (high-enchantment clause applies, then deductible)\", () => {\nsrc/claims.spec.ts:38:     expect(computeClaim(policyItems, damages, 0).payout).toBe(400);\nsrc/claims.spec.ts:42:   it(\"computeClaim pays 600 G total for a dragon attack damaging an insured sword (500 G) and an insured amulet (300 G), deductible applied once per damaged item\", () => {\nsrc/claims.spec.ts:48:     expect(computeClaim(policyItems, damages, 0).payout).toBe(600);\nsrc/claims.spec.ts:52:   it(\"computeClaim treats two damage entries of {itemType: sword} on a two-sword policy as separate damages, each with its own deductible\", () => {\nsrc/claims.spec.ts:58:     expect(computeClaim(policyItems, damages, 0).payout).toBe(600);\nsrc/claims.spec.ts:60:   it(\"computeClaim rejects a claim (throws) when damages contain more entries of a type than the policy covers (e.g. two sword damages but only one sword insured)\", () => {\nsrc/claims.spec.ts:66:     expect(() => computeClaim(policyItems, damages, 0)).toThrow();\nsrc/claims.spec.ts:70:   it(\"computeClaim caps a cursed sword's claim at 2000 G based on the unmodified insurance value of 1000 G (premium modifiers do not raise the cap)\", () => {\nsrc/claims.spec.ts:73:     const result = computeClaim(policyItems, damages, 0);\nsrc/claims.spec.ts:77:   it(\"computeClaim pays 1400 G and leaves 600 G remaining cap for a first 1500 G claim against a 1000 G insured sword (cap 2000 G)\", () => {\nsrc/claims.spec.ts:80:     const result = computeClaim(policyItems, damages, 0);\nsrc/claims.spec.ts:84:   it(\"computeClaim pays 600 G and leaves 0 G remaining cap for a second successive 1500 G claim against the same sword after the first claim already used 1400 G of the 2000 G cap\", () => {\nsrc/claims.spec.ts:87:     const result = computeClaim(policyItems, damages, 1400);\nsrc/claims.spec.ts:93:   it(\"computeClaim rounds a payout of 350.5 G down to 350 G\", () => {\nsrc/claims.spec.ts:96:     expect(computeClaim(policyItems, damages, 0).payout).toBe(350);\nsrc/claims.spec.ts:100:   it(\"computeClaim rejects a claim (throws) when a damage entry references an item not part of the policy (e.g. amulet damaged when only a sword is insured)\", () => {\nsrc/claims.spec.ts:103:     expect(() => computeClaim(policyItems, damages, 0)).toThrow();\nsrc/claims.spec.ts:105:   it(\"computeClaim rejects a claim (throws) when a damage entry references an unknown item type\", () => {\nsrc/claims.spec.ts:108:     expect(() => computeClaim(policyItems, damages, 0)).toThrow();\nsrc/claims.spec.ts:110:   it(\"computeClaim rejects a claim (throws) when a damage entry has amount: -200\", () => {\nsrc/claims.spec.ts:113:     expect(() => computeClaim(policyItems, damages, 0)).toThrow();"}],"isError":false,"timestamp":1784920535238},{"role":"assistant","content":[{"type":"toolCall","id":"toolu_vrtx_01UkTZFVXUv9QUUL4a3unZep","name":"bash","arguments":{"command":"cd /home/experimenter/experiments/runs/2026-07-24_18-00-09_claim-office-example-mapping_v6.2-with-why-cleaned-pi_sonnet-5-no-thinking && find src -name \"scenario.ts\" -o -name \"*.ts\" | xargs ls"}}],"api":"openai-completions","provider":"requesty","model":"vertex/claude-sonnet-5@eu","usage":{"input":10198,"output":1076,"cacheRead":10096,"cacheWrite":0,"reasoning":0,"totalTokens":21370,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784920535239,"responseId":"rqsty-cmpl-8cfb3af0-a62d-4ebf-a88f-c0b485b037b9","responseModel":"claude-sonnet-5"},{"role":"toolResult","toolCallId":"toolu_vrtx_01UkTZFVXUv9QUUL4a3unZep","toolName":"bash","content":[{"type":"text","text":"src/claims.spec.ts\nsrc/claims.ts\nsrc/items.spec.ts\nsrc/items.ts\nsrc/pricing.spec.ts\nsrc/pricing.ts\nsrc/scenario.spec.ts\n"}],"isError":false,"timestamp":1784920547768},{"role":"assistant","content":[{"type":"toolCall","id":"toolu_vrtx_01RTc1Wf3q5r4Yz5RUeffzQd","name":"grep","arguments":{"pattern":"PolicyItem|from \"./claims\"","glob":"*.ts"}}],"api":"openai-completions","provider":"requesty","model":"vertex/claude-sonnet-5@eu","usage":{"input":10416,"output":589,"cacheRead":10096,"cacheWrite":0,"reasoning":0,"totalTokens":21101,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784920547768,"responseId":"rqsty-cmpl-4c101a39-6baf-42e7-b177-486dcbca80c1","responseModel":"claude-sonnet-5"},{"role":"toolResult","toolCallId":"toolu_vrtx_01