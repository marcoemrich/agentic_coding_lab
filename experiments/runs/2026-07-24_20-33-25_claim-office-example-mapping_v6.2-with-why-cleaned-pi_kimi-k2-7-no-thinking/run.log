UMS: Record<string, number> = {\n  sword: 100,\n  amulet: 60,\n  staff: 80,\n  potion: 40,\n  rune: 25,\n  moonstone: 25,\n};\n\nfunction calculatePremiumWithFirstInsuranceAndFee(basePremium: number): number {\n  const firstInsurance = Math.ceil(basePremium * FIRST_INSURANCE_RATE);\n  return basePremium + firstInsurance + PROCESSING_FEE;\n}\n\nfunction calculateQuotePremium(items: Item[]): number {\n  if (items.length === 0) {\n    return PROCESSING_FEE;\n  }\n  if (items.length !== 1) {\n    const basePremium = items.reduce((sum, item) => sum + (ITEM_BASE_PREMIUMS[item.type] ?? 0), 0);\n    return calculatePremiumWithFirstInsuranceAndFee(basePremium);\n  }\n  const basePremium = ITEM_BASE_PREMIUMS[items[0].type];\n  if (basePremium === undefined) {\n    return PROCESSING_FEE;\n  }\n  return calculatePremiumWithFirstInsuranceAndFee(basePremium);\n}\n\nexport function processScenario(scenario: Scenario): Results {\n  const step = scenario.steps[0];\n  if (step.op === \"quote\") {\n    return { results: [{ premium: calculateQuotePremium(step.items) }] };\n  }\n  return { results: [{ premium: PROCESSING_FEE }] };\n}\n"}],"isError":false,"timestamp":1784925618840},{"role":"toolResult","toolCallId":"functions.read:1","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { processScenario } from \"./claim-office.js\";\n\ndescribe(\"MHPCO Claim Office\", () => {\n  // Quote: empty and single-item base premiums\n  it(\"should quote premium 5 G for an empty item list -- only the processing fee\", () => {\n    const result = processScenario({ customer: { yearsWithMHPCO: 0 }, steps: [{ op: \"quote\", items: [] }] });\n    expect(result.results[0]).toEqual({ premium: 5 });\n  });\n  it(\"should quote premium 115 G for a single plain sword -- 100 base + 10 first insurance + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"sword\" }] }],\n    });\n    expect(result.results[0]).toEqual({ premium: 115 });\n  });\n  it(\"should quote premium 71 G for a single plain amulet -- 60 base + 6 first insurance + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"amulet\" }] }],\n    });\n    expect(result.results[0]).toEqual({ premium: 71 });\n  });\n  it(\"should quote premium 93 G for a single plain staff -- 80 base + 8 first insurance + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"staff\" }] }],\n    });\n    expect(result.results[0]).toEqual({ premium: 93 });\n  });\n  it(\"should quote premium 49 G for a single plain potion -- 40 base + 4 first insurance + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"potion\" }] }],\n    });\n    expect(result.results[0]).toEqual({ premium: 49 });\n  });\n  it(\"should quote premium 33 G for a single rune -- 25 base + 2.5 first insurance + 5 fee rounded up\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }] }],\n    });\n    expect(result.results[0]).toEqual({ premium: 33 });\n  });\n\n  // Quote: component blocks\n  it(\"should quote premium 60 G for 2 runes -- 50 base + 5 first insurance + 5 fee\", () => {\n    const result = processScenario({\n      customer: { yearsWithMHPCO: 0 },\n      steps: [{ op: \"quote\", items: [{ type: \"rune\" }, { type: \"rune\" }] }],\n    });\n    expect(result.results[0]).toEqual({ premium: 60 });\n  });\n  it.todo(\"should quote premium 71 G for 3 runes -- 60 block base + 6 first insurance + 5 fee\");\n  it.todo(\"should quote premium 115 G for 4 runes -- 100 base + 10 first insurance + 5 fee\");\n  it.todo(\"should quote premium 198 G for 7 runes -- 175 base + 17.5 first insurance + 5 fee rounded up\");\n  it.todo(\"should quote premium 88 G for 2 runes + 1 moonstone -- 75 base + 7.5 first insurance + 5 fee rounded up\");\n  it.todo(\"should quote premium 137 G for 3 runes + 3 moonstones -- 120 base + 12 first insurance + 5 fee\");\n\n  // Quote: item-specific modifiers\n  it.todo(\"should quote premium 165 G for a cursed steel sword enchantment 3 -- 100 + 50 curse + 10 first insurance + 5 fee\");\n  it.todo(\"should quote premium 145 G for a highly enchanted steel sword enchantment 5 -- 100 + 30 high enchantment + 10 first insurance + 5 fee\");\n  it.todo(\"should quote premium 195 G for a cursed steel sword enchantment 5 -- 100 + 50 curse + 30 high enchantment + 10 first insurance + 5 fee\");\n  it.todo(\"should quote premium 143 G for a highly enchanted steel sword enchantment 4 cursed -- 100 + 50 curse + 10 first insurance + 5 fee\");\n\n  // Quote: policy-wide modifiers\n  it.todo(\"should apply loyalty discount for customer with exactly 2 years -- 100 base - 20 loyalty + 10 first insurance + 5 fee = 95 G\");\n  it.todo(\"should apply follow-up contract discount on the second quote -- 100 base + 10 first insurance - 15 follow-up + 5 fee = 100 G\");\n\n  // Quote: integration examples\n  it.todo(\"should quote premium 165 G for newcomer with a cursed sword -- 100 + 50 + 10 + 5\");\n  it.todo(\"should quote premium 160 G for long-standing customer's second contract -- 100 + 50 + 30 + 10 - 15 - 20 + 5\");\n\n  // Quote: modifier scope on multi-item policies\n  it.todo(\"should apply cursed surcharge only to the cursed item in a multi-item policy -- cursed sword + plain amulet = 231 G\");\n\n  // Claim: standard reimbursement\n  it.todo(\"should pay out 400 G for regular steel sword enchantment 3 damage 500 -- full reimbursement minus 100 deductible\");\n  it.todo(\"should pay out 100 G for rune damage 200 -- full reimbursement minus 100 deductible\");\n\n  // Claim: enchantment threshold vs dragon material\n  it.todo(\"should pay out 400 G for dragon-material sword enchantment 9 damage 1000 -- 50% rule wins, then deductible\");\n  it.todo(\"should pay out 700 G for dragon-material sword enchantment 5 damage 800 -- dragon material full, then deductible\");\n  it.todo(\"should pay out 400 G for steel sword enchantment 9 damage 1000 -- 50% rule, then deductible\");\n\n  // Claim: multiple items and damages\n  it.todo(\"should track cap 4000 G for a policy covering two swords\");\n  it.todo(\"should apply 100 G deductible per damaged item when two swords are damaged\");\n  it.todo(\"should reject a claim that damages more items of a type than the policy covers\");\n\n  // Claim: cap exhaustion\n  it.todo(\"should cap total payout at twice the insurance sum\");\n  it.todo(\"should reduce a second claim payout when remaining cap is exhausted -- 1400 then 600\");\n\n  // Quote/claim integration: insurance sum and cap\n  it.todo(\"should compute cap 3200 G for a policy covering a sword and an amulet\");\n  it.todo(\"should base cap on unmodified insurance value -- cursed sword cap 2000 G\");\n  it.todo(\"should base insurance sum on individual component values, not block discount -- sword + 3 runes = 1750 G\");\n\n  // Rounding\n  it.todo(\"should round a 197.5 G premium up to 198 G\");\n  it.todo(\"should round a 350.5 G payout down to 350 G\");\n\n  // Error cases\n  it.todo(\"should error on quote with unknown item type\");\n  it.todo(\"should error on claim referencing item not part of the policy\");\n  it.todo(\"should error on claim with unknown damage item type\");\n  it.todo(\"should error on claim with negative damage amount\");\n\n  // Multi-step scenarios\n  it.todo(\"should process a quote followed by a claim against that policy\");\n});\n"}],"isError":false,"timestamp":1784925618840},{"role":"toolResult","toolCallId":"functions.read:2","toolName":"read","content":[{"type":"text","text":"{\n  \"name\": \"tdd-experiment-run\",\n  \"type\": \"module\",\n  \"scrip