CESSING_FEE;\n+135   return basePremium + itemModifiers + firstInsurance - policyDiscount + PROCESSING_FEE;\n 136 }\n 137 \n-138 function calculatePolicyDiscountAmount(\n+138 function calculatePolicyDiscount(\n 139   basePremium: number,\n 140   customer: Customer,\n 141   quoteIndex: number,\n 142 ): number {\n 143   const loyaltyRate = customer.yearsWithMHPCO >= LOYALTY_YEARS_THRESHOLD ? LOYALTY_DISCOUNT_RATE : 0;\n 144   const followUpRate = quoteIndex > 0 ? FOLLOW_UP_CONTRACT_DISCOUNT_RATE : 0;\n-145   return -(basePremium * (loyaltyRate + followUpRate));\n+145   return basePremium * (loyaltyRate + followUpRate);\n 146 }\n 147 \n 148 function calculateQuotePremium(\n 149   items: Item[],\n     ...\n 151   quoteIndex: number,\n 152 ): number {\n 153   const basePremium = calculateBasePremium(items);\n 154   const itemModifiers = items.reduce((sum, item) => sum + calculateItemSurcharge(item), 0);\n-155   const policyModifiers = calculatePolicyDiscountAmount(basePremium, customer, quoteIndex);\n-156   return calculateTotalPremium(basePremium, itemModifiers, policyModifiers);\n+155   const policyDiscount = calculatePolicyDiscount(basePremium, customer, quoteIndex);\n+156   return calculateTotalPremium(basePremium, itemModifiers, policyDiscount);\n 157 }\n 158 \n 159 const DEDUCTIBLE = 100;\n 160 const INSURANCE_VALUE_MULTIPLIER = 10;\n     ...","patch":"--- src/claim-office.ts\n+++ src/claim-office.ts\n@@ -128,22 +128,22 @@\n \n function calculateTotalPremium(\n   basePremium: number,\n   itemModifiers: number,\n-  policyModifiers: number,\n+  policyDiscount: number,\n ): number {\n   const firstInsurance = Math.ceil(basePremium * FIRST_INSURANCE_RATE);\n-  return basePremium + itemModifiers + firstInsurance + policyModifiers + PROCESSING_FEE;\n+  return basePremium + itemModifiers + firstInsurance - policyDiscount + PROCESSING_FEE;\n }\n \n-function calculatePolicyDiscountAmount(\n+function calculatePolicyDiscount(\n   basePremium: number,\n   customer: Customer,\n