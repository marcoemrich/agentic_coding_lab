odo(\"should reimburse 50% of damage for items with enchantment level ≥ 8\");\n  it.todo(\"should fully reimburse damage to items made of dragon material\");\n  it.todo(\"should apply both high-enchantment and dragon-material clauses with high-enchantment winning (dragon-material sword, enchantment 9, damage 1000 G → payout 400 G)\");\n  it.todo(\"should apply only dragon-material clause when enchantment < 8 (dragon-material sword, enchantment 5, damage 800 G → payout 700 G)\");\n  it.todo(\"should apply only high-enchantment clause for steel sword, enchantment 9, damage 1000 G → payout 400 G\");\n  it.todo(\"should reject claim with non-zero exit code if damages exceed insured items\");\n  it.todo(\"should reject claim with negative damage amount\");\n  it.todo(\"should reject quote with negative values\");\n  it.todo(\"should handle multiple items of the same type (two swords → insurance sum 2000 G)\");\n  it.todo(\"should apply deductible per damaged item (dragon attack damages sword and amulet → deductible applies twice)\");\n  it.todo(\"should reduce payout when cap is exhausted (first claim 1400 G, second claim 600 G of requested 1400 G)\");\n  it.todo(\"should base cap on unmodified insurance value (cursed sword insurance value 1000 G → cap 2000 G)\");\n  it.todo(\"should include component insurance value in total sum (sword + 3 runes → sum 1750 G)\");\n  it.todo(\"should handle a newcomer with a cursed sword → premium 165 G\");\n  it.todo(\"should handle long-standing customer's second contract with cursed, enchanted sword → premium 160 G\");\n});\n"}}
