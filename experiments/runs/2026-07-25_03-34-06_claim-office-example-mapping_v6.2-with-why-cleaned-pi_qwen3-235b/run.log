07","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1784950450122,"responseId":"rqsty-cmpl-6bb75a97-9c9f-47f4-ac00-d3c55e019d59","responseModel":"Qwen/Qwen3-235B-A22B-Instruct-2507"}}
