"content":[{"type":"text","text":"export type Cell = readonly [number, number];\n\nfunction neighborsOf([x, y]: Cell): Cell[] {\n  const offsets = [-1, 0, 1];\n  const result: Cell[] = [];\n  for (const dx of offsets) {\n    for (const dy of offsets) {\n      if (dx === 0 && dy === 0) continue;\n      result.push([x + dx, y + dy]);\n    }\n  }\n  return result;\n}\n\nfunction cellKey([x, y]: Cell): string {\n  return `${x},${y}`;\n}\n\nfunction parseKey(key: string): Cell {\n  const [x, y] = key.split(\",\").map(Number);\n  return [x, y];\n}\n\nfunction countLiveNeighbors(cell: Cell, aliveKeys: Set<string>): number {\n  return neighborsOf(cell).filter((n) => aliveKeys.has(cellKey(n))).length;\n}\n\nfunction willBeAlive(isCurrentlyAlive: boolean, liveNeighborCount: number): boolean {\n  if (isCurrentlyAlive) {\n    return liveNeighborCount === 2 || liveNeighborCount === 3;\n  }\n  return liveNeighborCount === 3;\n}\n\nexport function nextGeneration(cells: Cell[]): Cell[] {\n  const aliveKeys = new Set(cells.map(cellKey));\n\n  const candidateKeys = new Set<string>();\n  for (const cell of cells) {\n    candidateKeys.add(cellKey(cell));\n    for (const neighbor of neighborsOf(cell)) {\n      candidateKeys.add(cellKey(neighbor));\n    }\n  }\n\n  const result: Cell[] = [];\n  for (const key of candidateKeys) {\n    const cell = parseKey(key);\n    const liveNeighborCount = countLiveNeighbors(cell, aliveKeys);\n    const isCurrentlyAlive = aliveKeys.has(key);\n\n    if (willBeAlive(isCurrentlyAlive, liveNeighborCount)) {\n      result.push(cell);\n    }\n  }\n\n  return result;\n}\n"}],"isError":false,"timestamp":1784962498315},{"role":"toolResult","toolCallId":"toolu_vrtx_01E1ztPrypkxfN3SV4a9TWkb","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from \"vitest\";\nimport { nextGeneration } from \"./game-of-life.js\";\n\ndescribe(\"Game of Life - Next Generation\", () => {\n  it(\"returns an empty array when given an empty grid -- [] ->