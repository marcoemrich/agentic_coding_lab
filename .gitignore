__pycache__/
node_modules/
experiments/runs/*/coverage/
experiments/runs/*/target/
experiments/runs/*/verification-prepare.log
experiments/runs/*/.analysis-pmd-ruleset.xml
experiments/runs/*/pnpm-lock.yaml
experiments/runs/.pnpm-store/
# Stryker mutation-testing scaffolding (regenerated per run by
# experiments/compute-mutation-score.py). Same status as coverage/.
experiments/runs/*/.npmrc
experiments/runs/*/stryker.config.json
experiments/runs/*/stryker.log
experiments/runs/*/reports/
# Python stack scaffolding, all regenerated per run: the venv and caches by
# install.sh and analyze-run.sh, the mutants/ tree by mutmut. Same status as
# node_modules/, coverage/ and target/.
experiments/runs/*/.venv/
experiments/runs/*/.pytest_cache/
experiments/runs/*/.ruff_cache/
experiments/runs/*/coverage.json
experiments/runs/*/.coverage
experiments/runs/*/uv.lock
experiments/runs/*/mutants/
experiments/runs/*/mutmut.log
experiments/runs/*/.analysis-complexipy.json
experiments/reanalyze.log
.claude/scheduled_tasks.lock
.claude/settings.local.json
# Container-Cleanup-Timestamp wird bei jedem Batch refresht.
experiments/docker/claude-config/.last-cleanup
# Batch plans: ignore all by default — most are ad-hoc / generated /
# referencing archived workflows. Only the basic smoke-test plan stays
# tracked. New permanent plans need an explicit !-line here.
experiments/batch-plans/*.json
!experiments/batch-plans/smoke-test.json
!experiments/batch-plans/skeleton-oc.json
!experiments/batch-plans/skeleton-v5-oc.json
!experiments/batch-plans/smoke-non-anthropic-oc.json
!experiments/batch-plans/smoke-gemini-oc.json
!experiments/batch-plans/smoke-openrouter-oc.json
!experiments/batch-plans/smoke-gemini-pro-retry.json
!experiments/batch-plans/variance-probe-minimax.json
!experiments/batch-plans/smoke-glm-oc.json
nohup.out

# Secrets — never commit API keys, credentials, env files (keep .env.example as template)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.portkey-bak
experiments/runs/*/transcript-pi.jsonl
# TCR bookkeeping written by run-batch.sh for every arm (the isolated run
# repo's commit log, reflog, patch series and final status). Never versioned:
# the TDD signal the RQs use is parsed out of it into metrics.json at analysis
# time, and the raw files are large and diff as noise. They were invisible
# until the stray per-run .gitignore was removed, hence the explicit rules.
experiments/runs/*/tcr-commits.tsv
experiments/runs/*/tcr-reflog.tsv
experiments/runs/*/tcr-history.patch
experiments/runs/*/tcr-final-status.txt
experiments/runs/*/tcr-git-summary.json
experiments/runs/*/analyze.err
# Console transcript of a run; can balloon to multiple GB when a model
# spams output (blocks GitHub's 2 GiB push limit). The run's data lives in
# metrics.json / transcript.jsonl — run.log is not needed in the repo.
# ** matches any depth so runs/_archive/<dir>/run.log is covered too.
experiments/runs/**/run.log

# Report PDFs are built on demand from the committed .md via the
# /build-overview skill (pandoc → Chromium headless). They are large binary
# derivatives that bloat the repo and diff as noise; the Markdown is the
# source of truth. Rebuild with the snippet in the skill's PDF step.
research/reports/*.pdf

# Local dependency dir for the aggregation scripts. The system python is
# PEP-668 managed and has no tabulate (a hard dep of aggregate-by-query.py);
# venv needs the python3.14-venv apt package. Recreate with:
#   python3 -m pip install --target .pylibs tabulate
# and run:  PYTHONPATH=.pylibs python3 experiments/aggregate-by-query.py <rq>
.pylibs/
experiments/runs/*/pom-pitest.xml
experiments/runs/*/pit.log
