{
  "name": "results-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:json": "eslint 'src/**/*.{ts,tsx}' --format json",
    "complexity:json": "eslint 'src/**/*.{ts,tsx}' --config eslint.complexity.config.mjs --format json"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "happy-dom": "^20.14.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
